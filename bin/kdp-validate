#!/usr/bin/env python3
"""Strict structural validation of the final outlined interior."""
import json, re, subprocess, sys
from pathlib import Path

ref_path, final_path, out_path = map(Path, sys.argv[1:4])
ref = json.loads(Path(sys.argv[4]).read_text()) if len(sys.argv) > 4 else None
final = json.loads(Path(sys.argv[5]).read_text()) if len(sys.argv) > 5 else None
fail, review = [], []
def run(*a): return subprocess.run(a, text=True, capture_output=True)
if run("qpdf", "--check", str(final_path)).returncode: fail.append("qpdf --check failed")
if run("qpdf", "--is-encrypted", str(final_path)).returncode == 0: fail.append("PDF is encrypted")
if ref["pages"] != final["pages"]: fail.append(f"page count differs: {ref['pages']} -> {final['pages']}")
for a, b in zip(ref["page_geometry"], final["page_geometry"]):
    for key in ("MediaBox", "CropBox", "TrimBox", "BleedBox"):
        if any(abs(x-y) > .01 for x,y in zip(a[key], b[key])): fail.append(f"page {a['page']} {key} differs")
    for key in ("rotation", "UserUnit"):
        if abs(a[key]-b[key]) > .01: fail.append(f"page {a['page']} {key} differs")
fonts = run("pdffonts", str(final_path)).stdout.splitlines()[2:]
if any(x.strip() for x in fonts): fail.append("pdffonts reports remaining fonts")
if run("pdftotext", str(final_path), "-").stdout.strip(): fail.append("pdftotext found remaining text")
objects = run("qpdf", "--json=1", "--json-key=objects", "--json-stream-data=inline", str(final_path)).stdout
if re.search(r'"/Font"\s*:', objects): fail.append("reachable object dictionaries contain /Font resources")
# Content is decoded by qpdf; these operators outside strings are a defense-in-depth check.
if re.search(r'(?<![A-Za-z])(BT|Tf|Tj|TJ|\'|\")(?=\s|\[)', objects): fail.append("content streams contain text operators")
for key, value in final["features"].items():
    if value and key != "transparency": fail.append(f"unwanted feature remains: {key}")
if final["features"]["transparency"]: review.append("live transparency detected; source-level review required")
if final["bytes"] > 650_000_000: fail.append("file exceeds 650,000,000 bytes")
before={(i["page"],i["width"],i["height"]) for i in ref["images"]}
after={(i["page"],i["width"],i["height"]) for i in final["images"]}
new=sorted(after-before)
if new: fail.append(f"unexpected raster images after outlining: {new[:20]}")
if final["low_resolution_images"]: review.append(f"{len(final['low_resolution_images'])} raster placements are below 300 PPI")
report={"reference":str(ref_path),"final":str(final_path),"passed":not fail,"failures":fail,"human_review":review,
 "page_count":final["pages"],"bytes":final["bytes"],"size_growth":final["bytes"]-ref["bytes"],"font_count":final["font_count"]}
out_path.write_text(json.dumps(report,indent=2)+"\n")
print(json.dumps(report,indent=2))
raise SystemExit(bool(fail))
