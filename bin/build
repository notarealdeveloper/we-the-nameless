#!/usr/bin/env python3
# When adding/removing arguments or changing their values, keep completions()
# and bin/completions/build.sh in sync with the CLI.
"""Build any selection as a reading PDF, publisher print pair, or reflowable EPUB."""
import argparse
import fcntl
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

from print_publish_config import (BOOK_OPTIONS, PRESETS, PROCESSING, PROVIDERS,
    DEFAULTS, PRINT_CONFIG, TRIMS, master_defaults, parse_target, target_suffixes)

ROOT = Path(__file__).resolve().parents[1]
STAGES = ('all', 'build', 'vectorize', 'check', 'release')
EPILOG = """Presets (explicit options override only their own setting):
  pdf             Active master.tex settings; one reading PDF (default).
  kdp             Simple paperback 7x10 + fancy hardcover 8.25x11; vectorized.
  lulu            Simple paperback 7x10 + fancy hardcover 7x10; originals.
  kdp-paperback / lulu-paperback    Only the publisher's simple paperback.
  kdp-hardcover / lulu-hardcover    Only the publisher's fancy hardcover.
  ebook           Reflowable EPUB, cover we-cover-8; follows master apocrypha.

All print presets use book/lite, horizontal verses, commentary, inline English,
fancy title pages, default colors, apocrypha, uncensored redaction, no interior
cover, print-safe assets/rules, LD spine, matching premium-color paper/ink,
no interior bleed, and soft PDF encoding. Artwork, binding, processing and trim
are independent. --binding overrides construction; --cover-style selects artwork.
Publisher-only calls build both profiles concurrently. The flags expose every
combination, including the optional qualifiers supported by Make.

Stages:
  Print all: build originals and apply processing; build: originals only;
  vectorize: convert existing originals; check: compare existing original/vector
  pairs at 300 DPI with both MuPDF and Poppler (no build or conversion).
  PDF all/build: compile until references settle; --workflow parallel builds the
  complete selection by chapters. EPUB all/build: development; release: rebuild
  with mandatory EPUBCheck; check: validate the existing archive only.

Examples:
  bin/build genesis kdp
  bin/build exodus lulu-hardcover
  bin/build J lulu --cover-style fancy --binding paperback --trim 8.25x11
  bin/build genesis kdp --theme dark --commentary false --translation kjv
  bin/build genesis --output-mode even --verse-layout vertical --cover none
  bin/build all --workflow parallel --theme lite
  bin/build genesis ebook --stage release
  bin/build genesis kdp --stage vectorize
  bin/build --make-target genesis-kdp-simplecover-vectorized-7x10 --plan

Make supports publisher and publisher-binding presets and optional style,
processing, trim and stage qualifiers. Use --plan to resolve configuration
without writes or builds.
Custom settings can share output names: choose --output-dir to retain variants.
These commands only create local files; they never upload to a publisher.
See PUBLISH.md and man/pages/build.1 for every option and operational limits.
"""


def parser():
    p = argparse.ArgumentParser(description=__doc__, epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument('book', nargs='?', default='all', help='all (active master), book/alias, chapter or case-sensitive source subset; --list shows names')
    p.add_argument('preset', nargs='?', choices=PRESETS, default='pdf', help='build defaults; explicit flags override them (default: pdf)')
    p.add_argument('--publisher', '--provider', dest='provider', choices=PROVIDERS, help='select print publisher; equivalent to its preset')
    p.add_argument('--stage', choices=STAGES, default='all', help='operation; see stage descriptions below (default: all)')
    p.add_argument('--make-target', help='resolve a Make target; its explicit fields override flags')
    for option, (_, choices, description) in BOOK_OPTIONS.items():
        if option == 'output-mode':
            description = ('book: 7x10 with gutter; hard: 8.25x11; even: 7x10 equal margins; '
                           'tech: 7x14.68 and larger text; explicit trim overrides page size')
        p.add_argument('--' + option, choices=choices, help=description + '; defaults from preset or master.tex')
    p.add_argument('--trim', choices=('default', *TRIMS), default='default', help='interior inches; default uses preset trim or natural PDF layout')
    p.add_argument('--binding', choices=('paperback', 'hardcover'), help='physical cover construction, independently of artwork')
    p.add_argument('--processing', choices=PROCESSING, help='print all: searchable originals, or originals plus outlined vectors; publisher default if omitted')
    p.add_argument('--paper', choices=('premium-color', 'standard-color'), default='premium-color', help='color stock; KDP hardcover always premium (default: premium-color)')
    p.add_argument('--ink', choices=('premium-color', 'standard-color'), help='must match paper; defaults to selected paper')
    p.add_argument('--bleed', choices=('no-bleed',), default='no-bleed', help='interior bleed policy (only no-bleed is implemented)')
    p.add_argument('--variant', choices=('soft', 'medium', 'hard'), default='soft', help='print vector PDF encoding; unrelated to binding (default: soft)')
    p.add_argument('--hardcover-template', type=Path, help='exact KDP hardcover geometry JSON; rejected for Lulu')
    p.add_argument('--asset-dir', type=Path, help='override KDPAssetDir (print-safe assets); otherwise prepared automatically')
    p.add_argument('--output-dir', type=Path, help='destination directory; PDF: project root; print: pub/PUBLISHER[/VARIANT]; EPUB: ebook/')
    p.add_argument('--build-dir', type=Path, help='reading PDF scratch directory; default: build/editions/BOOK/CONFIG-HASH')
    p.add_argument('--workflow', choices=('serial', 'parallel'), default='serial', help='reading PDF execution; parallel requires all (default: serial)')
    p.add_argument('--source-date-epoch', type=int, default=os.environ.get('SOURCE_DATE_EPOCH'), help='nonnegative reproducible timestamp; print builds default to Git commit time')
    p.add_argument('--artifact', type=Path, help='print check: explicit final PDF, paired with --reference')
    p.add_argument('--reference', type=Path, help='print check: explicit searchable reference PDF')
    p.add_argument('--plan', action='store_true', help='print JSON configuration, paths and/or commands without writes or builds')
    p.add_argument('--list', action='store_true', help='list selections without building')
    p.add_argument('--complete', nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    return p


def cover_names():
    return sorted({p.stem for p in (ROOT / 'img/covers').glob('*')
                   if p.suffix.lower() in ('.png', '.jpg', '.jpeg', '.pdf', '.webp')})


def translation_names():
    return sorted({'default', *(p.name for p in (ROOT / 'translations').iterdir()
                               if p.is_dir())})


def selection_names():
    names = ['all']
    for flag in ('--make-targets', '--make-chapter-targets'):
        names.extend(subprocess.check_output([str(ROOT / 'bin/book-subset'), flag], text=True).split())
    return names


def completion_words(line):
    """Shell words up to the cursor, allowing an unfinished quote or escape."""
    lexer = shlex.shlex(line, posix=True)
    lexer.whitespace_split = True
    lexer.commenters = ''
    words = []
    boundary = True
    while True:
        try:
            word = lexer.get_token()
        except ValueError:
            words.append(lexer.token)
            break
        if word is None:
            if boundary:
                words.append('')
            break
        words.append(word)
        boundary = lexer.state == ' '
    return words


def completions(words):
    """Complete arguments without resolving a build; @ markers request Bash paths."""
    trim = 0
    if words and words[0] == '--bash':
        line, point, *raw = words[1:]
        point = int(point)
        # Locate this command within COMP_LINE, including after a pipe or ';'.
        # Parse its text so quotes, spaces and configurable word breaks agree.
        end = point + len(raw[-1])
        starts = []
        for word in reversed(raw):
            end = line.rfind(word, 0, end) if word else point
            starts.append(end)
        words = completion_words(line[end:point])[1:]
        replacement = '' if raw[-1] in ('=', ':') else completion_words(line[starts[0]:point])[0]
        trim = len(words[-1]) - len(replacement)
    words = words or ['']
    p = parser()
    actions = {flag: action for action in p._actions for flag in action.option_strings
               if action.help != argparse.SUPPRESS}
    positionals = [action for action in p._actions if not action.option_strings]

    def option(word):
        flag = word.partition('=')[0]
        if flag in actions:
            return actions[flag]
        if p.allow_abbrev and flag.startswith('--'):
            matches = [action for name, action in actions.items() if name.startswith(flag)]
            if len(matches) == 1:
                return matches[0]

    pending = None
    positional = 0
    options = True
    for word in words[:-1]:
        if pending is not None and not word.startswith('-'):
            pending = None
            continue
        pending = None
        if options and word == '--':
            options = False
        elif options and word.startswith('-'):
            action = option(word)
            if action is not None and action.nargs != 0 and '=' not in word:
                pending = action
        else:
            positional += 1

    current = words[-1]
    prefix = ''
    if options and current.startswith('--') and '=' in current:
        flag, current = current.split('=', 1)
        action = option(flag)
        prefix = flag + '='
    elif options and current.startswith('-'):
        action = None
    else:
        action = pending
        if action is None and positional < len(positionals):
            action = positionals[positional]

    candidates = []
    if action is not None:
        if action.choices is not None:
            candidates = action.choices
        elif action.dest == 'book':
            candidates = selection_names()
        elif action.dest == 'translation':
            candidates = translation_names()
        elif action.dest == 'cover':
            candidates = ['none', *cover_names()]
        elif action.dest == 'make_target':
            candidates = (f'{book}-{suffix}' for book in selection_names()
                          for suffix in target_suffixes())
        elif action.type is Path:
            print('@directories' if action.dest.endswith('_dir') else '@filenames')
            print(current)
            print(max(0, trim - len(prefix)))
            return
    if options and not prefix and (pending is None or current.startswith('-')):
        candidates = [*candidates, *actions]
    values = dict.fromkeys((prefix + str(value))[trim:] for value in candidates
                           if str(value).startswith(current))
    if values:
        print('\n'.join(values))


def arguments(argv=None):
    p = parser()
    words = sys.argv[1:] if argv is None else argv
    supplied = {word.split('=', 1)[0] for word in words if word.startswith('--')}
    args = p.parse_args(argv)
    if args.complete is not None or args.list:
        return args
    if args.make_target:
        resolved = parse_target(args.make_target)
        # A named binding fixes construction; its artwork is still a default,
        # just as with the positional kdp-paperback/lulu-hardcover presets.
        if 'binding' in resolved:
            resolved.pop('cover_style', None)
        for key, value in resolved.items():
            setattr(args, key, value)
        args.preset = args.provider + ('-' + resolved['binding'] if 'binding' in resolved else '')
    provider, _, preset_binding = args.preset.partition('-')
    if provider in PROVIDERS:
        if args.provider and args.provider != provider:
            p.error('preset and --publisher disagree')
        args.provider = provider
    if args.provider and args.preset == 'ebook':
        p.error('ebook cannot use a print publisher')
    if preset_binding:
        profile = next(p for p in DEFAULTS[provider] if p.binding == preset_binding)
        args.binding = args.binding or preset_binding
        args.cover_style = args.cover_style or profile.style
        if args.trim == 'default': args.trim = profile.trim
        args.processing = args.processing or profile.processing
    defaults = dict(PRINT_CONFIG) if args.provider else master_defaults(ROOT)
    if args.preset == 'ebook':
        unsupported = [flag for flag in BOOK_OPTIONS if flag not in ('apocrypha', 'cover')
                       and getattr(args, flag.replace('-', '_')) is not None]
        if unsupported:
            p.error('EPUB reflows semantic text; PDF options do not apply: ' + ', '.join(unsupported))
        if args.cover is None:
            args.cover = 'we-cover-8'
    args.tex_config = defaults
    for flag, (tex, _, _) in BOOK_OPTIONS.items():
        value = getattr(args, flag.replace('-', '_'))
        if value is not None:
            args.tex_config[tex] = value
    args.spine = args.spine or defaults['ConfigSpine']
    args.ink = args.ink or args.paper
    if args.source_date_epoch is not None and args.source_date_epoch < 0:
        p.error('--source-date-epoch must be nonnegative')
    if args.source_date_epoch is not None and args.preset == 'ebook':
        p.error('--source-date-epoch applies to PDFs')
    for key in ('asset_dir', 'output_dir', 'build_dir', 'artifact', 'reference', 'hardcover_template'):
        value = getattr(args, key)
        if value is not None:
            value = value.resolve()
            if re.search(r'[{}%\\\n\r]', str(value)):
                p.error('paths must not contain TeX control characters')
            setattr(args, key, value)
    if args.translation is not None and args.translation not in translation_names():
        p.error('unknown translation; choose a directory under translations/')
    if args.cover is not None and args.cover not in ('none', *cover_names()):
        p.error('unknown cover; choose none or an image basename in img/covers/')
    if any(re.search(r'[{}%\\\n\r]', value) for value in args.tex_config.values()):
        p.error('configuration values must not contain TeX control characters')
    if args.provider:
        if args.stage == 'release' or args.workflow != 'serial' or args.build_dir:
            p.error('print uses all/build/vectorize/check and manages its own work directories')
    else:
        print_only = {'--binding', '--processing', '--paper', '--ink', '--bleed',
                      '--variant', '--hardcover-template', '--artifact', '--reference'}
        if supplied & print_only:
            p.error('binding, processing, stock, encoding and PDF comparison require a print publisher')
        stages = ('all', 'build', 'release', 'check') if args.preset == 'ebook' else ('all', 'build')
        if args.stage not in stages:
            p.error('unsupported stage for ' + args.preset + ': choose ' + ', '.join(stages))
        if args.preset == 'ebook' and (args.trim != 'default' or args.asset_dir or args.build_dir or args.workflow != 'serial'):
            p.error('EPUB does not use PDF trim, assets, scratch directories or parallel workflow')
        if args.workflow == 'parallel' and (args.book != 'all' or args.trim != 'default' or args.asset_dir or args.print_safe == 'true'):
            p.error('parallel supports the complete reading PDF with natural trim and original assets')
    return args


def canonical(book):
    if book == 'all':
        return 'master'
    return subprocess.check_output([str(ROOT / 'bin/book-subset'), '--output-name', book], text=True).strip()


def ebook_plan(args):
    # Import the EPUB naming authority, without executing its build entry point.
    spec = importlib.util.spec_from_file_location('ebook_build', ROOT / 'ebook/build.py')
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    stem = 'we-the-nameless' if args.book == 'all' else module.subset_edition(args.book)[1]
    output = (args.output_dir or ROOT / 'ebook') / (stem + '.epub')
    if args.stage == 'check':
        commands = [[str(ROOT / 'ebook/validate.py'), str(output)], ['epubcheck', str(output)]]
    else:
        command = [sys.executable, str(ROOT / 'ebook/build.py'), '--output', str(output),
                   '--cover', args.cover, '--apocrypha', args.tex_config['ConfigApocrypha']]
        if args.book != 'all': command += ['--subset', args.book]
        if args.stage == 'release': command += ['--require-epubcheck']
        commands = [command]
    return dict(book=stem, preset='ebook', stage=args.stage, output=str(output), commands=commands)


def pdf_plan(args):
    book = canonical(args.book)
    config = dict(args.tex_config)
    signature = hashlib.sha256(json.dumps([config, args.trim, args.workflow,
        str(args.asset_dir)], sort_keys=True).encode()).hexdigest()[:12]
    work = args.build_dir or ROOT / 'build/editions' / book / signature
    destination = (args.output_dir or ROOT) / (book + '.pdf')
    env = {'TEXMFVAR': str(work / 'texmf-var'), 'max_print_line': '60'}
    if args.source_date_epoch is not None:
        env.update(SOURCE_DATE_EPOCH=str(args.source_date_epoch), FORCE_SOURCE_DATE='1')
    commands = []
    if args.book == 'all':
        entrypoint = ROOT / 'master.tex'
        commands.append([sys.executable, 'bin/history_structure.py', str(entrypoint), str(work)])
    else:
        entrypoint = work / (book + '.tex')
        commands.append(['bin/book-subset', '--build-dir', str(work), args.book])
    if config['ConfigEnglishTranslation'] != 'default':
        translation = work / ('translation-' + config['ConfigEnglishTranslation'] + '.lua')
        config['ConfigEnglishTranslationLuaFile'] = str(translation)
        commands.append(['bin/book-translation-lua', config['ConfigEnglishTranslation'], str(translation)])
    if args.asset_dir:
        config['KDPAssetDir'] = str(args.asset_dir)
    elif config['ConfigKDP'] == 'true':
        config['KDPAssetDir'] = str(work / 'assets')
        commands.append(['bin/print-assets', config['KDPAssetDir'], str(ROOT if args.book == 'all' else work / 'chapters')])
    if args.trim != 'default':
        width, height = TRIMS[args.trim]
        config.update(ConfigPrintTrimWidth=f'{width}in', ConfigPrintTrimHeight=f'{height}in')
    if args.workflow == 'parallel':
        names = dict(output_mode='WTN_OUTPUT_MODE', theme='WTN_THEME', verse_layout='WTN_VERSE_LAYOUT',
            commentary='WTN_COMMENTARY', translation='WTN_TRANSLATION', title_page_style='WTN_TITLE_PAGE_STYLE',
            colors='WTN_COLORS', apocrypha='WTN_APOCRYPHA', redactor='WTN_REDACTOR', cover='WTN_COVER',
            cover_style='WTN_COVER_STYLE', spine='WTN_SPINE', print_safe='WTN_PRINT_SAFE')
        env.update({names[flag.replace('-', '_')]: config[tex]
                    for flag, (tex, _, _) in BOOK_OPTIONS.items() if flag.replace('-', '_') in names})
        env['WTN_BUILD_DIR'] = str(work)
        env['WTN_TRANSLATION_LUA'] = config.get('ConfigEnglishTranslationLuaFile', '')
        commands.append(['bin/parallel-build', '--plain', '--no-open'])
    else:
        definitions = ''.join('\\def\\' + key + '{' + value + '}' for key, value in config.items())
        commands.append([sys.executable, 'bin/latex-rerun.py', str(work / (book + '.log')), 'lualatex',
            '-interaction=nonstopmode', '-halt-on-error', '-file-line-error', '-recorder',
            '-output-directory=' + str(work), '-jobname=' + book,
            definitions + '\\input{' + str(entrypoint) + '}'])
    return dict(book=book, preset='pdf', stage=args.stage, config=config, output=str(destination),
                build_dir=str(work), environment=env, commands=commands)


def main(argv=None):
    try:
        args = arguments(argv)
        if args.complete is not None:
            completions(args.complete)
            return 0
        if args.list:
            return subprocess.call([str(ROOT / 'bin/book-subset'), '--list'])
        if args.provider:
            from print_publish import main as print_main
            return print_main(args=args)
        plan = ebook_plan(args) if args.preset == 'ebook' else pdf_plan(args)
        if args.plan:
            print(json.dumps(plan, indent=2))
            return 0
        if args.preset == 'ebook':
            for command in plan['commands']:
                subprocess.run(command, cwd=ROOT, check=True)
        else:
            work = Path(plan['build_dir'])
            (work / 'texmf-var').mkdir(parents=True, exist_ok=True)
            with (work / '.lock').open('w') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                for command in plan['commands']:
                    subprocess.run(command, cwd=ROOT, env={**os.environ, **plan['environment']}, check=True)
                    if command[0] == 'bin/book-subset':
                        for include in re.findall(r'\\include\{([^}]+)\}', (work / (plan['book'] + '.tex')).read_text()):
                            (work / Path(include).parent).mkdir(parents=True, exist_ok=True)
                output = Path(plan['output'])
                output.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile(dir=output.parent, suffix='.pdf', delete=False) as temporary:
                    candidate = Path(temporary.name)
                try:
                    shutil.copy2(work / (plan['book'] + '.pdf'), candidate)
                    os.replace(candidate, output)
                finally:
                    candidate.unlink(missing_ok=True)
            print('Built ' + str(output))
        return 0
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print('build: ' + str(error), file=sys.stderr)
        return getattr(error, 'returncode', 1) or 1


if __name__ == '__main__':
    sys.exit(main())
