#!/usr/bin/env python3
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path


BOOK_ALIASES = {
    "01-genesis": ("Genesis",),
    "02-exodus": ("Exodus",),
    "03-leviticus": ("Leviticus",),
    "04-numbers": ("Numbers",),
    "05-deuteronomy": ("Deuteronomy",),
    "06-joshua": ("Joshua",),
    "07-judges": ("Judges",),
    "10-ezra": ("Ezra",),
    "11-nehemiah": ("Nehemiah",),
    "12-esther": ("Esther",),
}

PART_ALIASES = {
    ("08-samuel", 1): "I Samuel",
    ("08-samuel", 2): "II Samuel",
    ("09-kings", 1): "I Kings",
    ("09-kings", 2): "II Kings",
}

def lua_quote(value):
    return json.dumps(value, ensure_ascii=False)


def tex_escape(value):
    replacements = {
        "\\": r"\textbackslash{}",
        "{": r"\{",
        "}": r"\}",
        "#": r"\#",
        "$": r"\$",
        "%": r"\%",
        "&": r"\&",
        "_": r"\_",
        "~": r"\textasciitilde{}",
        "^": r"\textasciicircum{}",
    }
    return "".join(replacements.get(char, char) for char in value)


def normalize_source_text(text):
    text = text.strip()
    return re.sub(r"\s+", " ", text)


def clean_verse_text(text, verse_number):
    text = text.strip()
    text = re.sub(r"\s+", " ", text)
    text = re.sub(rf"^{re.escape(str(verse_number))}\s+", "", text)
    return text


def chapter_key(chapter):
    return str(chapter.get("number"))


def book_keys(book, chapter):
    part = chapter.get("part")
    if (book["id"], part) in PART_ALIASES:
        return [PART_ALIASES[(book["id"], part)]]
    keys = list(BOOK_ALIASES.get(book["id"], (book["name"],)))
    if part is not None:
        keys.append(f"{book['name']} {part}")
    return keys


def parse_translation(repo_root, translation):
    path = repo_root / "translations" / translation
    if not path.exists():
        raise SystemExit(f"translation not found: {path}")
    result = subprocess.run(
        [str(repo_root / "bin" / "book-parse"), "--strip", str(path)],
        cwd=repo_root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode:
        raise SystemExit(result.stderr.rstrip())
    return json.loads(result.stdout)


def parse_source_translation(repo_root, translation):
    path = repo_root / "translations" / translation / "sources.json"
    if not path.exists():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def source_macro(source):
    if not source:
        return None
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9]*", source):
        raise SystemExit(f"unsafe source name in sources.json: {source!r}")
    return "e" + source


def render_segments(verse):
    segments = verse.get("source_segments", {}).get("translation", [])
    parts = []
    missing_segment_text = False
    for segment in segments:
        text = segment.get("text")
        if text is None:
            missing_segment_text = True
            continue
        text = normalize_source_text(text)
        if not text:
            continue
        macro = source_macro(segment.get("source"))
        escaped = tex_escape(text)
        if macro is None:
            parts.append(escaped)
        else:
            parts.append(rf"\{macro}{{{escaped}}}")
    if parts and not missing_segment_text:
        return " ".join(parts)
    text = verse.get("translation")
    if text:
        sources = [s for s in verse.get("sources", []) if s]
        text = tex_escape(normalize_source_text(text))
        if len(sources) == 1:
            return rf"\{source_macro(sources[0])}{{{text}}}"
        return text
    return None


def build_lookup(data):
    lookup = {}
    duplicates = []
    for book in data["books"]:
        for chapter in book["chapters"]:
            ch_key = chapter_key(chapter)
            for verse in chapter["verses"]:
                verse_key = str(verse["number"])
                text = clean_verse_text(
                    verse.get("translation", verse.get("text", "")),
                    verse["number"],
                )
                for book_key in book_keys(book, chapter):
                    verses = lookup.setdefault(book_key, {}).setdefault(ch_key, {})
                    old = verses.get(verse_key)
                    if old is not None:
                        if old != text:
                            duplicates.append(f"{book_key} {ch_key}:{verse_key}")
                        continue
                    verses[verse_key] = text
    return lookup, duplicates


def build_source_lookup(data):
    lookup = {}
    missing = []
    for book in data["books"]:
        for chapter in book["chapters"]:
            ch_key = chapter_key(chapter)
            for verse in chapter["verses"]:
                verse_key = str(verse["number"])
                text = render_segments(verse)
                if text is None:
                    missing.append(f"{book['name']} {ch_key}:{verse_key}")
                    continue
                for book_key in book_keys(book, chapter):
                    lookup.setdefault(book_key, {}).setdefault(ch_key, {})[verse_key] = text
    return lookup, missing


def sort_key(value):
    return (not value.isdigit(), int(value) if value.isdigit() else value)


def write_lua(path, translation, lookup):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        handle.write("-- Generated by bin/book-translation-lua. Do not edit.\n")
        handle.write(f"book_translation_name = {lua_quote(translation)}\n")
        handle.write("book_translation = {\n")
        for book_key in sorted(lookup):
            handle.write(f"  [{lua_quote(book_key)}] = {{\n")
            for chapter_key_ in sorted(lookup[book_key], key=sort_key):
                handle.write(f"    [{lua_quote(chapter_key_)}] = {{\n")
                for verse_key in sorted(lookup[book_key][chapter_key_], key=sort_key):
                    handle.write(f"      [{lua_quote(verse_key)}] = {lua_quote(lookup[book_key][chapter_key_][verse_key])},\n")
                handle.write("    },\n")
            handle.write("  },\n")
        handle.write("}\n")
        handle.write(
            """
function book_translation_lookup(book, chapter, verse)
  local chapters = book_translation[book]
  if chapters == nil then
    error("missing translation book: " .. book)
  end
  local verses = chapters[tostring(chapter)]
  if verses == nil then
    error("missing translation chapter: " .. book .. " " .. tostring(chapter))
  end
  local function lookup_one(verse_number)
    local text = verses[tostring(verse_number)]
    if text == nil then
      error("missing translation verse: " .. book .. " " .. tostring(chapter) .. ":" .. tostring(verse_number))
    end
    return text
  end
  local first, last = tostring(verse):match("^(%d+)%-(%d+)$")
  if first ~= nil then
    local parts = {}
    for verse_number = tonumber(first), tonumber(last) do
      table.insert(parts, lookup_one(verse_number))
    end
    return table.concat(parts, " ")
  end
  return lookup_one(verse)
end

function book_translation_can_lookup(book, chapter, verse)
  if tostring(verse):match("^%d+$") == nil and tostring(verse):match("^%d+%-%d+$") == nil then
    return false
  end
  local chapters = book_translation[book]
  if chapters == nil then
    return false
  end
  local verses = chapters[tostring(chapter)]
  if verses == nil then
    return false
  end
  local first, last = tostring(verse):match("^(%d+)%-(%d+)$")
  if first ~= nil then
    for verse_number = tonumber(first), tonumber(last) do
      if verses[tostring(verse_number)] == nil then
        return false
      end
    end
    return true
  end
  return verses[tostring(verse)] ~= nil
end
"""
        )


def main():
    parser = argparse.ArgumentParser(description="Generate a LuaLaTeX translation lookup from parsed translation markdown.")
    parser.add_argument("translation", help="translation directory under translations/")
    parser.add_argument("output", help="Lua file to write")
    args = parser.parse_args()
    repo_root = Path(__file__).resolve().parents[1]
    source_data = parse_source_translation(repo_root, args.translation)
    if source_data is None:
        lookup, duplicates = build_lookup(parse_translation(repo_root, args.translation))
        if duplicates:
            sample = "\n".join(duplicates[:20])
            print(f"warning: ignored duplicate translation verses, keeping first text:\n{sample}", file=sys.stderr, flush=True)
    else:
        lookup, missing = build_source_lookup(source_data)
        if missing:
            sample = "\n".join(missing[:20])
            print(
                f"warning: sources.json has no mapped translation for {len(missing)} verses; "
                f"inline English will be used there:\n{sample}",
                file=sys.stderr,
                flush=True,
            )
    write_lua(Path(args.output), args.translation, lookup)


if __name__ == "__main__":
    main()
