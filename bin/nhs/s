#!/usr/bin/env bash
set -u

die() { echo "s: $*" >&2; exit 1; }

[[ -d .lord ]] || die "no .lord directory here; refusing to run"

command -v fixnames >/dev/null || die "missing command: fixnames"

task_id() {
    local path=$1
    path=${path#.lord/}
    printf '%s\n' "${path%%/*}"
}

prompt_of() {
    awk '
        in_prompt && /^EOF$/ { exit }
        in_prompt { print }
        /<<[[:space:]]*"?EOF"?/ { in_prompt = 1 }
    ' "$1"
}

short_of() {
    local file=$1 first id

    id=$(task_id "$file")
    first=$(
        prompt_of "$file" |
            sed '/^[[:space:]]*$/d' |
            head -n 1
    )

    [[ -n "$first" ]] || first="task-$id"
    fixnames -s "$first"
}

active_dirs() {
    local d

    for d in .lord/[0-9]*; do
        [[ -f "$d/n" ]] || continue
        [[ -f "$d/h" ]] || continue
        [[ ! -e "$d/s" ]] || continue
        printf '%s\n' "$d"
    done | sort -V
}

select_task() {
    local -a dirs
    local dir choice

    mapfile -t dirs < <(active_dirs)
    ((${#dirs[@]})) || die "no active TODO tasks found"

    if (($#)); then
        dir=".lord/$1"
        [[ -d "$dir" ]] || die "$dir does not exist"
        [[ -f "$dir/n" ]] || die "$dir/n does not exist"
        [[ -f "$dir/h" ]] || die "$dir/h does not exist"
        printf '%s\n' "$dir"
        return
    fi

    if ((${#dirs[@]} == 1)); then
        printf '%s\n' "${dirs[0]}"
        return
    fi

    printf 'ambiguous active TODOs:\n' >&2
    for dir in "${dirs[@]}"; do
        printf '%s) %s\n' "$(task_id "$dir")" "$(short_of "$dir/n")" >&2
    done

    printf 'Which TODO? ' >&2
    read -r choice

    [[ "$choice" =~ ^[0-9]+$ ]] || die "invalid choice: $choice"

    for dir in "${dirs[@]}"; do
        [[ "$(task_id "$dir")" == "$choice" ]] && {
            printf '%s\n' "$dir"
            return
        }
    done

    die "no such TODO task: $choice"
}

commit_message() {
    local nfile=$1

    awk '
        !in_prompt && /<<[[:space:]]*"?EOF"?/ {
            in_prompt = 1
            next
        }
        in_prompt && /^EOF$/ { exit }
        !in_prompt { next }
        {
            pn++
        }
        pn == 1 {
            first = $0
            print
            next
        }
        pn == 2 {
            if (first !~ /^[[:space:]]*$/ && $0 !~ /^[[:space:]]*$/)
                print ""
            print
            next
        }
        { print }
    ' "$nfile"
}

stage_ambiguous() {
    local dir=$1 choice

    printf 'How should s stage repo changes?\n' >&2
    printf 'p) git add --patch\n' >&2
    printf 'c) codex exec infer from %s\n' "$dir" >&2
    printf 'q) quit\n' >&2
    printf '? ' >&2
    read -r choice

    case "$choice" in
        p|patch)
            git add --patch
            ;;
        c|codex)
            command -v codex >/dev/null || die "missing command: codex"
            codex exec "Read $dir and git stage only the repo changes that belong to that TODO. Do not commit."
            ;;
        q|quit|'')
            die "quit"
            ;;
        *)
            die "invalid choice: $choice"
            ;;
    esac
}

mapfile -t dirs_before < <(active_dirs)
dir=$(select_task "$@")
id=$(task_id "$dir")
nfile="$dir/n"
sfile="$dir/s"

[[ -f "$nfile" ]] || die "$nfile does not exist"
[[ ! -e "$sfile" ]] || die "$sfile already exists"

touch "$sfile" || die "failed to create $sfile"

if ((${#dirs_before[@]} == 1)); then
    git add . || die "git add . failed"
else
    printf 'ambiguous repo changes; not running git add .\n' >&2
    git add -- "$sfile" || die "git add $sfile failed"
    stage_ambiguous "$dir"
fi

git add -- "$sfile" || die "git add $sfile failed"

msgfile=$(mktemp) || die "mktemp failed"
trap 'rm -f "$msgfile"' EXIT

commit_message "$nfile" > "$msgfile" || die "failed to write commit message"
[[ -s "$msgfile" ]] || die "$nfile has empty prompt"

git diff --cached --quiet && die "nothing staged to commit"
git commit -F "$msgfile" || die "git commit failed"
