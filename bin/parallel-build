#!/usr/bin/env python3
import argparse
import curses
import hashlib
import json
import multiprocessing as mp
import os
from pathlib import Path
import queue
import re
import shutil
import subprocess
import sys
import tempfile
import time


ROOT = Path(__file__).resolve().parents[1]
MASTER = ROOT / "master.tex"
BUILD = ROOT / "build" / "parallel"
SOURCE_DIR = BUILD / "masters"
MERGED_PDF = BUILD / "master.pdf"
RAW_MERGED_PDF = BUILD / "master-raw.pdf"
NORMALIZED_MERGED_PDF = BUILD / "master-normalized.pdf"
TEXMFVAR_ROOT = BUILD / "texmf-var"
TEXMFVAR_SEED = TEXMFVAR_ROOT / "_seed"
FRONT_SLUG = "front-matter"
FRONT_PDF = BUILD / FRONT_SLUG / f"{FRONT_SLUG}.pdf"
FRONT_MERGE_PDF = BUILD / FRONT_SLUG / f"{FRONT_SLUG}-merge.pdf"
DEFAULT_PASSES = 1
FINGERPRINT_VERSION = 3

BOOK_RE = re.compile(r"^\\Book\{([^}]+)\}\s*$", re.MULTILINE)
INCLUDE_LINE_RE = re.compile(r"^\s*\\include\{([^}]+)\}\s*$")
BOOKPART_LINE_RE = re.compile(r"^\s*\\BookPart\{([^}]+)\}\s*$")
CHAPTER_RE = re.compile(r"\((?:\./)?((?:\d\d-[^/]+/)[^()\s]+)\.tex")

GREEN = "\033[1;32m"
BLUE = "\033[1;34m"
WHITE = "\033[1;39m"
END = "\033[00m"


def slugify(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def read_document_parts():
    text = MASTER.read_text()
    doc_match = re.search(r"\\begin\{document\}", text)
    if not doc_match:
        raise RuntimeError("master.tex has no \\begin{document}")

    preamble = text[: doc_match.end()]
    books = list(BOOK_RE.finditer(text))
    if not books:
        raise RuntimeError("master.tex has no active \\Book blocks")
    front_body = text[doc_match.end() : books[0].start()]
    front_body = front_body.split(r"\mainmatter", 1)[0].strip()

    parsed = []
    for index, match in enumerate(books):
        title = match.group(1)
        start = match.start()
        end = books[index + 1].start() if index + 1 < len(books) else text.index(r"\end{document}", start)
        body = text[start:end].strip()
        book = {
            "index": index,
            "title": title,
            "slug": f"{index + 1:02d}-{slugify(title)}",
            "chapters": [],
        }
        current_part = None
        for line in body.splitlines():
            part = BOOKPART_LINE_RE.match(line)
            if part:
                current_part = part.group(1)
                continue
            include = INCLUDE_LINE_RE.match(line)
            if not include:
                continue
            include_path = include.group(1)
            chapter = {
                "book_index": index,
                "book_title": title,
                "book_slug": book["slug"],
                "part": current_part,
                "include": include_path,
                "label": chapter_label(include_path),
                "slug": f"{book['slug']}-{slugify(include_path)}",
            }
            book["chapters"].append(chapter)
        parsed.append(book)
    return preamble, front_body, parsed


def all_chapters(books):
    return [chapter for book in books for chapter in book["chapters"]]


def chapter_label(path):
    name = Path(path).name
    return name.replace("-", " ")


def write_front_master(preamble, front_body):
    SOURCE_DIR.mkdir(parents=True, exist_ok=True)
    target = SOURCE_DIR / f"{FRONT_SLUG}.tex"
    target.write_text("\n".join([preamble, "", front_body, "", r"\end{document}", ""]))
    return target


def front_toc_text(books, page_starts=None):
    return "".join(
        rf"\contentsline {{chapter}}{{{book['title']}}}{{{page_starts.get(book['index'], '') if page_starts else ''}}}{{book.{book['title']}}}"
        + "\n"
        for book in books
    )


def write_front_toc(books, output_dir, page_starts=None):
    output_dir.mkdir(parents=True, exist_ok=True)
    (output_dir / f"{FRONT_SLUG}.toc").write_text(front_toc_text(books, page_starts))


def chapter_master_text(preamble, chapter, start_page=None):
    page_setup = [rf"\setcounter{{page}}{{{start_page}}}"] if start_page is not None else []
    part_setup = [rf"\BookPart{{{chapter['part']}}}"] if chapter.get("part") else []
    return "\n".join(
        [
            preamble,
            "",
            r"\mainmatter",
            *page_setup,
            r"\hypersetup{pageanchor=true}",
            r"\pagestyle{fancy}",
            "",
            rf"\Book{{{chapter['book_title']}}}",
            *part_setup,
            rf"\include{{{chapter['include']}}}",
            "",
            r"\end{document}",
            "",
        ]
    )


def write_chapter_master(preamble, chapter, start_page=None):
    SOURCE_DIR.mkdir(parents=True, exist_ok=True)
    target = SOURCE_DIR / f"{chapter['slug']}.tex"
    target.write_text(chapter_master_text(preamble, chapter, start_page))
    return target


def prepare_build_dir(chapter, output_dir):
    output_dir.mkdir(parents=True, exist_ok=True)
    (output_dir / Path(chapter["include"]).parent).mkdir(parents=True, exist_ok=True)


def file_digest(path):
    h = hashlib.sha256()
    h.update(path.read_bytes())
    return h.hexdigest()


def fingerprint_for(payload):
    h = hashlib.sha256()
    h.update(json.dumps(payload, sort_keys=True).encode())
    return h.hexdigest()


def chapter_fingerprint(master_text, chapter, pass_number, start_page):
    include_path = ROOT / f"{chapter['include']}.tex"
    payload = {
        "version": FINGERPRINT_VERSION,
        "kind": "chapter",
        "pass": pass_number,
        "start_page": start_page,
        "master": master_text,
        "include": chapter["include"],
        "include_digest": file_digest(include_path),
    }
    return fingerprint_for(payload)


def front_fingerprint(preamble, front_body, books, pass_number, page_starts):
    payload = {
        "version": FINGERPRINT_VERSION,
        "kind": "front",
        "pass": pass_number,
        "preamble": preamble,
        "front_body": front_body,
        "toc": front_toc_text(books, page_starts),
    }
    return fingerprint_for(payload)


def cache_hit(output_dir, stem, fingerprint):
    pdf = output_dir / f"{stem}.pdf"
    stamp = output_dir / f"{stem}.sha256"
    return pdf.exists() and stamp.exists() and stamp.read_text().strip() == fingerprint


def cache_store(output_dir, stem, fingerprint):
    (output_dir / f"{stem}.sha256").write_text(fingerprint + "\n")


def parse_progress(line):
    return [chapter_label(match) for match in CHAPTER_RE.findall(line)]


def stream_lualatex(owner, master_path, output_dir, texmfvar, event_queue, pass_number):
    cmd = [
        "lualatex",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-recorder",
        f"-output-directory={output_dir}",
        str(master_path),
    ]
    env = os.environ.copy()
    env["TEXMFVAR"] = str(texmfvar)
    event_queue.put(("started-pass", owner, pass_number))
    process = subprocess.Popen(
        cmd,
        cwd=ROOT,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        errors="replace",
    )
    log_tail = []
    assert process.stdout is not None
    for line in process.stdout:
        line = line.rstrip("\n")
        log_tail.append(line)
        log_tail = log_tail[-12:]
        for chapter in parse_progress(line):
            event_queue.put(("chapter", owner, pass_number, chapter))
        if line.startswith("Output written on "):
            event_queue.put(("output", owner, pass_number))
    return process.wait(), log_tail


def texmfvar_for(worker_number):
    return TEXMFVAR_ROOT / f"worker-{worker_number:02d}"


def prepare_texmfvar(worker_number):
    target = texmfvar_for(worker_number)
    if target.exists():
        return target
    target.parent.mkdir(parents=True, exist_ok=True)
    if TEXMFVAR_SEED.exists():
        shutil.copytree(TEXMFVAR_SEED, target)
    else:
        target.mkdir(parents=True, exist_ok=True)
    return target


def warm_tex_cache():
    TEXMFVAR_SEED.mkdir(parents=True, exist_ok=True)
    tool = shutil.which("luaotfload-tool")
    if not tool:
        return
    env = os.environ.copy()
    env["TEXMFVAR"] = str(TEXMFVAR_SEED)
    subprocess.run([tool, "--update"], cwd=ROOT, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def chapter_pdf(chapter):
    return BUILD / chapter["slug"] / f"{chapter['slug']}.pdf"


def run_chapter_job(job, texmfvar, event_queue):
    _, chapter, preamble, pass_number, start_page = job
    started = time.monotonic()
    output_dir = BUILD / chapter["slug"]
    stem = chapter["slug"]
    owner = {
        "kind": "chapter",
        "book_index": chapter["book_index"],
        "label": chapter["label"],
        "slug": chapter["slug"],
    }
    master_text = chapter_master_text(preamble, chapter, start_page)
    fingerprint = chapter_fingerprint(master_text, chapter, pass_number, start_page)
    if cache_hit(output_dir, stem, fingerprint):
        event_queue.put(("cached", owner, pass_number, str(chapter_pdf(chapter).relative_to(ROOT))))
        return 0
    master_path = write_chapter_master(preamble, chapter, start_page)
    prepare_build_dir(chapter, output_dir)
    rc, tail = stream_lualatex(owner, master_path, output_dir, texmfvar, event_queue, pass_number)
    pdf = chapter_pdf(chapter)
    if rc == 0 and pdf.exists():
        cache_store(output_dir, stem, fingerprint)
        event_queue.put(("done", owner, time.monotonic() - started, str(pdf.relative_to(ROOT))))
        return 0
    event_queue.put(("failed", owner, rc, tail))
    return rc or 1


def run_front_job(job, texmfvar, event_queue):
    _, preamble, front_body, books, pass_number, page_starts = job
    started = time.monotonic()
    output_dir = BUILD / FRONT_SLUG
    owner = {"kind": "front", "book_index": -1, "label": "front matter", "slug": FRONT_SLUG}
    fingerprint = front_fingerprint(preamble, front_body, books, pass_number, page_starts)
    if cache_hit(output_dir, FRONT_SLUG, fingerprint):
        event_queue.put(("front-cached", pass_number, str(FRONT_PDF.relative_to(ROOT))))
        return 0
    master_path = write_front_master(preamble, front_body)
    write_front_toc(books, output_dir, page_starts)
    rc, tail = stream_lualatex(owner, master_path, output_dir, texmfvar, event_queue, pass_number)
    if rc == 0 and FRONT_PDF.exists():
        cache_store(output_dir, FRONT_SLUG, fingerprint)
        event_queue.put(("front-done", pass_number, time.monotonic() - started, str(FRONT_PDF.relative_to(ROOT))))
        return 0
    event_queue.put(("front-failed", rc, tail))
    return rc or 1


def worker_main(worker_number, job_queue, event_queue):
    texmfvar = prepare_texmfvar(worker_number)
    failed = False
    while True:
        job = job_queue.get()
        if job is None:
            break
        try:
            if job[0] == "chapter":
                rc = run_chapter_job(job, texmfvar, event_queue)
            else:
                rc = run_front_job(job, texmfvar, event_queue)
            failed = failed or rc != 0
        except Exception as exc:
            failed = True
            event_queue.put(("worker-failed", worker_number, repr(exc)))
    raise SystemExit(1 if failed else 0)


def launch_pool(job_count, event_queue, jobs):
    workers = max(1, min(job_count, mp.cpu_count() or 1))
    job_queue = mp.Queue()
    processes = []
    for worker_number in range(workers):
        process = mp.Process(target=worker_main, args=(worker_number, job_queue, event_queue), name=f"parallel-worker-{worker_number}")
        process.start()
        processes.append(process)
    for job in jobs:
        job_queue.put(job)
    for _ in processes:
        job_queue.put(None)
    return processes, job_queue


def pdf_page_count(pdf):
    pdfinfo = shutil.which("pdfinfo")
    if not pdfinfo:
        raise RuntimeError("pdfinfo is required for the coordinated second pass")
    result = subprocess.run([pdfinfo, str(pdf)], cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"pdfinfo failed for {pdf}")
    match = re.search(r"^Pages:\s+(\d+)\s*$", result.stdout, re.MULTILINE)
    if not match:
        raise RuntimeError(f"pdfinfo did not report a page count for {pdf}")
    return int(match.group(1))


def page_starts_for(books, include_front):
    starts = {}
    next_page = 1
    if include_front:
        next_page += pdf_page_count(FRONT_PDF)
    for book in books:
        book_start = next_page
        for chapter in book["chapters"]:
            starts[chapter["slug"]] = next_page
            next_page += pdf_page_count(chapter_pdf(chapter))
        starts[book["index"]] = book_start
    return starts


class Dashboard:
    def __init__(self, stdscr, books):
        self.stdscr = stdscr
        self.books = books
        self.front = {"status": "waiting", "lines": [], "failed": False}
        self.state = [
            {
                "title": book["title"],
                "total": len(book["chapters"]),
                "seen": 0,
                "pass": 0,
                "status": "waiting",
                "lines": [],
                "failed": False,
            }
            for book in books
        ]
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_GREEN, -1)
        curses.init_pair(2, curses.COLOR_WHITE, -1)
        curses.init_pair(3, curses.COLOR_BLUE, -1)
        curses.init_pair(4, curses.COLOR_RED, -1)
        self.green = curses.color_pair(1) | curses.A_BOLD
        self.white = curses.color_pair(2) | curses.A_BOLD
        self.blue = curses.color_pair(3) | curses.A_BOLD
        self.red = curses.color_pair(4) | curses.A_BOLD

    def add_line(self, index, text):
        target = self.front if index < 0 else self.state[index]
        target["lines"].append(text)
        target["lines"] = target["lines"][-8:]

    def handle(self, event):
        kind = event[0]
        if kind.startswith("front-"):
            if kind == "front-cached":
                self.front["status"] = f"pass {event[1]} cached"
                self.add_line(-1, "cached")
            elif kind == "front-done":
                self.front["status"] = f"pass {event[1]} done"
                self.add_line(-1, f"done in {event[2]:.1f}s")
            elif kind == "front-failed":
                self.front["status"] = f"failed rc={event[1]}"
                self.front["failed"] = True
                for line in event[2][-2:]:
                    self.add_line(-1, line)
            return
        if kind == "worker-failed":
            self.add_line(-1, event[2])
            self.front["failed"] = True
            return
        owner = event[1]
        if owner["kind"] == "front":
            if kind == "started-pass":
                self.front["status"] = f"pass {event[2]}"
            return
        state = self.state[owner["book_index"]]
        if kind == "started-pass":
            state["pass"] = event[2]
            state["status"] = f"pass {event[2]}"
        elif kind == "chapter":
            self.add_line(owner["book_index"], f"{event[3]} compiling")
        elif kind == "cached":
            state["seen"] = min(state["seen"] + 1, state["total"])
            self.add_line(owner["book_index"], f"{owner['label']} cached")
        elif kind == "done":
            state["seen"] = min(state["seen"] + 1, state["total"])
            self.add_line(owner["book_index"], f"{owner['label']} done in {event[2]:.1f}s")
        elif kind == "failed":
            state["failed"] = True
            state["status"] = f"failed rc={event[2]}"
            for line in event[3][-4:]:
                self.add_line(owner["book_index"], line)
        if state["seen"] >= state["total"] and not state["failed"]:
            state["status"] = "done"

    def draw(self):
        self.stdscr.erase()
        height, width = self.stdscr.getmaxyx()
        top_h = 3 if height >= 12 else 0
        if top_h:
            self.draw_front_bar(0, 0, top_h, width)
        grid_y = top_h
        grid_h = max(0, height - grid_y)
        cell_h = max(6, grid_h // 3) if grid_h else 0
        cell_w = max(24, width // 4)
        for i, state in enumerate(self.state):
            row = i // 4
            col = i % 4
            y = grid_y + row * cell_h
            x = col * cell_w
            h = cell_h if row < 2 else height - y
            w = cell_w if col < 3 else width - x
            self.draw_cell(y, x, h, w, state)
        self.stdscr.refresh()

    def draw_front_bar(self, y, x, h, w):
        win = self.stdscr.derwin(h, w, y, x)
        win.erase()
        try:
            win.border()
            line = " | ".join(self.front["lines"])
            win.addstr(0, 2, " Front Matter "[: max(0, w - 4)], self.blue)
            win.addstr(1, 2, self.front["status"][: max(0, w - 4)], self.red if self.front["failed"] else self.green)
            if line:
                start = max(2, w - len(line) - 2)
                win.addstr(1, start, line[: max(0, w - start - 1)], self.white)
        except curses.error:
            pass

    def draw_cell(self, y, x, h, w, state):
        if h < 4 or w < 10:
            return
        win = self.stdscr.derwin(h, w, y, x)
        win.erase()
        try:
            win.border()
            progress = f"{state['seen']}/{state['total']}"
            win.addstr(0, 2, f" {state['title'][: max(0, w - 4)]} ", self.blue)
            win.addstr(1, 2, state["status"][: max(0, w - 4)], self.red if state["failed"] else self.white)
            win.addstr(1, max(2, w - len(progress) - 2), progress, self.blue)
            for offset, line in enumerate(state["lines"][-max(0, h - 4) :], start=3):
                attr = self.green if "done" in line or "cached" in line else self.white
                win.addstr(offset, 2, line[: max(0, w - 4)], attr)
        except curses.error:
            pass


def collect_events(event_queue, processes, expected, dashboard=None):
    completed = 0
    failed = False
    while completed < expected:
        try:
            event = event_queue.get(timeout=0.1)
        except queue.Empty:
            event = None
        if event is not None:
            kind = event[0]
            if kind in {"done", "cached", "failed"}:
                completed += 1
            elif kind in {"front-done", "front-cached", "front-failed"}:
                completed += 1
            if kind in {"failed", "front-failed", "worker-failed"}:
                failed = True
            if dashboard:
                dashboard.handle(event)
            else:
                print_event(event)
        if dashboard:
            dashboard.draw()
        alive = any(process.is_alive() for process in processes)
        if not alive and completed < expected:
            failed = True
            break
        if any(process.exitcode not in (0, None) for process in processes):
            failed = True
    for process in processes:
        process.join()
    return failed or any(process.exitcode not in (0, None) for process in processes)


def print_event(event):
    kind = event[0]
    if kind.startswith("front-"):
        if kind == "front-cached":
            print(f"{GREEN}Front Matter{END} {WHITE}pass {event[1]} cached{END}", flush=True)
        elif kind == "front-done":
            print(f"{GREEN}Front Matter{END} {WHITE}pass {event[1]} done in {event[2]:.1f}s{END}", flush=True)
        elif kind == "front-failed":
            print(f"{GREEN}Front Matter{END} {WHITE}failed rc={event[1]}{END}", flush=True)
            for line in event[2][-6:]:
                print(f"  {line}", flush=True)
        return
    if kind == "worker-failed":
        print(f"{GREEN}Worker {event[1]}{END} {WHITE}{event[2]}{END}", flush=True)
        return
    owner = event[1]
    if owner["kind"] == "front":
        return
    title = owner["slug"].rsplit("-", 1)[0]
    if kind == "cached":
        print(f"{GREEN}{title}{END} {WHITE}pass {event[2]} cached{END} {BLUE}{owner['label']}{END}", flush=True)
    elif kind == "done":
        print(f"{GREEN}{title}{END} {WHITE}done in {event[2]:.1f}s{END} {BLUE}{owner['label']}{END}", flush=True)
    elif kind == "failed":
        print(f"{GREEN}{title}{END} {WHITE}failed rc={event[2]}{END} {BLUE}{owner['label']}{END}", flush=True)
        for line in event[3][-6:]:
            print(f"  {line}", flush=True)


def run_phase(books, jobs, use_curses):
    event_queue = mp.Queue()
    processes, job_queue = launch_pool(len(jobs), event_queue, jobs)
    if use_curses:
        def main(stdscr):
            dashboard = Dashboard(stdscr, books)
            failed = collect_events(event_queue, processes, len(jobs), dashboard)
            dashboard.draw()
            height, width = stdscr.getmaxyx()
            try:
                stdscr.addstr(height - 1, 0, ("Build failed" if failed else "Phase complete")[: max(0, width - 1)], dashboard.red if failed else dashboard.green)
                stdscr.refresh()
            except curses.error:
                pass
            time.sleep(0.8)
            return failed
        try:
            failed = curses.wrapper(main)
        finally:
            for process in processes:
                if process.is_alive():
                    process.terminate()
                process.join()
            job_queue.close()
            job_queue.join_thread()
        return 1 if failed else 0
    failed = collect_events(event_queue, processes, len(jobs))
    job_queue.close()
    job_queue.join_thread()
    return 1 if failed else 0


def clean():
    if BUILD.exists():
        shutil.rmtree(BUILD)


def run_qpdf(args, **kwargs):
    result = subprocess.run(args, cwd=ROOT, **kwargs)
    if result.returncode not in (0, 3):
        raise subprocess.CalledProcessError(result.returncode, args)
    return result


def qpdf_json(pdf, *extra_args):
    qpdf = shutil.which("qpdf")
    if not qpdf:
        raise RuntimeError("qpdf is not installed")
    result = run_qpdf([qpdf, "--json", *extra_args, str(pdf)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    return json.loads(result.stdout)


def named_destination_allowed(name, source_index):
    if source_index == 0:
        return name == "tableofcontents"
    return name.startswith("book.") or name.startswith("chapter.")


def extract_destinations(pdf, source_index, page_offset):
    data = qpdf_json(pdf)
    objects = data["qpdf"][1]
    page_indexes = {page["object"]: index for index, page in enumerate(data["pages"])}
    destinations = {}
    for obj in objects.values():
        value = obj.get("value")
        if not isinstance(value, dict):
            continue
        names = value.get("/Names")
        if not isinstance(names, list):
            continue
        index = 0
        while index + 1 < len(names):
            raw_name = names[index]
            raw_destination = names[index + 1]
            index += 2
            if not isinstance(raw_name, str) or not raw_name.startswith("u:"):
                continue
            name = raw_name[2:]
            if not named_destination_allowed(name, source_index):
                continue
            destination = raw_destination
            if isinstance(raw_destination, str):
                destination_obj = objects.get(f"obj:{raw_destination}", {})
                destination_value = destination_obj.get("value")
                if isinstance(destination_value, dict):
                    destination = destination_value.get("/D")
            if not isinstance(destination, list) or not destination:
                continue
            source_page = destination[0]
            if source_page not in page_indexes:
                continue
            destinations[name] = {"source_page_index": page_indexes[source_page], "page_offset": page_offset, "tail": destination[1:]}
    return destinations, len(data["pages"])


def rebuild_merged_destinations(source_pdfs, merged_pdf):
    qpdf = shutil.which("qpdf")
    if not qpdf:
        print("Warning: qpdf is not installed; merged PDF hyperlinks may be incomplete.", file=sys.stderr)
        return
    all_destinations = {}
    page_offset = 0
    for source_index, pdf in enumerate(source_pdfs):
        destinations, page_count = extract_destinations(pdf, source_index, page_offset)
        all_destinations.update(destinations)
        page_offset += page_count
    if not all_destinations:
        return

    RAW_MERGED_PDF.unlink(missing_ok=True)
    NORMALIZED_MERGED_PDF.unlink(missing_ok=True)
    shutil.move(merged_pdf, RAW_MERGED_PDF)
    run_qpdf([qpdf, str(RAW_MERGED_PDF), str(NORMALIZED_MERGED_PDF)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    merged_pages = [page["object"] for page in qpdf_json(NORMALIZED_MERGED_PDF, "--json-key=pages")["pages"]]
    names = []
    for name in sorted(all_destinations):
        destination = all_destinations[name]
        merged_page_index = destination["page_offset"] + destination["source_page_index"]
        if merged_page_index < len(merged_pages):
            names.extend([f"u:{name}", [merged_pages[merged_page_index], *destination["tail"]]])
    if not names:
        shutil.move(NORMALIZED_MERGED_PDF, merged_pdf)
        return

    dest_tree = qpdf_json(NORMALIZED_MERGED_PDF, "--json-object=trailer/Root/Names/Dests")
    target = None
    for obj in dest_tree["qpdf"][1].values():
        value = obj.get("value")
        if isinstance(value, dict) and (isinstance(value.get("/Names"), list) or isinstance(value.get("/Kids"), list)):
            target = value
            break
    if target is None:
        shutil.move(NORMALIZED_MERGED_PDF, merged_pdf)
        print("Warning: merged PDF has no destination name tree to update.", file=sys.stderr)
        return
    target.pop("/Kids", None)
    target["/Names"] = names
    target["/Limits"] = [names[0], names[-2]]

    patch_path = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".json", dir=BUILD, delete=False) as patch:
            patch_path = Path(patch.name)
            json.dump({"version": dest_tree["version"], "qpdf": dest_tree["qpdf"]}, patch)
        run_qpdf([qpdf, str(NORMALIZED_MERGED_PDF), f"--update-from-json={patch_path}", str(merged_pdf)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    finally:
        if patch_path:
            patch_path.unlink(missing_ok=True)


def strip_front_book_destinations(pdf):
    qpdf = shutil.which("qpdf")
    if not qpdf:
        print("Warning: qpdf is not installed; front-matter TOC links may not survive pdfunite.", file=sys.stderr)
        return pdf
    source_stat = pdf.stat()
    strip_stamp = BUILD / FRONT_SLUG / f"{FRONT_SLUG}-merge.sha256"
    strip_fingerprint = fingerprint_for(
        {
            "version": FINGERPRINT_VERSION,
            "kind": "front-merge-strip",
            "source": str(pdf.relative_to(ROOT)),
            "size": source_stat.st_size,
            "mtime": source_stat.st_mtime_ns,
        }
    )
    if FRONT_MERGE_PDF.exists() and strip_stamp.exists() and strip_stamp.read_text().strip() == strip_fingerprint:
        return FRONT_MERGE_PDF
    try:
        result = subprocess.run([qpdf, "--json", "--json-object=trailer/Root/Names/Dests", str(pdf)], cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=True)
        data = json.loads(result.stdout)
    except Exception as exc:
        print(f"Warning: could not inspect front-matter destinations: {exc}", file=sys.stderr)
        return pdf
    changed = False
    for obj in data["qpdf"][1].values():
        value = obj.get("value")
        if not isinstance(value, dict) or "/Names" not in value:
            continue
        names = value["/Names"]
        if not isinstance(names, list):
            continue
        filtered = []
        for index in range(0, len(names) - 1, 2):
            if isinstance(names[index], str) and names[index].startswith("u:book."):
                changed = True
            else:
                filtered.extend([names[index], names[index + 1]])
        if len(filtered) != len(names):
            value["/Names"] = filtered
            if filtered:
                value["/Limits"] = [filtered[0], filtered[-2]]
            else:
                value.pop("/Limits", None)
    if not changed:
        return pdf
    FRONT_MERGE_PDF.unlink(missing_ok=True)
    patch_path = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".json", dir=BUILD, delete=False) as patch:
            patch_path = Path(patch.name)
            json.dump({"version": data["version"], "qpdf": data["qpdf"]}, patch)
        subprocess.run([qpdf, str(pdf), f"--update-from-json={patch_path}", str(FRONT_MERGE_PDF)], cwd=ROOT, check=True)
        strip_stamp.write_text(strip_fingerprint + "\n")
        return FRONT_MERGE_PDF
    except Exception as exc:
        print(f"Warning: could not strip front-matter book destinations: {exc}", file=sys.stderr)
        return pdf
    finally:
        if patch_path:
            patch_path.unlink(missing_ok=True)


def merge_fingerprint(source_pdfs):
    payload = []
    for pdf in source_pdfs:
        stat = pdf.stat()
        payload.append([str(pdf.relative_to(ROOT)), stat.st_size, stat.st_mtime_ns])
    return fingerprint_for({"version": FINGERPRINT_VERSION, "kind": "merge", "sources": payload})


def merge_pdfs(books, include_front):
    source_pdfs = []
    if include_front:
        source_pdfs.append(strip_front_book_destinations(FRONT_PDF))
    source_pdfs.extend(chapter_pdf(chapter) for chapter in all_chapters(books))
    missing = [pdf for pdf in source_pdfs if not pdf.exists()]
    if missing:
        print("Cannot merge; missing PDFs:", file=sys.stderr)
        for pdf in missing:
            print(f"  {pdf.relative_to(ROOT)}", file=sys.stderr)
        return 1
    fingerprint = merge_fingerprint(source_pdfs)
    stamp = BUILD / "master.sha256"
    if MERGED_PDF.exists() and stamp.exists() and stamp.read_text().strip() == fingerprint:
        return 2
    pdfunite = shutil.which("pdfunite")
    if not pdfunite:
        print("Cannot merge; pdfunite is not installed.", file=sys.stderr)
        return 1
    MERGED_PDF.unlink(missing_ok=True)
    result = subprocess.run([pdfunite, *map(str, source_pdfs), str(MERGED_PDF)], cwd=ROOT)
    if result.returncode == 0:
        try:
            rebuild_merged_destinations(source_pdfs, MERGED_PDF)
        except Exception as exc:
            print(f"Warning: could not rebuild merged PDF destinations: {exc}", file=sys.stderr)
        stamp.write_text(fingerprint + "\n")
    return result.returncode


def open_pdf(pdf):
    opener = shutil.which("xdg-open")
    if opener:
        subprocess.Popen([opener, str(pdf)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print(f"Built {pdf.relative_to(ROOT)}")


def build_jobs(preamble, front_body, books, include_front, pass_number, page_starts=None):
    jobs = []
    if include_front:
        jobs.append(("front", preamble, front_body, books, pass_number, page_starts))
    for chapter in all_chapters(books):
        start_page = page_starts.get(chapter["slug"]) if page_starts else None
        jobs.append(("chapter", chapter, preamble, pass_number, start_page))
    return jobs


def main():
    parser = argparse.ArgumentParser(description="Build active We The Nameless chapters as independent parallel PDFs.")
    parser.add_argument("--plain", action="store_true", help="use line-oriented ANSI output instead of curses")
    parser.add_argument("--list-books", action="store_true", help="print detected active book chunks and exit")
    parser.add_argument("--clean", action="store_true", help="remove build/parallel before building")
    parser.add_argument("--only", metavar="TEXT", help="debug one matching book instead of all active books")
    parser.add_argument("--front-only", action="store_true", help="debug only the title page and front matter")
    parser.add_argument("--passes", type=int, default=DEFAULT_PASSES, help=f"run this many LuaLaTeX passes per chunk; default: {DEFAULT_PASSES}")
    args = parser.parse_args()
    if args.passes < 1:
        parser.error("--passes must be at least 1")

    preamble, front_body, books = read_document_parts()
    if args.list_books:
        for book in books:
            print(f"{book['index'] + 1:02d} {book['title']}: {len(book['chapters'])} active chapters")
        return 0
    if args.only:
        matches = [book for book in books if args.only.lower() in book["title"].lower() or args.only in book["slug"]]
        if len(matches) != 1:
            print(f"--only must match exactly one book; matched {len(matches)}", file=sys.stderr)
            return 2
        books = matches
        books = [{**book, "index": 0, "chapters": [{**chapter, "book_index": 0} for chapter in book["chapters"]]}]

    full_build = not args.only and not args.front_only
    include_front = full_build or args.front_only
    if args.clean:
        clean()
    BUILD.mkdir(parents=True, exist_ok=True)
    warm_tex_cache()
    use_curses = not args.plain and sys.stdout.isatty() and os.environ.get("TERM") not in (None, "", "dumb")

    if args.front_only:
        rc = run_phase(books, [("front", preamble, front_body, books, 1, None)], use_curses)
        return rc

    rc = run_phase(books, build_jobs(preamble, front_body, books, include_front, 1), use_curses)
    if rc != 0:
        return rc
    if args.passes > 1:
        try:
            starts = page_starts_for(books, include_front)
        except Exception as exc:
            print(f"Cannot coordinate second pass: {exc}", file=sys.stderr)
            return 1
        for pass_number in range(2, args.passes + 1):
            rc = run_phase(books, build_jobs(preamble, front_body, books, include_front, pass_number, starts), use_curses)
            if rc != 0:
                return rc
    if not full_build:
        return 0
    rc = merge_pdfs(books, include_front)
    if rc in (0, 2):
        status = "merge cached" if rc == 2 else "merged"
        print(f"{GREEN}Done{END} {WHITE}{status}{END} {BLUE}{MERGED_PDF.relative_to(ROOT)}{END}", flush=True)
        open_pdf(MERGED_PDF)
        return 0
    return rc


if __name__ == "__main__":
    mp.set_start_method("spawn")
    raise SystemExit(main())
