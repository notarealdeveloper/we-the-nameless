#!/usr/bin/env python3
import argparse
import curses
import json
import multiprocessing as mp
import os
from pathlib import Path
import queue
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time


ROOT = Path(__file__).resolve().parents[1]
MASTER = ROOT / "master.tex"


def read_master_config(name):
    text = MASTER.read_text()
    match = re.search(
        rf"^[ \t]*\\def\\{name}[ \t]*\{{([^}}]+)\}}",
        text,
        re.MULTILINE,
    )
    if not match:
        raise RuntimeError(f"master.tex has no active \\def\\{name}{{...}}")
    return match.group(1).strip()


# master.tex is the default source of truth.  Environment variables remain
# available for callers that deliberately want to override its active config.
CONFIG_ENV = {
    "ConfigOutputMode": "WTN_OUTPUT_MODE",
    "ConfigTheme": "WTN_THEME",
    "ConfigVerseLayout": "WTN_VERSE_LAYOUT",
    "ConfigCommentary": "WTN_COMMENTARY",
    "ConfigEnglishTranslation": "WTN_TRANSLATION",
    "IndividualBookTitlePageStyle": "WTN_TITLE_PAGE_STYLE",
    "ConfigColors": "WTN_COLORS",
    "ConfigApocrypha": "WTN_APOCRYPHA",
    "ConfigRedactor": "WTN_REDACTOR",
}
CONFIG = {
    name: os.environ.get(env_name) or read_master_config(name)
    for name, env_name in CONFIG_ENV.items()
}
CONFIG_OVERRIDES = {
    name: value for name, value in CONFIG.items() if os.environ.get(CONFIG_ENV[name]) is not None
}
OUTPUT_MODE = CONFIG["ConfigOutputMode"]
THEME = CONFIG["ConfigTheme"]


def project_path(value):
    """Resolve caller-supplied relative paths from the project root."""
    path = Path(value)
    return path if path.is_absolute() else ROOT / path


BUILD = project_path(
    os.environ.get("WTN_BUILD_DIR", ROOT / "build" / f"{OUTPUT_MODE}-{THEME}" / "parallel")
)
SOURCE_DIR = BUILD / "masters"
MERGED_PDF = BUILD / "master.pdf"
RAW_MERGED_PDF = BUILD / "master-raw.pdf"
NORMALIZED_MERGED_PDF = BUILD / "master-normalized.pdf"
TEXMFVAR_ROOT = BUILD / "texmf-var"
TEXMFVAR_SEED = TEXMFVAR_ROOT / "_seed"
CONFIG_SIGNATURE = BUILD / "config.json"
FRONT_SLUG = "front-matter"
FRONT_PDF = BUILD / FRONT_SLUG / f"{FRONT_SLUG}.pdf"
FRONT_MERGE_PDF = BUILD / FRONT_SLUG / f"{FRONT_SLUG}-merge.pdf"
DEFAULT_PASSES = 2
COORDINATION_STATE = BUILD / ".coordination.json"

BOOK_RE = re.compile(r"^\\Book\{([^}]+)\}\s*$", re.MULTILINE)
INCLUDE_RE = re.compile(r"\\include\{([^}]+)\}")
CHAPTER_RE = re.compile(r"\((?:\./)?((?:\d\d-[^/]+/)[^()\s]+)\.tex")


GREEN = "\033[1;32m"
BLUE = "\033[1;34m"
WHITE = "\033[1;39m"
END = "\033[00m"


def slugify(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def read_document_parts():
    text = MASTER.read_text()
    doc_match = re.search(r"\\begin\{document\}", text)
    if not doc_match:
        raise RuntimeError("master.tex has no \\begin{document}")

    preamble = text[: doc_match.end()]
    if CONFIG_OVERRIDES:
        config = "".join(rf"\def\{name}{{{value}}}" for name, value in CONFIG_OVERRIDES.items())
        # Define overrides before master.tex's guarded defaults and before its
        # conditionals and layout setup consume them.
        preamble = config + "\n" + preamble
    translation_lua = os.environ.get("WTN_TRANSLATION_LUA")
    if translation_lua:
        preamble = rf"\def\ConfigEnglishTranslationLuaFile{{{translation_lua}}}" + "\n" + preamble
    books = list(BOOK_RE.finditer(text))
    if not books:
        raise RuntimeError("master.tex has no \\Book blocks")
    front_body = text[doc_match.end() : books[0].start()]
    front_body = front_body.split(r"\mainmatter", 1)[0].strip()

    chunks = []
    for index, match in enumerate(books):
        title = match.group(1)
        start = match.start()
        end = books[index + 1].start() if index + 1 < len(books) else text.index(r"\end{document}", start)
        body = text[start:end].strip()
        includes = INCLUDE_RE.findall(body)
        chunks.append(
            {
                "index": index,
                "title": title,
                "slug": f"{index + 1:02d}-{slugify(title)}",
                "body": body,
                "includes": includes,
            }
        )
    return preamble, front_body, chunks


def write_front_master(preamble, front_body):
    SOURCE_DIR.mkdir(parents=True, exist_ok=True)
    target = SOURCE_DIR / f"{FRONT_SLUG}.tex"
    target.write_text(
        "\n".join(
            [
                preamble,
                "",
                front_body,
                "",
                r"\end{document}",
                "",
            ]
        )
    )
    return target


def write_front_toc(books, output_dir, page_starts=None):
    output_dir.mkdir(parents=True, exist_ok=True)
    toc = output_dir / f"{FRONT_SLUG}.toc"
    toc.write_text(
        "".join(
            rf"\contentsline {{chapter}}{{{book['title']}}}{{{toc_page_number(page_starts, book['index'])}}}{{book.{book['title']}}}"
            + "\n"
            for book in books
        )
    )


def toc_page_number(page_starts, index):
    if not page_starts:
        return ""
    return page_starts.get(index, page_starts.get(str(index), ""))


def cached_page_starts(books):
    """Return reusable starts only when the previous parallel build is complete."""
    if not CONFIG_SIGNATURE.is_file():
        return None
    try:
        if json.loads(CONFIG_SIGNATURE.read_text()) != CONFIG:
            return None
    except (OSError, json.JSONDecodeError):
        return None
    toc = BUILD / FRONT_SLUG / f"{FRONT_SLUG}.toc"
    required = [
        BUILD / FRONT_SLUG / f"{FRONT_SLUG}.aux",
        FRONT_PDF,
        toc,
    ]
    for book in books:
        output_dir = BUILD / book["slug"]
        required.extend(
            [
                output_dir / f"{book['slug']}.aux",
                output_dir / f"{book['slug']}.pdf",
            ]
        )
    if not all(path.is_file() for path in required):
        return None

    entries = re.findall(
        r"\\contentsline\s*\{chapter\}\{[^}]*\}\{(\d+)\}\{book\.[^}]+\}",
        toc.read_text(),
    )
    if len(entries) != len(books):
        return None
    return {str(book["index"]): int(page) for book, page in zip(books, entries)}


class CoordinationState:
    """A small, socket-free mapping shared by the coordinator and workers."""

    def __init__(self, path):
        self.path = path

    @classmethod
    def create(cls):
        state = cls(COORDINATION_STATE)
        state._write({})
        return state

    def _read(self):
        try:
            return json.loads(self.path.read_text())
        except FileNotFoundError:
            return {}

    def _write(self, values):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        temporary = self.path.with_suffix(f"{self.path.suffix}.{os.getpid()}.tmp")
        temporary.write_text(json.dumps(values, sort_keys=True) + "\n")
        temporary.replace(self.path)

    def get(self, key, default=None):
        return self._read().get(str(key), default)

    def update(self, values):
        current = self._read()
        current.update({str(key): value for key, value in values.items()})
        self._write(current)

    def __contains__(self, key):
        return str(key) in self._read()

    def __setitem__(self, key, value):
        self.update({key: value})


def write_worker_master(preamble, book, start_page=None):
    SOURCE_DIR.mkdir(parents=True, exist_ok=True)
    target = SOURCE_DIR / f"{book['slug']}.tex"
    page_setup = []
    if start_page is not None:
        page_setup.append(rf"\setcounter{{page}}{{{start_page}}}")
    target.write_text(
        "\n".join(
            [
                preamble,
                "",
                r"\mainmatter",
                *page_setup,
                r"\hypersetup{pageanchor=true}",
                r"\pagestyle{fancy}",
                "",
                book["body"],
                "",
                r"\end{document}",
                "",
            ]
        )
    )
    return target


def prepare_build_dirs(book, output_dir):
    output_dir.mkdir(parents=True, exist_ok=True)
    for include in book["includes"]:
        (output_dir / Path(include).parent).mkdir(parents=True, exist_ok=True)


def chapter_label(path):
    pieces = Path(path).parts
    if len(pieces) < 2:
        return path
    chapter = Path(path).name
    chapter = chapter.replace("-", " ")
    return chapter


def parse_progress(line):
    matches = CHAPTER_RE.findall(line)
    if not matches:
        return []
    return [chapter_label(match) for match in matches]


def stream_lualatex(book, master_path, output_dir, texmfvar, event_queue, pass_number):
    cmd = [
        "lualatex",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        f"-output-directory={output_dir}",
        str(master_path),
    ]
    env = os.environ.copy()
    env["TEXMFVAR"] = str(texmfvar)
    # Keep every aux-file marker on its own line without splitting any of the
    # Pentateuch paths themselves, matching the regular Makefile build.
    env["max_print_line"] = "60"

    event_queue.put(("started-pass", book["index"], pass_number, " ".join(cmd)))
    process = subprocess.Popen(
        cmd,
        cwd=ROOT,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        errors="replace",
    )

    lines = queue.Queue()

    def producer():
        assert process.stdout is not None
        for line in process.stdout:
            lines.put(line.rstrip("\n"))
        lines.put(None)

    thread = threading.Thread(target=producer, daemon=True)
    thread.start()

    log_tail = []
    while True:
        line = lines.get()
        if line is None:
            break
        log_tail.append(line)
        log_tail = log_tail[-12:]
        for chapter in parse_progress(line):
            event_queue.put(("chapter", book["index"], pass_number, chapter))
        if line.startswith("Output written on "):
            event_queue.put(("output", book["index"], pass_number, line))

    return_code = process.wait()
    thread.join(timeout=1)
    return return_code, log_tail


def pdf_page_count(pdf):
    pdfinfo = shutil.which("pdfinfo")
    if not pdfinfo:
        raise RuntimeError("pdfinfo is required for the coordinated second pass")
    result = subprocess.run(
        [pdfinfo, str(pdf)],
        cwd=ROOT,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"pdfinfo failed for {pdf}")
    match = re.search(r"^Pages:\s+(\d+)\s*$", result.stdout, re.MULTILINE)
    if not match:
        raise RuntimeError(f"pdfinfo did not report a page count for {pdf}")
    return int(match.group(1))


def wait_for_page_start(book, page_starts):
    key = str(book["index"])
    while key not in page_starts:
        if page_starts.get("failed"):
            raise RuntimeError("coordinated second pass cancelled")
        time.sleep(0.1)
    return page_starts[key]


def texmfvar_for(slug):
    return TEXMFVAR_ROOT / slug


def prepare_texmfvar(slug):
    target = texmfvar_for(slug)
    if target.exists():
        return target
    target.parent.mkdir(parents=True, exist_ok=True)
    if TEXMFVAR_SEED.exists():
        shutil.copytree(TEXMFVAR_SEED, target)
    else:
        target.mkdir(parents=True, exist_ok=True)
    return target


def prepare_worker_tex_caches(books, include_front):
    slugs = [book["slug"] for book in books]
    if include_front:
        slugs.append(FRONT_SLUG)
    for slug in slugs:
        prepare_texmfvar(slug)


def worker_main(book, preamble, passes, page_starts, event_queue):
    started = time.monotonic()
    output_dir = BUILD / book["slug"]
    texmfvar = texmfvar_for(book["slug"])
    try:
        cached_start = page_starts.get(str(book["index"])) if page_starts is not None else None
        master_path = write_worker_master(preamble, book, start_page=cached_start)
        prepare_build_dirs(book, output_dir)
        event_queue.put(("started", book["index"], book["title"], len(book["includes"])))

        rc, tail = stream_lualatex(book, master_path, output_dir, texmfvar, event_queue, 1)
        pdf = output_dir / f"{master_path.stem}.pdf"
        if rc == 0 and passes > 1 and page_starts is not None:
            event_queue.put(("pass-done", book["index"], 1, str(pdf.relative_to(ROOT))))
            start_page = wait_for_page_start(book, page_starts)
            master_path = write_worker_master(preamble, book, start_page=start_page)
            for pass_number in range(2, passes + 1):
                rc, tail = stream_lualatex(book, master_path, output_dir, texmfvar, event_queue, pass_number)
                if rc != 0:
                    break
        elif rc == 0 and passes > 1:
            for pass_number in range(2, passes + 1):
                rc, tail = stream_lualatex(book, master_path, output_dir, texmfvar, event_queue, pass_number)
                if rc != 0:
                    break

        elapsed = time.monotonic() - started
        if rc == 0 and pdf.exists():
            event_queue.put(("done", book["index"], elapsed, str(pdf.relative_to(ROOT))))
            raise SystemExit(0)
        else:
            event_queue.put(("failed", book["index"], rc, tail))
            raise SystemExit(rc or 1)
    except Exception as exc:
        event_queue.put(("failed", book["index"], 99, [repr(exc)]))
        raise SystemExit(99)


def front_main(preamble, front_body, books, passes, page_starts, event_queue):
    started = time.monotonic()
    output_dir = BUILD / FRONT_SLUG
    texmfvar = texmfvar_for(FRONT_SLUG)
    front = {
        "index": -1,
        "title": "Front Matter",
        "slug": FRONT_SLUG,
        "includes": [],
    }
    try:
        master_path = write_front_master(preamble, front_body)
        write_front_toc(books, output_dir, page_starts)
        event_queue.put(("front-started", "compiling front matter"))
        rc, tail = stream_lualatex(front, master_path, output_dir, texmfvar, event_queue, 1)
        if rc == 0 and passes > 1 and page_starts is not None:
            event_queue.put(("front-pass-done", 1, str(FRONT_PDF.relative_to(ROOT))))
            while not page_starts.get("front_toc_ready"):
                if page_starts.get("failed"):
                    raise RuntimeError("coordinated second pass cancelled")
                time.sleep(0.1)
            for pass_number in range(2, passes + 1):
                rc, tail = stream_lualatex(front, master_path, output_dir, texmfvar, event_queue, pass_number)
                if rc != 0:
                    break
        elif rc == 0 and passes > 1:
            for pass_number in range(2, passes + 1):
                rc, tail = stream_lualatex(front, master_path, output_dir, texmfvar, event_queue, pass_number)
                if rc != 0:
                    break

        elapsed = time.monotonic() - started
        if rc == 0 and FRONT_PDF.exists():
            event_queue.put(("front-done", elapsed, str(FRONT_PDF.relative_to(ROOT))))
            raise SystemExit(0)
        event_queue.put(("front-failed", rc, tail))
        raise SystemExit(rc or 1)
    except Exception as exc:
        event_queue.put(("front-failed", 99, [repr(exc)]))
        raise SystemExit(99)


def launch_workers(books, preamble, passes, page_starts, event_queue):
    processes = []
    for book in books:
        process = mp.Process(target=worker_main, args=(book, preamble, passes, page_starts, event_queue), name=book["slug"])
        process.start()
        processes.append(process)
    return processes


def launch_front_worker(preamble, front_body, books, passes, page_starts, event_queue):
    process = mp.Process(
        target=front_main,
        args=(preamble, front_body, books, passes, page_starts, event_queue),
        name=FRONT_SLUG,
    )
    process.start()
    return process


def publish_page_starts_if_ready(books, include_front, page_starts, pass_one_pdfs, front_pass_done):
    if page_starts is None or page_starts.get("ready"):
        return
    if len(pass_one_pdfs) != len(books):
        return
    if include_front and not front_pass_done:
        return

    starts = {}
    next_page = 1
    for book in books:
        pdf = ROOT / pass_one_pdfs[book["index"]]
        starts[book["index"]] = next_page
        next_page += pdf_page_count(pdf)

    if include_front:
        write_front_toc(books, BUILD / FRONT_SLUG, starts)
        page_starts["front_toc_ready"] = True
    for index, page in starts.items():
        page_starts[str(index)] = page
    page_starts["ready"] = True


def warm_tex_cache():
    TEXMFVAR_SEED.mkdir(parents=True, exist_ok=True)
    tool = shutil.which("luaotfload-tool")
    if not tool:
        return
    env = os.environ.copy()
    env["TEXMFVAR"] = str(TEXMFVAR_SEED)
    subprocess.run(
        [tool, "--update"],
        cwd=ROOT,
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


class Dashboard:
    def __init__(self, stdscr, books):
        self.stdscr = stdscr
        self.books = books
        self.front = {
            "status": "waiting",
            "elapsed": None,
            "pdf": None,
            "lines": [],
            "failed": False,
        }
        self.state = [
            {
                "title": book["title"],
                "total": len(book["includes"]),
                "seen": 0,
                "pass": 0,
                "status": "waiting",
                "lines": [],
                "elapsed": None,
                "pdf": None,
            }
            for book in books
        ]
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_GREEN, -1)
        curses.init_pair(2, curses.COLOR_WHITE, -1)
        curses.init_pair(3, curses.COLOR_BLUE, -1)
        curses.init_pair(4, curses.COLOR_RED, -1)
        self.green = curses.color_pair(1) | curses.A_BOLD
        self.white = curses.color_pair(2) | curses.A_BOLD
        self.blue = curses.color_pair(3) | curses.A_BOLD
        self.red = curses.color_pair(4) | curses.A_BOLD

    def add_line(self, index, text):
        if index < 0:
            lines = self.front["lines"]
            lines.append(text)
            self.front["lines"] = lines[-2:]
            return
        lines = self.state[index]["lines"]
        lines.append(text)
        self.state[index]["lines"] = lines[-8:]

    def handle(self, event):
        kind = event[0]
        if kind.startswith("front-"):
            self.handle_front(event)
            return
        index = event[1]
        if index < 0:
            if kind == "started-pass":
                self.front["status"] = f"pass {event[2]}"
            elif kind == "output":
                self.add_line(index, "pdf page stream closed")
            return
        state = self.state[index]
        if kind == "started":
            state["status"] = "running"
        elif kind == "started-pass":
            if event[2] != state["pass"] or event[2] > 1:
                state["seen"] = 0
                state["lines"] = []
            state["pass"] = event[2]
            state["status"] = f"pass {event[2]}"
        elif kind == "pass-done":
            state["seen"] = 0
            state["lines"] = []
            state["status"] = f"pass {event[2]} done"
        elif kind == "chapter":
            state["seen"] = min(state["seen"] + 1, state["total"])
            self.add_line(index, f"{event[3]} compiled")
        elif kind == "output":
            self.add_line(index, "pdf page stream closed")
        elif kind == "done":
            state["status"] = "done"
            state["elapsed"] = event[2]
            state["pdf"] = event[3]
            self.add_line(index, f"done in {event[2]:.1f}s")
        elif kind == "failed":
            state["status"] = f"failed rc={event[2]}"
            for line in event[3][-4:]:
                self.add_line(index, line)

    def handle_front(self, event):
        kind = event[0]
        if kind == "front-started":
            self.front["status"] = event[1]
        elif kind == "front-done":
            self.front["status"] = "front matter done"
            self.front["elapsed"] = event[1]
            self.front["pdf"] = event[2]
            self.add_line(-1, f"done in {event[1]:.1f}s")
        elif kind == "front-failed":
            self.front["status"] = f"front matter failed rc={event[1]}"
            self.front["failed"] = True
            for line in event[2][-2:]:
                self.add_line(-1, line)

    def draw(self):
        self.stdscr.erase()
        height, width = self.stdscr.getmaxyx()
        top_h = 3 if height >= 12 else 0
        if top_h:
            self.draw_front_bar(0, 0, top_h, width)
        grid_y = top_h
        grid_h = max(0, height - grid_y)
        cell_h = max(6, grid_h // 3) if grid_h else 0
        cell_w = max(24, width // 4)
        for i, state in enumerate(self.state):
            row = i // 4
            col = i % 4
            y = grid_y + row * cell_h
            x = col * cell_w
            h = cell_h if row < 2 else height - y
            w = cell_w if col < 3 else width - x
            self.draw_cell(y, x, h, w, state)
        self.stdscr.refresh()

    def draw_front_bar(self, y, x, h, w):
        win = self.stdscr.derwin(h, w, y, x)
        win.erase()
        try:
            win.border()
            title = " Front Matter "
            status = self.front["status"]
            line = " | ".join(self.front["lines"])
            attr = self.red if self.front["failed"] else self.green
            win.addstr(0, 2, title[: max(0, w - 4)], self.blue)
            win.addstr(1, 2, status[: max(0, w - 4)], attr)
            if line:
                start = max(2, w - len(line) - 2)
                win.addstr(1, start, line[: max(0, w - start - 1)], self.white)
        except curses.error:
            pass

    def draw_cell(self, y, x, h, w, state):
        if h < 4 or w < 10:
            return
        win = self.stdscr.derwin(h, w, y, x)
        win.erase()
        try:
            win.border()
        except curses.error:
            return
        title = state["title"][: max(0, w - 4)]
        status = state["status"][: max(0, w - 4)]
        progress = f"{state['seen']}/{state['total']}"
        try:
            win.addstr(0, 2, f" {title} ", self.blue)
            win.addstr(1, 2, status, self.green if state["status"] == "done" else self.white)
            win.addstr(1, max(2, w - len(progress) - 2), progress, self.blue)
            for offset, line in enumerate(state["lines"][-max(0, h - 4) :], start=3):
                attr = self.green if "compiled" in line or line.startswith("done") else self.white
                win.addstr(offset, 2, line[: max(0, w - 4)], attr)
        except curses.error:
            pass


def run_curses(books, preamble, front_body, include_front, passes, initial_page_starts=None):
    event_queue = mp.Queue()
    coordinated = include_front and (passes > 1 or initial_page_starts is not None)
    page_starts = CoordinationState.create() if coordinated else None
    if page_starts is not None and initial_page_starts:
        page_starts.update(initial_page_starts)
        page_starts["ready"] = True
        page_starts["front_toc_ready"] = True
    front_process = launch_front_worker(preamble, front_body, books, passes, page_starts, event_queue) if include_front else None
    processes = launch_workers(books, preamble, passes, page_starts, event_queue)

    def main(stdscr):
        dashboard = Dashboard(stdscr, books)
        completed = 0
        expected = len(processes) + (1 if front_process else 0)
        failed = False
        pass_one_pdfs = {}
        front_pass_done = False
        while completed < expected:
            try:
                event = event_queue.get(timeout=0.1)
            except queue.Empty:
                event = None
            if event is not None:
                if event[0] == "pass-done":
                    pass_one_pdfs[event[1]] = event[3]
                    try:
                        publish_page_starts_if_ready(books, include_front, page_starts, pass_one_pdfs, front_pass_done)
                    except Exception:
                        if page_starts is not None:
                            page_starts["failed"] = True
                        failed = True
                elif event[0] == "front-pass-done":
                    front_pass_done = True
                    try:
                        publish_page_starts_if_ready(books, include_front, page_starts, pass_one_pdfs, front_pass_done)
                    except Exception:
                        if page_starts is not None:
                            page_starts["failed"] = True
                        failed = True
                if event[0] in {"done", "failed", "front-done", "front-failed"}:
                    completed += 1
                if event[0] in {"failed", "front-failed"}:
                    failed = True
                    if page_starts is not None:
                        page_starts["failed"] = True
                dashboard.handle(event)
            dashboard.draw()
        for process in processes:
            process.join()
        if front_process:
            front_process.join()
        dashboard.draw()
        status = "Build failed" if failed else "Front matter and all books compiled"
        height, width = stdscr.getmaxyx()
        try:
            stdscr.addstr(height - 1, 0, status[: max(0, width - 1)], dashboard.red if failed else dashboard.green)
            stdscr.refresh()
        except curses.error:
            pass
        time.sleep(1.5)
        return failed

    try:
        failed = curses.wrapper(main)
    finally:
        all_processes = processes + ([front_process] if front_process else [])
        for process in all_processes:
            if process.is_alive():
                process.terminate()
        for process in all_processes:
            process.join()

    all_processes = processes + ([front_process] if front_process else [])
    failures = [process.exitcode for process in all_processes if process.exitcode not in (0, None)]
    if failed:
        return 1
    return 1 if failures else 0


def run_plain(books, preamble, front_body, include_front, passes, initial_page_starts=None):
    event_queue = mp.Queue()
    coordinated = include_front and (passes > 1 or initial_page_starts is not None)
    page_starts = CoordinationState.create() if coordinated else None
    if page_starts is not None and initial_page_starts:
        page_starts.update(initial_page_starts)
        page_starts["ready"] = True
        page_starts["front_toc_ready"] = True
    front_process = launch_front_worker(preamble, front_body, books, passes, page_starts, event_queue) if include_front else None
    processes = launch_workers(books, preamble, passes, page_starts, event_queue)
    completed = 0
    expected = len(processes) + (1 if front_process else 0)
    failed = False
    pass_one_pdfs = {}
    front_pass_done = False
    while completed < expected:
        event = event_queue.get()
        kind = event[0]
        if kind == "pass-done":
            pass_one_pdfs[event[1]] = event[3]
            try:
                publish_page_starts_if_ready(books, include_front, page_starts, pass_one_pdfs, front_pass_done)
            except Exception as exc:
                if page_starts is not None:
                    page_starts["failed"] = True
                failed = True
                print(f"{GREEN}Coordinator{END} {WHITE}{exc}{END}", flush=True)
            continue
        if kind == "front-pass-done":
            front_pass_done = True
            try:
                publish_page_starts_if_ready(books, include_front, page_starts, pass_one_pdfs, front_pass_done)
            except Exception as exc:
                if page_starts is not None:
                    page_starts["failed"] = True
                failed = True
                print(f"{GREEN}Coordinator{END} {WHITE}{exc}{END}", flush=True)
            continue
        if kind == "front-started":
            print(f"{GREEN}Front Matter{END} {WHITE}{event[1]}{END}", flush=True)
            continue
        if kind == "front-done":
            completed += 1
            print(f"{GREEN}Front Matter{END} {WHITE}done in {event[1]:.1f}s{END} {BLUE}{event[2]}{END}", flush=True)
            continue
        if kind == "front-failed":
            completed += 1
            failed = True
            if page_starts is not None:
                page_starts["failed"] = True
            print(f"{GREEN}Front Matter{END} {WHITE}failed rc={event[1]}{END}", flush=True)
            for line in event[2][-6:]:
                print(f"  {line}", flush=True)
            continue
        index = event[1]
        if index < 0:
            continue
        title = books[index]["title"]
        if kind == "chapter":
            print(f"{GREEN}{title}{END} {WHITE}pass {event[2]}{END} {BLUE}{event[3]} compiled{END}", flush=True)
        elif kind == "done":
            completed += 1
            print(f"{GREEN}{title}{END} {WHITE}done in {event[2]:.1f}s{END} {BLUE}{event[3]}{END}", flush=True)
        elif kind == "failed":
            completed += 1
            failed = True
            if page_starts is not None:
                page_starts["failed"] = True
            print(f"{GREEN}{title}{END} {WHITE}failed rc={event[2]}{END}", flush=True)
            for line in event[3][-6:]:
                print(f"  {line}", flush=True)
    for process in processes:
        process.join()
    if front_process:
        front_process.join()
    if failed:
        return 1
    all_processes = processes + ([front_process] if front_process else [])
    return 1 if any(process.exitcode not in (0, None) for process in all_processes) else 0


def clean():
    if BUILD.exists():
        shutil.rmtree(BUILD)


def strip_front_book_destinations(pdf):
    qpdf = shutil.which("qpdf")
    if not qpdf:
        print("Warning: qpdf is not installed; front-matter TOC links may not survive pdfunite.", file=sys.stderr)
        return pdf

    try:
        result = subprocess.run(
            [qpdf, "--json", "--json-object=trailer/Root/Names/Dests", str(pdf)],
            cwd=ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=True,
        )
        data = json.loads(result.stdout)
        objects = data["qpdf"][1]
    except Exception as exc:
        print(f"Warning: could not inspect front-matter destinations: {exc}", file=sys.stderr)
        return pdf

    changed = False
    for obj in objects.values():
        value = obj.get("value")
        if not isinstance(value, dict) or "/Names" not in value:
            continue
        names = value["/Names"]
        if not isinstance(names, list):
            continue
        filtered = []
        index = 0
        while index + 1 < len(names):
            name = names[index]
            destination = names[index + 1]
            if isinstance(name, str) and name.startswith("u:book."):
                changed = True
            else:
                filtered.extend([name, destination])
            index += 2
        if len(filtered) != len(names):
            value["/Names"] = filtered
            keys = filtered[::2]
            if keys:
                value["/Limits"] = [keys[0], keys[-1]]
            else:
                value.pop("/Limits", None)

    if not changed:
        return pdf

    FRONT_MERGE_PDF.unlink(missing_ok=True)
    patch_path = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".json", dir=BUILD, delete=False) as patch:
            patch_path = Path(patch.name)
            json.dump({"version": data["version"], "qpdf": data["qpdf"]}, patch)
        subprocess.run(
            [qpdf, str(pdf), f"--update-from-json={patch_path}", str(FRONT_MERGE_PDF)],
            cwd=ROOT,
            check=True,
        )
        return FRONT_MERGE_PDF
    except Exception as exc:
        print(f"Warning: could not strip front-matter book destinations: {exc}", file=sys.stderr)
        return pdf
    finally:
        if patch_path:
            patch_path.unlink(missing_ok=True)


def run_qpdf(args, **kwargs):
    result = subprocess.run(args, cwd=ROOT, **kwargs)
    if result.returncode not in (0, 3):
        raise subprocess.CalledProcessError(result.returncode, args)
    return result


def qpdf_json(pdf, *extra_args):
    qpdf = shutil.which("qpdf")
    if not qpdf:
        raise RuntimeError("qpdf is not installed")
    result = run_qpdf(
        [qpdf, "--json", *extra_args, str(pdf)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    return json.loads(result.stdout)


def named_destination_allowed(name, source_index):
    if source_index == 0:
        return name == "tableofcontents"
    return name.startswith("book.") or name.startswith("chapter.")


def extract_destinations(pdf, source_index, page_offset):
    data = qpdf_json(pdf)
    objects = data["qpdf"][1]
    page_indexes = {page["object"]: index for index, page in enumerate(data["pages"])}
    destinations = {}

    for obj in objects.values():
        value = obj.get("value")
        if not isinstance(value, dict):
            continue
        names = value.get("/Names")
        if not isinstance(names, list):
            continue
        index = 0
        while index + 1 < len(names):
            raw_name = names[index]
            raw_destination = names[index + 1]
            index += 2
            if not isinstance(raw_name, str) or not raw_name.startswith("u:"):
                continue
            name = raw_name[2:]
            if not named_destination_allowed(name, source_index):
                continue
            destination = raw_destination
            if isinstance(raw_destination, str):
                destination_obj = objects.get(f"obj:{raw_destination}", {})
                destination_value = destination_obj.get("value")
                if isinstance(destination_value, dict):
                    destination = destination_value.get("/D")
            if not isinstance(destination, list) or not destination:
                continue
            source_page = destination[0]
            if source_page not in page_indexes:
                continue
            destinations[name] = {
                "source_page_index": page_indexes[source_page],
                "page_offset": page_offset,
                "tail": destination[1:],
            }
    return destinations, len(data["pages"])


def rebuild_merged_destinations(source_pdfs, merged_pdf):
    qpdf = shutil.which("qpdf")
    if not qpdf:
        print("Warning: qpdf is not installed; merged PDF hyperlinks may be incomplete.", file=sys.stderr)
        return

    all_destinations = {}
    page_offset = 0
    for source_index, pdf in enumerate(source_pdfs):
        destinations, page_count = extract_destinations(pdf, source_index, page_offset)
        all_destinations.update(destinations)
        page_offset += page_count
    if not all_destinations:
        return

    RAW_MERGED_PDF.unlink(missing_ok=True)
    NORMALIZED_MERGED_PDF.unlink(missing_ok=True)
    shutil.move(merged_pdf, RAW_MERGED_PDF)
    run_qpdf([qpdf, str(RAW_MERGED_PDF), str(NORMALIZED_MERGED_PDF)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    merged_pages = [page["object"] for page in qpdf_json(NORMALIZED_MERGED_PDF, "--json-key=pages")["pages"]]
    names = []
    for name in sorted(all_destinations):
        destination = all_destinations[name]
        merged_page_index = destination["page_offset"] + destination["source_page_index"]
        if merged_page_index >= len(merged_pages):
            continue
        names.extend(
            [
                f"u:{name}",
                [merged_pages[merged_page_index], *destination["tail"]],
            ]
        )
    if not names:
        shutil.move(NORMALIZED_MERGED_PDF, merged_pdf)
        return

    dest_tree = qpdf_json(NORMALIZED_MERGED_PDF, "--json-object=trailer/Root/Names/Dests")
    dest_objects = dest_tree["qpdf"][1]
    target = None
    for obj in dest_objects.values():
        value = obj.get("value")
        if not isinstance(value, dict):
            continue
        if isinstance(value.get("/Names"), list) or isinstance(value.get("/Kids"), list):
            target = value
            break
    if target is None:
        shutil.move(NORMALIZED_MERGED_PDF, merged_pdf)
        print("Warning: merged PDF has no destination name tree to update.", file=sys.stderr)
        return

    target.pop("/Kids", None)
    target["/Names"] = names
    target["/Limits"] = [names[0], names[-2]]

    patch_path = None
    try:
        with tempfile.NamedTemporaryFile("w", suffix=".json", dir=BUILD, delete=False) as patch:
            patch_path = Path(patch.name)
            json.dump({"version": dest_tree["version"], "qpdf": dest_tree["qpdf"]}, patch)
        run_qpdf(
            [qpdf, str(NORMALIZED_MERGED_PDF), f"--update-from-json={patch_path}", str(merged_pdf)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    finally:
        if patch_path:
            patch_path.unlink(missing_ok=True)


def merge_pdfs(books, include_front):
    pdfs = []
    if include_front:
        pdfs.append(strip_front_book_destinations(FRONT_PDF))
    pdfs.extend(BUILD / book["slug"] / f"{book['slug']}.pdf" for book in books)
    missing = [pdf for pdf in pdfs if not pdf.exists()]
    if missing:
        print("Cannot merge; missing PDFs:", file=sys.stderr)
        for pdf in missing:
            print(f"  {pdf.relative_to(ROOT)}", file=sys.stderr)
        return 1

    if len(pdfs) == 1:
        shutil.copyfile(pdfs[0], MERGED_PDF)
        return 0

    pdfunite = shutil.which("pdfunite")
    if not pdfunite:
        print("Cannot merge; pdfunite is not installed.", file=sys.stderr)
        return 1

    MERGED_PDF.unlink(missing_ok=True)
    cmd = [pdfunite, *map(str, pdfs), str(MERGED_PDF)]
    result = subprocess.run(cmd, cwd=ROOT)
    if result.returncode == 0:
        try:
            rebuild_merged_destinations(pdfs, MERGED_PDF)
        except Exception as exc:
            print(f"Warning: could not rebuild merged PDF destinations: {exc}", file=sys.stderr)
    return result.returncode


def open_pdf(pdf):
    opener = shutil.which("xdg-open")
    if opener:
        subprocess.Popen([opener, str(pdf)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print(f"Built {pdf.relative_to(ROOT)}")


def main():
    parser = argparse.ArgumentParser(description="Build the We The Nameless books in parallel.")
    parser.add_argument("--plain", action="store_true", help="use line-oriented ANSI output instead of curses")
    parser.add_argument("--list-books", action="store_true", help="print the detected book chunks and exit")
    parser.add_argument("--clean", action="store_true", help="remove build/parallel before building")
    parser.add_argument("--only", metavar="TEXT", help="debug one matching book instead of all books")
    parser.add_argument("--front-only", action="store_true", help="debug only the title page and front matter")
    parser.add_argument(
        "--passes",
        type=int,
        default=None,
        help=f"force this many LuaLaTeX passes per chunk; default: reuse a complete prior build, otherwise {DEFAULT_PASSES}",
    )
    args = parser.parse_args()
    if args.passes is not None and args.passes < 1:
        parser.error("--passes must be at least 1")

    preamble, front_body, books = read_document_parts()
    if args.list_books:
        for book in books:
            print(f"{book['index'] + 1:02d} {book['title']}: {len(book['includes'])} chapters")
        return 0
    if args.front_only:
        if args.clean:
            clean()
        BUILD.mkdir(parents=True, exist_ok=True)
        warm_tex_cache()
        prepare_worker_tex_caches([], True)
        event_queue = mp.Queue()
        front_main(preamble, front_body, books, args.passes or DEFAULT_PASSES, None, event_queue)
    if args.only:
        matches = [book for book in books if args.only.lower() in book["title"].lower() or args.only in book["slug"]]
        if len(matches) != 1:
            print(f"--only must match exactly one book; matched {len(matches)}", file=sys.stderr)
            return 2
        books = matches
    books = [{**book, "index": index} for index, book in enumerate(books)]
    full_build = not args.only
    include_front = full_build

    initial_page_starts = None
    if args.passes is None and full_build and not args.clean:
        initial_page_starts = cached_page_starts(books)
    passes = args.passes if args.passes is not None else (1 if initial_page_starts else DEFAULT_PASSES)

    if args.clean:
        clean()
    BUILD.mkdir(parents=True, exist_ok=True)
    CONFIG_SIGNATURE.write_text(json.dumps(CONFIG, indent=2, sort_keys=True) + "\n")
    warm_tex_cache()
    prepare_worker_tex_caches(books, include_front)

    if args.plain or not sys.stdout.isatty() or os.environ.get("TERM") in (None, "", "dumb"):
        rc = run_plain(books, preamble, front_body, include_front, passes, initial_page_starts)
    else:
        rc = run_curses(books, preamble, front_body, include_front, passes, initial_page_starts)
    if rc != 0:
        return rc
    if not full_build:
        return 0
    rc = merge_pdfs(books, include_front)
    if rc == 0:
        print(f"{GREEN}Done{END} {WHITE}merged{END} {BLUE}{MERGED_PDF.relative_to(ROOT)}{END}", flush=True)
        open_pdf(MERGED_PDF)
    return rc


if __name__ == "__main__":
    mp.set_start_method("spawn")
    raise SystemExit(main())
