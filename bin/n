#!/usr/bin/env bash
set -u

die() { echo "n: $*" >&2; exit 1; }

[[ -d .lord ]] || die "no .lord directory here; refusing to run"

command -v new >/dev/null || die "missing command: new"
command -v fixnames >/dev/null || die "missing command: fixnames"

prompt_of() {
    awk '
        in_prompt && /^EOF$/ { exit }
        in_prompt { print }
        /<<[[:space:]]*"?EOF"?/ { in_prompt = 1 }
    ' "$1"
}

first_prompt_line() {
    prompt_of "$1" |
        sed '/^[[:space:]]*$/d' |
        head -n 1
}

claim_dir() {
    local id dir

    id=1
    while :; do
        dir=".lord/$id"
        if mkdir "$dir" 2>/dev/null; then
            printf '%s\n' "$dir"
            return
        fi
        [[ -e "$dir" ]] || die "failed to create $dir"
        id=$((id + 1))
    done
}

dir=$(claim_dir)
id=${dir##*/}
file="$dir/n"

new -n "$file" 2 || die "new -n $file 2 failed"
[[ -f "$file" ]] || die "new claimed success, but $file does not exist"

vim -c 'normal 4gg' -c 'startinsert' "$file"

prompt=$(prompt_of "$file")
first=$(first_prompt_line "$file")
[[ -n "$first" ]] || first="task-$id"
short=$(fixnames -s "$first") || die "fixnames failed"

[[ -n "$prompt" ]] || die "$file has empty prompt"

git add -- "$file" || die "git add $file failed"
git commit -m "n: $short" || die "git commit failed"
