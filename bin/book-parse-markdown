#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from book_parse_lib import dump_json, parse_markdown


def main():
    parser = argparse.ArgumentParser(description="Parse translation markdown into book/chapter/verse JSON.")
    parser.add_argument("-s", "--strip", action="store_true", help="strip leading and trailing whitespace from text fields")
    parser.add_argument("path", help="markdown file, chapter directory, book directory, or translations directory")
    args = parser.parse_args()
    try:
        dump_json(parse_markdown(args.path, strip=args.strip))
    except ValueError as exc:
        parser.error(str(exc))


if __name__ == "__main__":
    main()
