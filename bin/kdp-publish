#!/usr/bin/env python3
"""Build print originals, outline fonts, or check PDFs for KDP and Lulu."""
import argparse
from concurrent.futures import ThreadPoolExecutor
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import time
import threading
import uuid

from kdp_cover_geometry import geometry
from print_publish_config import profiles as resolve_profiles, parse_target, paper_for, STAGES
from lulu_cover_geometry import geometry as lulu_geometry

ROOT = Path(__file__).resolve().parents[1]
PRINT_CONFIG = dict(ConfigOutputMode='book', ConfigTheme='lite',
    ConfigVerseLayout='horizontal', ConfigCommentary='true',
    ConfigEnglishTranslation='default', IndividualBookTitlePageStyle='fancy',
    ConfigColors='default', ConfigApocrypha='apocryphal', ConfigRedactor='uncensored',
    ConfigCover='none', ConfigKDP='true')
GS_OPTIONS = ['-dSAFER', '-dBATCH', '-dNOPAUSE', '-sDEVICE=pdfwrite',
    '-dNoOutputFonts', '-dAutoRotatePages=/None', '-sColorConversionStrategy=LeaveColorUnchanged',
    '-dDownsampleColorImages=false', '-dDownsampleGrayImages=false', '-dDownsampleMonoImages=false',
    '-dAutoFilterColorImages=false', '-dColorImageFilter=/FlateEncode',
    '-dAutoFilterGrayImages=false', '-dGrayImageFilter=/FlateEncode',
    '-dPassThroughJPEGImages=true', '-dPassThroughJPXImages=true',
    '-dPreserveOverprintSettings=true', '-dPreserveAnnots=false']
STATUS_LOCK = threading.Lock()

QPDF_OPTIONS = ['--remove-info', '--remove-metadata', '--remove-page-labels',
    '--remove-structure', '--stream-data=preserve', '--deterministic-id']


def digest(path):
    with open(path, 'rb') as f:
        return hashlib.file_digest(f, 'sha256').hexdigest()


def atomic_json(path, data):
    temp = path.with_name(path.name + '.tmp')
    temp.write_text(json.dumps(data, indent=2) + '\n')
    os.replace(temp, path)


def sources():
    # Include ignored/local TeX and assets too: this repository intentionally
    # ignores Lua files and publication outputs. Never hash generated build trees.
    selected = {}
    suffixes = {'.tex', '.sty', '.cls', '.lua', '.py', '.json', '.yaml',
                '.ttf', '.otf', '.png', '.jpg', '.jpeg', '.svg', '.eps'}
    for directory, dirs, files in os.walk(ROOT):
        dirs[:] = sorted(d for d in dirs if d not in
            {'build', 'pub', '.git', '__pycache__', '.obsidian', '.codex', '.agents', '.venv', 'node_modules'})
        for filename in sorted(files):
            p = Path(directory) / filename
            relative = p.relative_to(ROOT)
            if (p.suffix in suffixes or p.name == 'Makefile' or relative.parts[0] in ('bin', 'bin2')
                    or (p.suffix == '.pdf' and 'include' in relative.parts)):
                if p.is_file(): selected[str(relative)] = digest(p)

    for p in sorted((ROOT / 'pub/covers').rglob('*')):
        if p.is_file() and p.suffix in suffixes:
            selected[str(p.relative_to(ROOT))] = digest(p)
    return selected


def versions():
    commands = {'gs': ['--version'], 'qpdf': ['--version'], 'mutool': ['-v'],
        'pdftoppm': ['-v'], 'pdfinfo': ['-v'], 'pdffonts': ['-v'],
        'pdftotext': ['-v'], 'pdfimages': ['-v'], 'lualatex': ['--version'], 'magick': ['-version']}
    result = {}
    for tool, args in commands.items():
        p = subprocess.run([tool, *args], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        if p.returncode:
            raise RuntimeError(f'cannot obtain {tool} version: {p.stdout}')
        result[tool] = p.stdout.strip()
    import PIL, numpy
    result.update(python=sys.version, pillow=PIL.__version__, numpy=numpy.__version__)
    return result


def check_sources(snapshot, run_dir):
    current = sources()
    changes = {
        'added': sorted(current.keys() - snapshot.keys()),
        'removed': sorted(snapshot.keys() - current.keys()),
        'modified': sorted(p for p in snapshot.keys() & current.keys()
                           if snapshot[p] != current[p]),
    }
    if any(changes.values()):
        report = run_dir / 'reports/source-changes.json'
        report.parent.mkdir(parents=True, exist_ok=True)
        atomic_json(report, changes)
        details = '; '.join(f'{kind}: {", ".join(paths)}'
                            for kind, paths in changes.items() if paths)
        raise RuntimeError(f'sources changed during build ({details}); '
                           f'report: {report}; rerun build before vectorizing')



class Pipeline:
    def __init__(self, book, base, output_dir=None, profiles=None, provider='kdp'):
        self.provider = provider
        self.profiles = profiles or resolve_profiles(provider)
        self.artifacts = tuple(f'{kind}-{p.key}' for p in self.profiles for kind in ('interior', 'cover'))
        self.book, self.base = book, base
        self.output_dir = output_dir or ROOT / 'pub' / provider
        self.output_dir.mkdir(parents=True, exist_ok=True)
        self.run_dir = base / 'runs' / (time.strftime('%Y%m%dT%H%M%S') + '-' + uuid.uuid4().hex[:8])
        self.run_dir.mkdir(parents=True)
        self.commands = []
        self.stage, self.operation, self.candidate = '0/6 setup', 'initialize', self.run_dir
        self.log = self.run_dir / 'logs/setup.log'

    def pdf_path(self, artifact, kind):
        return self.output_dir / f'{self.book}-{artifact}-{kind}.pdf'

    def require_pdfs(self, kinds):
        for kind in kinds:
            for artifact in self.artifacts:
                path = self.pdf_path(artifact, kind)
                if not path.is_file():
                    raise FileNotFoundError(f'Missing PDF: {path}; build it or copy your PDF to this path')

    def status(self, state, message):
        label = ' ' + self.profiles[0].key if len(self.profiles) == 1 else ''
        with STATUS_LOCK:
            print(f'[{self.provider.upper()} {self.book}{label} {self.stage}] {state:5} {message}', flush=True)

    def run(self, stage, operation, command, candidate=None, env=None):
        self.stage, self.operation = stage, operation
        self.candidate = candidate or self.run_dir
        self.log = self.run_dir / 'logs' / (re.sub(r'[^a-zA-Z0-9-]', '-', stage + '-' + operation) + '.log')
        self.log.parent.mkdir(parents=True, exist_ok=True)
        args = list(map(str, command))
        env = {**getattr(self, 'environment', {}), **(env or {})}
        self.commands.append(dict(stage=stage, operation=operation, argv=args, environment=env or {}, log=str(self.log)))
        self.status('START', f'{operation}; log: {self.log}')
        with self.log.open('w') as log:
            log.write(shlex.join(args) + '\n'); log.flush()
            with subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, errors='replace', bufsize=1,
                    env={**os.environ, 'PYTHONUNBUFFERED': '1', **env}) as p:
                try:
                    for line in p.stdout:
                        log.write(line); log.flush()
                        progress = re.match(r'visual (?:mupdf|poppler): (\d+)/(\d+)', line)
                        if ((progress and (int(progress[1]) % 25 == 0 or progress[1] in ('1', progress[2])))
                                or line.startswith(('Cover LuaLaTeX pass ', 'Hardcover proof only:'))):
                            self.status('RUN', line.strip())
                    p.wait()
                except BaseException:
                    p.kill(); p.wait()
                    raise
        if p.returncode:
            raise subprocess.CalledProcessError(p.returncode, args)
        self.status('PASS', operation)

    def inspect(self, artifact, pdf, label, stage=5):
        report = self.run_dir / 'reports' / artifact / (label + '-inspection.json')
        self.run(f'{stage}/6 {artifact}', label + ' inspection', ['bin/kdp-inspect', pdf, report], pdf)
        return report

    def validate(self, artifact, reference, candidate, *, visual=True):
        before = self.inspect(artifact, reference, 'reference')
        after = self.inspect(artifact, candidate, 'final')
        reports = after.parent
        self.run(f'5/6 {artifact}', 'structural validation',
            ['bin/kdp-validate', reference, candidate, reports / 'structural-report.json', before, after], candidate)
        if visual:
            self.run(f'5/6 {artifact}', '300 DPI MuPDF and Poppler comparison',
                ['bin/kdp-visual-compare', reference, candidate, reports / 'visual'], candidate)
        return json.loads(after.read_text())

    def record(self, config, snapshot, tools, files, dependencies=None):
        return dict(schema=1, book=self.book, config=config, sources=snapshot,
            source_sha256=hashlib.sha256(json.dumps(snapshot, sort_keys=True).encode()).hexdigest(),
            config_sha256=hashlib.sha256(json.dumps(config, sort_keys=True).encode()).hexdigest(),
            tools=tools, commands=list(self.commands), dependencies=dependencies or {}, files=files,
            reports=[str(p) for p in sorted((self.run_dir / 'reports').rglob('*')) if p.is_file()],
            compatibility_copies=[], run=str(self.run_dir))

    def build(self, args, config, snapshot, tools):
        (self.run_dir / 'texmf-var').mkdir()
        assets = self.run_dir / 'assets'
        title = re.sub(r'^\d+-', '', self.book).replace('-', ' ')
        title = title.title() if len(title) > 1 else title
        files = {}
        for profile in self.profiles:
            binding, style = profile.binding, profile.style
            width, height = profile.dimensions
            key = profile.key
            paper = paper_for(profile, self.provider, args.paper)
            work = self.run_dir / ('work/interior-' + key)
            interior = self.pdf_path('interior-' + key, 'original')
            self.run('1/6 assets', 'select subset', ['bin/book-subset', '--build-dir', work, args.book])
            if not assets.exists():
                self.run('1/6 assets', 'prepare print assets', ['bin/kdp-assets', assets, work / 'chapters'])
            tex_config = ''.join('\\def\\' + k + '{' + v + '}' for k, v in dict(PRINT_CONFIG, ConfigPrintTrimWidth=f'{width}in', ConfigPrintTrimHeight=f'{height}in').items())
            tex_config += '\\def\\KDPAssetDir{' + str(assets) + '}'
            # book-subset emits project-relative include paths. TeX auxiliary files need
            # the same directory tree beneath output-directory.
            entrypoint = work / (self.book + '.tex')
            for include in re.findall(r'\\include\{([^}]+)\}', entrypoint.read_text()):
                (work / Path(include).parent).mkdir(parents=True, exist_ok=True)
            for number in range(1, 4):
                self.run('2/6 interior', f'LuaLaTeX pass {number}', ['lualatex', '-recorder',
                    '-interaction=nonstopmode', '-halt-on-error', '-file-line-error',
                    '-output-directory=' + str(work), tex_config + '\\input{' + str(entrypoint) + '}'],
                    work / (self.book + '.pdf'), {'TEXMFVAR': str(self.run_dir / 'texmf-var')})
            shutil.copy2(work / (self.book + '.pdf'), interior)
            info = json.loads(self.inspect('interior-' + key, interior, 'reference', stage=2).read_text())
            minimum, maximum = (24, 828) if paper == 'premium-color' else (72, 600)
            if binding == 'hardcover':
                minimum, maximum = 76, 550
            if self.provider == 'lulu':
                minimum, maximum = (32 if binding == 'paperback' else 24), 800
            if not minimum <= info['pages'] <= maximum or info['pages'] % 2:
                raise RuntimeError(f'{paper} requires an even page count in {minimum}..{maximum}; got {info["pages"]}')
            if any(p['MediaBox'] != [0, 0, width * 72, height * 72] or p['rotation'] != 0 or p['UserUnit'] != 1 for p in info['page_geometry']):
                raise RuntimeError(f'{binding} interior does not match {width}x{height} no-bleed trim')
            files[str(interior)] = info
            artifact = 'cover-' + key
            cover = self.pdf_path(artifact, 'original')
            template = getattr(args, 'hardcover_template', None) if binding == 'hardcover' else None
            geometry_fn = lulu_geometry if self.provider == 'lulu' else geometry
            g = geometry_fn(info['pages'], width, height, paper, binding, template)
            self.run('3/6 ' + artifact, 'build separate wrap', ['bin/kdp-cover', interior,
                paper, cover, self.run_dir / ('work/' + artifact), style, title,
                args.spine, binding, str(template) if template else '', self.provider], cover)
            cover_info = json.loads(self.inspect(artifact, cover, 'reference', stage=3).read_text())
            expected = [0, 0, 72 * g['width'], 72 * g['height']]
            if (cover_info['pages'] != 1 or any(
                    any(abs(a-b) > .01 for a, b in zip(p['MediaBox'], expected))
                    or p['rotation'] != 0 or p['UserUnit'] != 1 for p in cover_info['page_geometry'])):
                raise RuntimeError(f'{binding} sheet does not match interior page count, trim and paper stock')
            cover_info['cover_geometry'] = g
            cover_info['geometry_source'] = ('kdp-template' if template else
                'template-derived-model' if binding == 'hardcover' else 'kdp-published-formula')
            cover_info['kdp_eligible'] = binding == 'paperback' or 76 <= info['pages'] <= 550
            if self.provider == 'lulu':
                cover_info.pop('kdp_eligible')
                cover_info['geometry_source'] = 'lulu-published-specifications'
                cover_info['lulu_eligible'] = True
            files[str(cover)] = cover_info
        dependencies = {}
        for recorder in self.run_dir.rglob('*.fls'):
            for line in recorder.read_text().splitlines():
                p = Path(line.removeprefix('INPUT '))
                if line.startswith('INPUT ') and p.is_file() and not p.resolve().is_relative_to(ROOT / 'build'):
                    dependencies[str(p.resolve())] = digest(p)
        check_sources(snapshot, self.run_dir)
        record = self.record(config, snapshot, tools, files, dependencies)
        record['reference_files'] = {a: str(self.pdf_path(a, 'original')) for a in self.artifacts}
        record['assets'] = json.loads((assets / 'assets.json').read_text())
        atomic_json(self.run_dir / 'build.json', record)
        atomic_json(self.base / 'build.json', record)
        return record

    def vectorize(self, config):
        self.require_pdfs(('original',))
        candidates = {}
        for artifact in self.artifacts:
            reference = self.pdf_path(artifact, 'original')
            outlined = self.pdf_path(artifact, 'outlined')
            candidate = self.pdf_path(artifact, 'vectorized-pending')
            variant = config['variant']
            self.run(f'4/6 {artifact}', 'outline all fonts', ['gs', *GS_OPTIONS,
                '-dCompatibilityLevel=' + ('1.4' if variant == 'hard' else '1.7'),
                '-sOutputFile=' + str(outlined), reference], outlined)
            encoding = {'soft': ['--object-streams=generate'],
                'medium': ['--object-streams=disable', '--normalize-content=n'],
                'hard': ['--object-streams=disable', '--normalize-content=y', '--linearize']}[variant]
            self.run(f'4/6 {artifact}', 'qpdf cleanup', ['qpdf', '--empty', '--pages', outlined, '1-z',
                '--', *QPDF_OPTIONS, *encoding, candidate], candidate)
            self.validate(artifact, reference, candidate, visual=False)
            candidates[artifact] = candidate
        # Leave the last converted set untouched if any conversion/check fails.
        for artifact, candidate in candidates.items():
            final = self.pdf_path(artifact, 'vectorized')
            os.replace(candidate, final)
            self.pdf_path(artifact, 'outlined').unlink()
            self.status('PASS', str(final))

    def parallel(self, args, config, snapshot, tools):
        # Keep the caller's publication lock across both workers. Each owns its
        # mutable state, assets, TeX cache, reports and disjoint stable PDF names.
        workers = [Pipeline(self.book, self.run_dir / p.key, self.output_dir, (p,), self.provider)
                   for p in self.profiles]
        for worker in workers:
            worker.environment = dict(self.environment)

        def execute(worker):
            try:
                record = None
                if args.stage in ('build', 'all'):
                    record = worker.build(args, config, snapshot, tools)
                if args.stage == 'vectorize' or (args.stage == 'all' and worker.profiles[0].processing == 'vectorized'):
                    worker.vectorize(config)
                return record
            except Exception as error:
                worker.status('FAIL', f'{worker.operation}; candidate: {worker.candidate}; '
                              f'log: {worker.log}; reports: {worker.run_dir}/reports; {error}')
                raise

        # Await all workers even on failure: never release the lock while a worker writes.
        with ThreadPoolExecutor(max_workers=2) as executor:
            futures = [executor.submit(execute, worker) for worker in workers]
            records = [future.result() for future in futures]
        if args.stage in ('build', 'all'):
            self.commands = [command for worker in workers for command in worker.commands]
            record = self.record(config, snapshot, tools,
                {path: info for item in records for path, info in item['files'].items()},
                {path: value for item in records for path, value in item['dependencies'].items()})
            record['reference_files'] = {a: str(self.pdf_path(a, 'original')) for a in self.artifacts}
            record['assets'] = [asset for item in records for asset in item['assets']]
            record['profile_runs'] = {w.profiles[0].key: str(w.run_dir) for w in workers}
            atomic_json(self.run_dir / 'build.json', record)
            atomic_json(self.base / 'build.json', record)

    def check(self):
        self.require_pdfs(('original', 'vectorized'))
        self.run('4/6 validation', 'visual validator self-test', ['bin/kdp-visual-compare', '--self-test'])
        for artifact in self.artifacts:
            self.validate(artifact, self.pdf_path(artifact, 'original'),
                self.pdf_path(artifact, 'vectorized'))


def arguments(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('book', nargs='?')
    parser.add_argument('stage', nargs='?', choices=STAGES, default='all')
    parser.add_argument('--make-target', help='resolve a complete Make target; target qualifiers override flags')
    parser.add_argument('--provider', choices=('kdp', 'lulu'), default='kdp')
    for name, default in [('paper', 'premium-color'), ('ink', 'premium-color'), ('bleed', 'no-bleed'),
            ('trim', 'default'), ('cover-style', None), ('spine', 'ld'), ('variant', 'soft')]:
        parser.add_argument('--' + name, default=default)
    parser.add_argument('--processing', choices=('original', 'vectorized'),
        help='all: keep originals only, or also outline fonts; publisher default if omitted')
    parser.add_argument('--binding', choices=('paperback', 'hardcover'),
        help='override cover construction independently of artwork and trim')
    parser.add_argument('--output-dir', type=Path, help='override pub/<publisher>[/<variant>]')
    parser.add_argument('--plan', action='store_true', help='print resolved configuration and paths; no writes or builds')
    parser.add_argument('--hardcover-template', help='exact KDP hardcover measurements JSON; see PUBLISH.md')
    parser.add_argument('--source-date-epoch', type=int, default=os.environ.get('SOURCE_DATE_EPOCH'),
        help='reproducible PDF timestamp; defaults to the current Git commit timestamp')
    parser.add_argument('--artifact', type=Path, help='check an explicitly named final PDF; requires --reference')
    parser.add_argument('--reference', type=Path)
    args = parser.parse_args(argv)
    if args.make_target:
        for key, value in parse_target(args.make_target).items():
            setattr(args, key, value)
    if not args.book:
        parser.error('book or --make-target is required')
    return args


def main():
    pipeline = None
    args = None
    try:
        args = arguments()
    except ValueError as error:
        print(error, file=sys.stderr)
        return 2
    os.chdir(ROOT)
    try:
        if (args.paper not in ('premium-color', 'standard-color') or args.ink != args.paper
                or args.bleed != 'no-bleed'):
            raise ValueError('supported: no-bleed, matching premium-color or standard-color paper/ink')
        if args.spine not in ('ld', 'nameless') or args.variant not in ('soft', 'medium', 'hard'):
            raise ValueError('unsupported cover style, spine, or PDF encoding variant')
        if bool(args.artifact) != bool(args.reference) or (args.artifact and args.stage != 'check'):
            raise ValueError('--artifact and --reference must be supplied together for check')
        if args.provider == 'lulu' and args.hardcover_template:
            raise ValueError('KDP templates are not compatible with Lulu')
        selected = resolve_profiles(args.provider, args.cover_style, args.trim, args.processing, args.binding)
        if args.hardcover_template and not any(p.binding == 'hardcover' for p in selected):
            raise ValueError('--hardcover-template requires hardcover construction')
        book = subprocess.check_output(['bin/book-subset', '--output-name', args.book], text=True).strip()
        output_dir = args.output_dir or ROOT / 'pub' / args.provider
        if not args.output_dir and args.variant != 'soft': output_dir /= args.variant
        if args.source_date_epoch is not None and args.source_date_epoch < 0:
            raise ValueError('SOURCE_DATE_EPOCH must be nonnegative')
        if args.plan:
            print(json.dumps(dict(book=book, provider=args.provider, stage=args.stage,
                profiles=[dict(style=p.style, binding=p.binding, trim=p.trim, processing=p.processing,
                    paper=paper_for(p, args.provider, args.paper),
                    files={kind: [str(output_dir / f'{book}-{part}-{p.key}-{kind}.pdf')
                        for part in ('interior', 'cover')] for kind in
                        (('original', 'vectorized') if args.stage in ('vectorize', 'check') or
                         (args.stage == 'all' and p.processing == 'vectorized') else ('original',))})
                    for p in selected]), indent=2))
            return 0
        if args.source_date_epoch is None and args.stage in ('build', 'all'):
            args.source_date_epoch = int(subprocess.check_output(['git', 'log', '-1', '--format=%ct'], text=True).strip())
        config = {k: (str(v) if isinstance(v, Path) else v) for k, v in vars(args).items()
                  if k not in ('book', 'stage', 'artifact', 'reference')}
        config['profiles'] = [dict(vars(p), paper=paper_for(p, args.provider, args.paper)) for p in selected]
        config['print'] = PRINT_CONFIG
        if args.hardcover_template:
            config['hardcover_template_sha256'] = digest(args.hardcover_template)
        base = ROOT / 'build' / args.provider / book
        base.mkdir(parents=True, exist_ok=True)
        with (base / '.lock').open('w') as lock:
            try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError: raise RuntimeError(f'another publication operation holds {base}/.lock')
            pipeline = Pipeline(book, base, output_dir, selected, args.provider)
            pipeline.environment = {} if args.source_date_epoch is None else {
                'SOURCE_DATE_EPOCH': str(args.source_date_epoch), 'FORCE_SOURCE_DATE': '1'}
            pipeline.status('START', 'initialize publication stage')
            snapshot, tools = (sources(), versions()) if args.stage in ('build', 'all') else ({}, {})
            pipeline.status('PASS', 'setup')
            if args.artifact:
                pipeline.run('4/6 validation', 'visual validator self-test', ['bin/kdp-visual-compare', '--self-test'])
                pipeline.validate('explicit', args.reference.resolve(), args.artifact.resolve())
            elif args.stage == 'check':
                pipeline.check()
            elif len(selected) > 1:
                pipeline.parallel(args, config, snapshot, tools)
            else:
                if args.stage in ('build', 'all'): pipeline.build(args, config, snapshot, tools)
                if args.stage == 'vectorize' or (args.stage == 'all' and selected[0].processing == 'vectorized'):
                    pipeline.vectorize(config)
            pipeline.status('PASS', f'{args.stage} complete; run: {pipeline.run_dir}')
    except (Exception, KeyboardInterrupt) as error:
        status = getattr(error, 'returncode', 1) or 1
        if pipeline:
            pipeline.log.parent.mkdir(parents=True, exist_ok=True)
            with pipeline.log.open('a') as log: log.write(f'\nFAIL: {error}\n')
            pipeline.status('FAIL', f'exit {status}; operation: {pipeline.operation}; command: {getattr(error, "cmd", "internal check")}; candidate: {pipeline.candidate}; log: {pipeline.log}; reports: {pipeline.run_dir}/reports; {error}')
        else: print(f'[{args.provider.upper()} {args.book} 0/6 setup] FAIL exit {status}: {error}', file=sys.stderr, flush=True)
        return status if status > 0 else 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
