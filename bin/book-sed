#!/usr/bin/env python

r"""
book-sed

Only rewrites inside \eX{...} and \hX{...} blocks.

Inside those blocks:

    God  -> {\God}
    God at block start or after . ? ! -> {\GodInit}

Also upgrades existing:

    {\God} -> {\GodInit}

when sentence-initial.

Dry-run by default: prints unified diffs.
Use -i to modify files in place.
Use -r to recurse through directories for .tex files.
"""

import argparse
import difflib
import re
import sys
from pathlib import Path


SENTENCE_END = ".?!"


def command_at(s, i):
    if i >= len(s) or s[i] != "\\":
        return None

    j = i + 1
    if j < len(s) and s[j].isalpha():
        while j < len(s) and s[j].isalpha():
            j += 1
        return s[i + 1:j], j

    if j < len(s):
        return s[j], j + 1

    return "", j


def is_target_block_command(name):
    return re.fullmatch(r"[eh][A-Za-z]", name or "") is not None


def find_matching_brace(s, open_i):
    assert s[open_i] == "{"

    depth = 0
    i = open_i

    while i < len(s):
        c = s[i]

        if c == "\\":
            i += 2
            continue

        if c == "%" and (i == 0 or s[i - 1] != "\\"):
            while i < len(s) and s[i] != "\n":
                i += 1
            continue

        if c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return i

        i += 1

    return None


def target_blocks(s):
    """
    Yield (body_start, body_end) for \eX{...} and \hX{...}.
    body_start/body_end exclude the surrounding braces.
    """
    i = 0

    while i < len(s):
        cmd = command_at(s, i)
        if not cmd:
            i += 1
            continue

        name, end = cmd

        if not is_target_block_command(name):
            i = end
            continue

        j = end
        while j < len(s) and s[j].isspace():
            j += 1

        if j >= len(s) or s[j] != "{":
            i = end
            continue

        close = find_matching_brace(s, j)
        if close is None:
            i = end
            continue

        yield j + 1, close
        i = close + 1


def skip_comment(s, i):
    while i < len(s) and s[i] != "\n":
        i += 1
    return i


def skip_space_and_groups(s, i):
    """
    For sentence-initial detection, ignore whitespace and harmless grouping braces.

    This means:

        . {\God}
        .
            {\God}

    both count as sentence-initial.
    """
    while i < len(s) and (s[i].isspace() or s[i] in "{}"):
        i += 1
    return i


def replace_inside_block(body, word):
    normal = "{\\" + word + "}"
    init = "{\\" + word + "Init}"

    raw_pat = re.compile(rf"(?<![\\A-Za-z]){re.escape(word)}(?![A-Za-z])")
    macro_pat = re.compile(rf"\{{\\{re.escape(word)}\}}|\\{re.escape(word)}(?![A-Za-z])")

    out = []
    i = 0
    sentence_start = True
    normal_count = 0
    init_count = 0

    while i < len(body):
        c = body[i]

        if c == "%" and (i == 0 or body[i - 1] != "\\"):
            j = skip_comment(body, i)
            out.append(body[i:j])
            i = j
            continue

        # Existing {\God} or \God.
        m = macro_pat.match(body, i)
        if m:
            if sentence_start:
                out.append(init)
                init_count += 1
            else:
                out.append(m.group(0))
            i = m.end()
            sentence_start = False
            continue

        # Raw word.
        m = raw_pat.match(body, i)
        if m:
            if sentence_start:
                out.append(init)
                init_count += 1
            else:
                out.append(normal)
                normal_count += 1
            i = m.end()
            sentence_start = False
            continue

        # Other LaTeX commands: copy the command name untouched.
        cmd = command_at(body, i)
        if cmd:
            _, end = cmd
            out.append(body[i:end])
            i = end
            sentence_start = False
            continue

        out.append(c)
        i += 1

        if c in SENTENCE_END:
            sentence_start = True
            continue

        if c.isspace() or c in "{}":
            continue

        sentence_start = False

    return "".join(out), normal_count, init_count


def replace_word(s, word):
    pieces = []
    last = 0
    total_normal = 0
    total_init = 0

    for start, end in target_blocks(s):
        pieces.append(s[last:start])

        new_body, normal_count, init_count = replace_inside_block(s[start:end], word)
        pieces.append(new_body)

        total_normal += normal_count
        total_init += init_count
        last = end

    pieces.append(s[last:])
    return "".join(pieces), total_normal, total_init


def tex_files(paths, recursive):
    for arg in paths:
        p = Path(arg)

        if p.is_dir():
            if not recursive:
                raise SystemExit(f"{p}: is a directory; use -r/--recursive")
            yield from sorted(p.rglob("*.tex"))
        else:
            if p.suffix != ".tex":
                raise SystemExit(f"{p}: refusing non-.tex file")
            yield p


def process_file(path, word, inplace):
    old = path.read_text()
    new, normal_count, init_count = replace_word(old, word)

    if new != old:
        if inplace:
            path.write_text(new)
        else:
            diff = difflib.unified_diff(
                old.splitlines(keepends=True),
                new.splitlines(keepends=True),
                fromfile=str(path),
                tofile=str(path) + " (book-sed)",
            )
            sys.stdout.writelines(diff)

    return normal_count, init_count


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("-i", "--in-place", action="store_true")
    ap.add_argument("-r", "--recursive", action="store_true")
    ap.add_argument("word", help="word/macro name, e.g. God for \\God and \\GodInit")
    ap.add_argument("paths", nargs="*")
    args = ap.parse_args()

    if not re.fullmatch(r"[A-Za-z]+", args.word):
        raise SystemExit("word must be ASCII letters only")

    total_normal = 0
    total_init = 0

    if not args.paths:
        if args.in_place:
            raise SystemExit("-i does not apply to stdin")

        new, total_normal, total_init = replace_word(sys.stdin.read(), args.word)
        sys.stdout.write(new)
    else:
        for path in tex_files(args.paths, args.recursive):
            normal_count, init_count = process_file(path, args.word, args.in_place)
            total_normal += normal_count
            total_init += init_count

    print(
        f"summary: replaced {total_normal} \\{args.word}, "
        f"{total_init} \\{args.word}Init",
        file=sys.stderr,
    )


if __name__ == "__main__":
    main()
