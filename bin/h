#!/usr/bin/env bash
set -u

die() { echo "h: $*" >&2; exit 1; }

[[ -d .lord ]] || die "no .lord directory here; refusing to run"

command -v fixnames >/dev/null || die "missing command: fixnames"

task_id() {
    local path=$1
    path=${path#.lord/}
    printf '%s\n' "${path%%/*}"
}

prompt_of() {
    awk '
        in_prompt && /^EOF$/ { exit }
        in_prompt { print }
        /<<[[:space:]]*"?EOF"?/ { in_prompt = 1 }
    ' "$1"
}

short_of() {
    local file=$1 first id

    id=$(task_id "$file")
    first=$(
        prompt_of "$file" |
            sed '/^[[:space:]]*$/d' |
            head -n 1
    )

    [[ -n "$first" ]] || first="task-$id"
    fixnames -s "$first"
}

banner() {
    local file=$1 short
    short=$(short_of "$file" 2>/dev/null || printf '%s' "$file")

    printf '#########################\n'
    printf '### %s: %s ###\n' "$(task_id "$file")" "$short"
    printf '#########################\n'
}

task_files() {
    local d

    for d in .lord/[0-9]*; do
        [[ -f "$d/n" ]] || continue
        [[ ! -e "$d/h" ]] || continue
        [[ ! -e "$d/s" ]] || continue
        printf '%s\n' "$d/n"
    done | sort -V
}

select_task() {
    local -a files
    local file choice

    mapfile -t files < <(task_files)
    ((${#files[@]})) || die "no runnable TODO tasks found"

    if ((${#files[@]} == 1)); then
        printf '%s\n' "${files[0]}"
        return
    fi

    for file in "${files[@]}"; do
        banner "$file"
        cat "$file"
        printf '\n'
    done

    printf 'Which TODO? ' >&2
    read -r choice

    [[ "$choice" =~ ^[0-9]+$ ]] || die "invalid choice: $choice"

    for file in "${files[@]}"; do
        [[ "$(task_id "$file")" == "$choice" ]] && {
            printf '%s\n' "$file"
            return
        }
    done

    die "no such TODO task: $choice"
}

append_log() {
    local hfile=$1 logfile=$2

    {
        printf '\n: <<'\''LORD_H_LOG'\''\n'
        cat "$logfile"
        printf '\nLORD_H_LOG\n'
    } >> "$hfile" || die "failed to append log to $hfile"
}

nfile=$(select_task)
dir=${nfile%/*}
id=$(task_id "$nfile")
hfile="$dir/h"
short=$(short_of "$nfile") || die "failed to compute short name"

if ! (set -C; : > "$hfile") 2>/dev/null; then
    die "$hfile already exists; another h may be working on it"
fi
cat "$nfile" > "$hfile" || die "failed to write $hfile"
chmod +x "$hfile" || die "chmod +x $hfile failed"

logfile=$(mktemp) || die "mktemp failed"
trap 'rm -f "$logfile"' EXIT

"./$hfile" "$@" >"$logfile" 2>&1
status=$?

append_log "$hfile" "$logfile"
cat "$logfile" >&2

git add -- "$hfile" || die "git add $hfile failed"
git commit -m "h: $short" || die "git commit failed"

exit "$status"
