NUMBERED_BOOK_DIR_RE = re.compile(r"^(\d+)-(.+)$")


def target_output_name(target):
    return target.output_name or target.name


def fatal(message):
    print(f"book-subset: {message}", file=sys.stderr)
    raise SystemExit(1)


def chapter_path_for_check_book(book, chapter):
    directory = CHECK_J_BOOKS[book]
    if book == "1 Samuel":
        return ROOT / directory / f"1-{chapter:02d}.tex"
    if book == "2 Samuel":
        return ROOT / directory / f"2-{chapter:02d}.tex"
    if book == "1 Kings":
        return ROOT / directory / f"1-{chapter:02d}.tex"
    return ROOT / directory / f"{chapter:02d}.tex"


def include_for_check_ref(book, chapter):
    directory = CHECK_J_BOOKS[book]
    if book == "1 Samuel":
        return f"{directory}/1-{chapter:02d}"
    if book == "2 Samuel":
        return f"{directory}/2-{chapter:02d}"
    if book == "1 Kings":
        return f"{directory}/1-{chapter:02d}"
    return f"{directory}/{chapter:02d}"


def max_verse_for_check_ref(book, chapter):
    verses = source_verse_numbers(book, chapter)
    if not verses:
        path = chapter_path_for_check_book(book, chapter)
        fatal(f"{path.relative_to(ROOT)} has no numbered \\Verse commands")
    return max(verses)


def check_ref_verse(value):
    match = re.match(r"\d+", value.strip())
    if match is None:
        fatal(f"could not parse J-source verse reference {value!r}")
    return int(match.group(0))


def numeric_verse_label(value):
    match = re.match(r"\d+", value.strip())
    if match is None:
        return None
    return int(match.group(0))


def numeric_verse_labels(value):
    value = value.strip()
    range_match = re.match(r"(\d+)\s*-\s*(\d+)", value)
    if range_match is not None:
        start = int(range_match.group(1))
        end = int(range_match.group(2))
        return frozenset(range(start, end + 1))
    label = numeric_verse_label(value)
    if label is None:
        return frozenset()
    return frozenset({label})


@lru_cache(maxsize=None)
def source_verse_numbers(book, chapter):
    path = chapter_path_for_check_book(book, chapter)
    if not path.exists():
        fatal(f"{J_SOURCE_CHECK.relative_to(ROOT)} names missing chapter {book} {chapter}")
    text = path.read_text()
    verses = set()
    pos = 0
    while pos < len(text):
        next_verse = text.find(r"\Verse", pos)
        if next_verse < 0:
            break
        command = parse_command(text, next_verse)
        if command is None or command[0] != "Verse":
            pos = next_verse + 1
            continue
        groups = parse_n_groups(text, command[2], 4)
        if groups is None:
            pos = next_verse + 1
            continue
        parsed_groups, end = groups
        verses.update(numeric_verse_labels(parsed_groups[0][0]))
        pos = end
    return frozenset(verses)


def include_for_ref_book(book_prefix, chapter):
    directory, part = REF_BOOKS[book_prefix]
    if part is None:
        return f"{directory}/{chapter:02d}"
    return f"{directory}/{part}-{chapter:02d}"


def ref_verse_number(value):
    match = re.match(r"\d+", value.strip())
    if match is None:
        fatal(f"could not parse source-map verse reference {value!r}")
    return int(match.group(0))


@lru_cache(maxsize=None)
def verse_numbers_for_include(include):
    path = ROOT / f"{include}.tex"
    if not path.exists():
        fatal(f"source map names missing chapter {include}")
    text = path.read_text()
    verses = set()
    pos = 0
    while pos < len(text):
        next_verse = text.find(r"\Verse", pos)
        if next_verse < 0:
            break
        command = parse_command(text, next_verse)
        if command is None or command[0] != "Verse":
            pos = next_verse + 1
            continue
        groups = parse_n_groups(text, command[2], 4)
        if groups is None:
            pos = next_verse + 1
            continue
        parsed_groups, end = groups
        verses.update(numeric_verse_labels(parsed_groups[0][0]))
        pos = end
    return frozenset(verses)


def source_map_ref_refs(ref):
    normalized = ref.replace("–", "-").replace("—", "-").strip()
    book_prefix = None
    rest = None
    for candidate in sorted(REF_BOOKS, key=len, reverse=True):
        prefix = f"{candidate} "
        if normalized.startswith(prefix):
            book_prefix = candidate
            rest = normalized[len(prefix) :].strip()
            break
    if book_prefix is None or not rest:
        fatal(f"could not parse source-map reference {ref!r}")

    selected = set()
    if ":" not in rest:
        if "-" in rest:
            start_chapter, end_chapter = rest.split("-", 1)
            chapter_range = range(int(start_chapter), int(end_chapter) + 1)
        else:
            chapter_range = range(int(rest), int(rest) + 1)
        for chapter in chapter_range:
            include = include_for_ref_book(book_prefix, chapter)
            for verse in verse_numbers_for_include(include):
                selected.add(f"{include}:{verse}")
        return selected

    chapter_text, verse_text = rest.split(":", 1)
    chapter = int(chapter_text)
    if "-" in verse_text:
        start_text, end_text = verse_text.split("-", 1)
        start = ref_verse_number(start_text)
        end = ref_verse_number(end_text)
    else:
        start = end = ref_verse_number(verse_text)
    include = include_for_ref_book(book_prefix, chapter)
    existing = verse_numbers_for_include(include)
    for verse in range(start, end + 1):
        if verse in existing:
            selected.add(f"{include}:{verse}")
    return selected


@lru_cache(maxsize=None)
def source_map_verse_refs(script):
    script_path = Path(script)
    if not script_path.exists():
        fatal(f"missing {script_path.relative_to(ROOT)}")
    try:
        result = subprocess.run(
            [str(script_path)],
            check=True,
            cwd=ROOT,
            text=True,
            capture_output=True,
        )
        source_map = json.loads(result.stdout)
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        fatal(f"could not read {script_path.relative_to(ROOT)}: {exc}")

    selected = set()
    for ref in source_map:
        selected.update(source_map_ref_refs(ref))
    return frozenset(selected)


@lru_cache(maxsize=1)
def checked_j_source_refs():
    if not J_SOURCE_CHECK.exists():
        fatal(f"missing {J_SOURCE_CHECK.relative_to(ROOT)}")
    text = J_SOURCE_CHECK.read_text()
    marker = "Check to make sure all the following are attributed to J."
    if marker not in text:
        fatal(f"{J_SOURCE_CHECK.relative_to(ROOT)} does not contain the expected checklist marker")
    body = text.split(marker, 1)[1].split("EOF", 1)[0]
    body = body.replace("–", "-").replace("—", "-").replace("α", "")
    body = body.replace("(", "").replace(")", "")

    refs = set()
    current_book = None
    current_chapter = None
    book_names = sorted(CHECK_J_BOOKS, key=len, reverse=True)
    for raw_chunk in body.split(";"):
        chunk = raw_chunk.strip().strip(".")
        if not chunk:
            continue
        for book in book_names:
            prefix = f"{book} "
            if chunk.startswith(prefix):
                current_book = book
                current_chapter = None
                chunk = chunk[len(prefix) :].strip()
                break
        if current_book is None:
            fatal(f"could not identify book for J-source checklist chunk {chunk!r}")

        if re.fullmatch(r"\d+", chunk):
            current_chapter = int(chunk)
            for verse in source_verse_numbers(current_book, current_chapter):
                refs.add(f"{include_for_check_ref(current_book, current_chapter)}:{verse}")
            continue

        for raw_segment in chunk.split(","):
            segment = raw_segment.strip()
            if not segment:
                continue
            if ":" in segment:
                chapter, segment = segment.split(":", 1)
                current_chapter = int(chapter)
            if current_chapter is None:
                fatal(f"missing chapter for J-source checklist segment {segment!r}")
            if "-" in segment:
                start, end = segment.split("-", 1)
                start_verse = check_ref_verse(start)
                end_verse = check_ref_verse(end)
            else:
                start_verse = end_verse = check_ref_verse(segment)
            source_verses = source_verse_numbers(current_book, current_chapter)
            for verse in range(start_verse, end_verse + 1):
                if verse in source_verses:
                    refs.add(f"{include_for_check_ref(current_book, current_chapter)}:{verse}")
    return frozenset(refs - J_CHECKLIST_EXCLUDED_REFS)


def read_master():
    text = MASTER.read_text()
    begin = text.find(BEGIN_DOCUMENT)
    end = text.rfind(END_DOCUMENT)
    if begin < 0 or end < 0:
        fatal("master.tex must contain \\begin{document} and \\end{document}")
    begin += len(BEGIN_DOCUMENT)
    return text[:begin], text[begin:end]


def parse_master_books(body):
    matches = list(BOOK_RE.finditer(body))
    books = []
    for index, match in enumerate(matches):
        title = match.group(1)
        start = match.start()
        end = matches[index + 1].start() if index + 1 < len(matches) else len(body)
        block = body[start:end]
        items = []
        for item in re.finditer(r"\\BookPart\{([^}]+)\}|\\include\{([^}]+)\}", block):
            if item.group(1) is not None:
                items.append(("part", item.group(1)))
            else:
                items.append(("include", item.group(2)))
        books.append({"title": title, "items": items})
    return books


@lru_cache(maxsize=1)
def master_books():
    _preamble, body = read_master()
    return tuple(parse_master_books(body))


@lru_cache(maxsize=1)
def root_numbered_book_dirs():
    directories = []
    for path in ROOT.iterdir():
        if path.is_dir() and NUMBERED_BOOK_DIR_RE.fullmatch(path.name):
            directories.append(path.name)
    return tuple(sorted(directories))


@lru_cache(maxsize=1)
def book_titles_by_dir():
    titles = {}
    for book in master_books():
        for item_type, value in book["items"]:
            if item_type == "include":
                titles.setdefault(book_dir(value), book["title"])
    return titles


def title_from_slug(slug):
    return " ".join(part.capitalize() for part in slug.split("-"))


def numbered_book_target(directory):
    match = NUMBERED_BOOK_DIR_RE.fullmatch(directory)
    if match is None:
        fatal(f"internal error: not a numbered book directory: {directory}")
    number, slug = match.groups()
    title = book_titles_by_dir().get(directory, title_from_slug(slug))
    aliases = frozenset({slug, f"{int(number)}-{slug}"})
    return Target(
        directory,
        title,
        f"{title} as one book volume.",
        books=frozenset({directory}),
        output_name=directory,
        aliases=aliases,
        toc_chapters=True,
        full_frontmatter=True,
        passthrough_includes=(
            frozenset({"01-genesis/apocrypha"})
            if directory == "01-genesis"
            else frozenset({"10-dudetheyreontome/title"})
            if directory == "10-dudetheyreontome"
            else frozenset()
        ),
    )


def individual_compound_book_targets():
    return (
        Target(
            "1-samuel",
            "I Samuel",
            "I Samuel as one book volume.",
            include_prefixes=frozenset({"08-samuel/1-"}),
            output_name="1-samuel",
