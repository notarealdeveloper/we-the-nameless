            "II Kings as one book volume.",
            include_prefixes=frozenset({"09-kings/2-"}),
            output_name="2-kings",
            toc_chapters=True,
            book_title_override="II Kings",
            full_frontmatter=True,
        ),
    )


@lru_cache(maxsize=1)
def dynamic_book_targets():
    targets = [numbered_book_target(directory) for directory in root_numbered_book_dirs()]
    targets.extend(individual_compound_book_targets())
    return tuple(targets)


def chapter_target(include, book):
    directory, chapter_file = include.split("/", 1)
    number, slug = NUMBERED_BOOK_DIR_RE.fullmatch(directory).groups()
    chapter = chapter_file.lstrip("0") or "0"
    title = book["title"]

    # Samuel and Kings store both volumes in one directory (for example,
    # 08-samuel/1-01.tex), so expose the natural make target 1-samuel-1.
    compound = re.fullmatch(r"([12])-(\d+)", chapter_file)
    if compound:
        volume, raw_chapter = compound.groups()
        chapter = raw_chapter.lstrip("0") or "0"
        name = f"{volume}-{slug}-{chapter}"
        title = f"{'I' if volume == '1' else 'II'} {title}"
    else:
        name = f"{slug}-{chapter}"

    return Target(
        name,
        title,
        f"{title}, chapter {chapter}.",
        output_name=name,
        book_title_override=title,
        exact_includes=frozenset({include}),
    )


@lru_cache(maxsize=1)
def dynamic_chapter_targets():
    targets = []
    for book in master_books():
        for item_type, value in book["items"]:
            chapter_file = value.rsplit("/", 1)[-1]
            if (
                item_type == "include"
                and re.fullmatch(r"(?:[12]-)?\d+", chapter_file)
                and (ROOT / f"{value}.tex").is_file()
            ):
                targets.append(chapter_target(value, book))
    return tuple(targets)


@lru_cache(maxsize=1)
def target_aliases():
    aliases = {name: target for name, target in TARGETS.items()}
    for target in dynamic_book_targets():
        names = {target.name, *target.aliases}
        for name in names:
            if name in aliases:
                fatal(f"target alias {name!r} is ambiguous")
            aliases[name] = target
    for target in dynamic_chapter_targets():
        if target.name in aliases:
            fatal(f"target alias {target.name!r} is ambiguous")
        aliases[target.name] = target
    return aliases


def resolve_target(target_name):
    target = target_aliases().get(target_name)
    if target is None:
        fatal(f"unknown target {target_name!r}")
    return target


def book_dir(include):
    return include.split("/", 1)[0]


def in_court_range(include):
    if include.startswith("08-samuel/"):
        return True
    if include.startswith("09-kings/1-"):
        try:
            return int(include.rsplit("-", 1)[1]) <= 2
        except ValueError:
            return False
    return False


def in_mushite_range(include):
    if not include.startswith("09-kings/"):
        return True
    if include.startswith("09-kings/1-"):
        return True
    if include.startswith("09-kings/2-"):
        try:
            return int(include.rsplit("-", 1)[1]) <= 2
        except ValueError:
            return False
    return False


def skip_space(text, pos):
    while pos < len(text) and text[pos].isspace():
        pos += 1
    return pos


def parse_command(text, pos):
    if pos >= len(text) or text[pos] != "\\":
        return None
    start = pos
    pos += 1
    if pos < len(text) and text[pos].isalpha():
        while pos < len(text) and text[pos].isalpha():
            pos += 1
    elif pos < len(text):
        pos += 1
    return text[start + 1 : pos], start, pos


def parse_group(text, pos):
    pos = skip_space(text, pos)
    if pos >= len(text) or text[pos] != "{":
        return None
    start = pos
    depth = 0
    pos += 1
    while pos < len(text):
        char = text[pos]
        if char == "\\":
            pos += 2
            continue
        if char == "%":
            newline = text.find("\n", pos)
            if newline < 0:
                pos = len(text)
            else:
                pos = newline + 1
            continue
        if char == "{":
            depth += 1
        elif char == "}":
            if depth == 0:
                return text[start + 1 : pos], start, pos + 1
            depth -= 1
        pos += 1
    fatal("unclosed braced group")


def parse_n_groups(text, pos, count):
    groups = []
    end = pos
    for _ in range(count):
        parsed = parse_group(text, end)
        if parsed is None:
            return None
        groups.append(parsed)
        end = parsed[2]
    return groups, end


def remove_declare_book_extra_link_list(text, book_title):
    out = []
    pos = 0
    command_text = r"\DeclareBookExtraLinkList"
    while pos < len(text):
        start = text.find(command_text, pos)
        if start < 0:
            out.append(text[pos:])
            break
        parsed = parse_n_groups(text, start + len(command_text), 2)
        if parsed is None:
            out.append(text[pos : start + len(command_text)])
            pos = start + len(command_text)
            continue
        groups, end = parsed
        if groups[0][0] != book_title:
            out.append(text[pos:end])
            pos = end
            continue
        out.append(text[pos:start])
        if end < len(text) and text[end] == "\n":
            end += 1
        pos = end
    return "".join(out)


def subset_preamble(preamble):
    return remove_declare_book_extra_link_list(preamble, "Genesis")


def source_name(command):
    if not command or command[0] not in {"h", "e"}:
        return None
    name = command[1:]
    if name == "JM":
        return "J"
    if name == "BookOfRecords":
        return "Records"
    if name in SOURCE_COMMANDS:
        return name
    return None


def sources_for_include(target, include):
    if target.sources is None:
        return None
    allowed = set(target.sources)
    for exception_include, exception_source in target.source_exceptions:
        if include == exception_include:
            allowed.add(exception_source)
    return frozenset(allowed)


def filter_source_group(text, allowed_sources):
    kept = []
    kept_count = 0
    pos = 0
    while pos < len(text):
        if text[pos] != "\\":
            pos += 1
            continue

        command = parse_command(text, pos)
        if command is None:
            pos += 1
            continue

        command_name, start, after_command = command
        source = source_name(command_name)
        if source is None:
            pos = after_command
            continue

        arg_count = 2 if command_name in {"hDtr", "eDtr"} else 1
        parsed = parse_n_groups(text, after_command, arg_count)
        if parsed is None:
            pos = after_command
            continue

        _groups, end = parsed
        if source in allowed_sources:
            kept.append(text[start:end])
            kept_count += 1
        pos = end

    if not kept:
        return "", 0
    return "\n".join(kept), kept_count


def exception_sources_for_include(target, include):
    return frozenset(
        exception_source
        for exception_include, exception_source in target.source_exceptions
        if include == exception_include
    )


def transform_verse(text, pos, target, include, allowed_sources):
    command = parse_command(text, pos)
    if command is None or command[0] != "Verse":
        fatal("internal parser error: expected \\Verse")
    groups = parse_n_groups(text, command[2], 4)
    if groups is None:
        fatal("malformed \\Verse command")
    parsed_groups, end = groups
    label, hebrew, english, commentary = [group[0] for group in parsed_groups]
    label_number = numeric_verse_label(label)
    ref = f"{include}:{label_number}" if label_number is not None else None
    is_full_book = book_dir(include) in target.full_books
    is_source_map_ref = (
        target.source_map_script is not None
        and ref is not None
        and ref in source_map_verse_refs(target.source_map_script)
    )
    is_j_check_ref = target.check_j_source and ref in checked_j_source_refs()
    is_exception_ref = ref in target.verse_exceptions

    if is_full_book or is_source_map_ref:
        return text[pos:end], end, True

    if target.check_j_source and ref is not None and not is_j_check_ref and not is_exception_ref:
        return "", end, False

    if allowed_sources is None:
        return text[pos:end], end, True

    filtered_hebrew, hebrew_count = filter_source_group(hebrew, allowed_sources)
    filtered_english, english_count = filter_source_group(english, allowed_sources)
    if hebrew_count + english_count == 0:
        if is_j_check_ref:
            return text[pos:end], end, True
        return "", end, False

    verse = (
        rf"\Verse{{{label}}}" + "\n"
        "{\n" + filtered_hebrew.strip() + "\n}\n"
        "{\n" + filtered_english.strip() + "\n}\n"
        "{\n" + commentary + "\n}\n"
    )
    return verse, end, True


def chapter_title(text):
    match = re.search(r"\\Chapter\{([^}]+)\}", text)
    if match is None:
        return None
    return match.group(1)


def transform_chapter(source_path, target, include):
    text = source_path.read_text()
    chapter = chapter_title(text)
    allowed_sources = sources_for_include(target, include)
    out = []
    pos = 0
    verse_count = 0
    while pos < len(text):
        next_verse = text.find(r"\Verse", pos)
        if next_verse < 0:
            out.append(text[pos:])
            break
        out.append(text[pos:next_verse])
        verse, end, kept = transform_verse(text, next_verse, target, include, allowed_sources)
        if kept:
            out.append(verse)
            verse_count += 1
        pos = end
    if verse_count == 0:
        return None, 0, chapter
    return "".join(out).rstrip() + "\n", verse_count, chapter


def build_title_logo_override(target):
    if target.name == "court":
        body = r"{\fontsize{24}{30}\fontfamily{lmr}\selectfont\textrm{The Court History}\par}"
    elif target.name == "r":
        body = r"{\fontsize{32}{38}\fontfamily{lmr}\selectfont\textsc{Torah}\par}"
    else:
        body = rf"{{\fontsize{{42}}{{50}}\fontfamily{{lmr}}\selectfont {target.title_logo}\par}}"
    return "\n".join(
        [
            r"\renewcommand{\WeTitlePageBottomMark}{%",
            r"    \vspace*{\fill}%",
            r"    \begingroup",
            r"    \centering",
            f"    {body}%",
            r"    \endgroup",
            r"    \vspace*{1.2in}%",
            r"}",
        ]
    )


def chapter_link_list(chapters):
    lines = []
    for index, chapter in enumerate(chapters):
        if index and index % 5 == 0:
            lines.append(r"    \par\nobreak\vspace{0.55em}%")
        lines.append(rf"    \ChapterLinkCell{{{chapter}}}%")
    return "\n".join(lines)


def build_navigation_overrides(target, books):
    simple_books = {}
    compound_books = {}
    for book in books:
        title = book["title"]
        current_part = None
        for item_type, value in book["items"]:
            if item_type == "part":
                current_part = value
                continue
            generated = book.get("generated", {}).get(value)
            if generated is None:
                continue
            chapter = book.get("chapters", {}).get(value)
            if chapter is None:
                continue
            if current_part is None:
                simple_books.setdefault(title, []).append(chapter)
            else:
                compound_books.setdefault(title, {}).setdefault(current_part, []).append(chapter)

    lines = [r"\makeatletter"]
    for title, chapters in simple_books.items():
        lines.append(rf"\DeclareChapterLinkList{{{title}}}{{%")
        lines.append(chapter_link_list(chapters))
        lines.append("}%")
    for title, parts in compound_books.items():
        lines.append(rf"\DeclareBookChapterLinkList{{{title}}}{{%")
        for part, chapters in parts.items():
            if not chapters:
                continue
            lines.append(rf"    \BookPartChapterLinks{{{part}}}%")
        lines.append("}%")
        for part, chapters in parts.items():
            if not chapters:
                continue
            lines.append(rf"\DeclareChapterLinkList{{{part}}}{{%")
            lines.append(chapter_link_list(chapters))
            lines.append("}%")

    # Remove default extra links, such as Genesis Apocrypha, unless the subset
    # generator explicitly learns how to include those non-verse sections.
    for book in books:
        if (
            book["title"] == "Genesis"
            and "01-genesis/apocrypha" in target.passthrough_includes
        ):
            lines.append(r"\DeclareBookExtraLinkList{Genesis}{%")
            lines.append(r"    \BookLink{Genesis Apocrypha}{Genesis Apocrypha}%")
            lines.append("}%")
        else:
            lines.append(rf"\DeclareBookExtraLinkList{{{book['title']}}}{{}}%")
    lines.append(r"\makeatother")
    return "\n".join(lines)


def build_toc_overrides(target, books):
    if not target.toc_chapters:
        return ""
    lines = [
        r"\renewcommand{\WeContentsPage}{%",
        r"    \clearpage",
        r"    \newgeometry{left=2.13cm,right=2.13cm,top=2.13cm,bottom=2.13cm}",
        r"    \phantomsection",
        r"    \hypertarget{tableofcontents}{}%",
        r"    \BookHeading{Contents}%",
    ]
    for book in books:
        title = book["title"]
        lines.extend(
            [
                rf"    \FancyBookChapterLinkArray{{{title}}}%",
                rf"    \BookExtraLinkArray{{{title}}}%",
            ]
        )
    lines.extend(
        [
            r"    \WeContentsPageBottomMark",
            r"    \restoregeometry",
            r"}",
            r"\renewcommand{\Book}[1]{%",
            r"    \def\CurrentTitleBook{#1}%",
            r"    \BookHeading{\TableOfContentsLink{#1}}%",
            r"    \phantomsection",
            r"    \hypertarget{book.#1}{}%",
            r"    \def\CurrentBook{#1}%",
            r"    \SetCurrentBookImageDir{#1}%",
            r"    \BookChapterLinkArray{#1}%",
            r"}",
            r"\renewcommand{\Chapter}[1]{%",
            r"    \phantomsection",
            r"    \hypertarget{chapter.\CurrentBook.#1}{}%",
            r"    \ChapterHeading{\ChapterTitleText{#1}}%",
            r"    \def\CurrentChapter{#1}%",
            r"    \markboth{\CurrentBook\ #1}{\CurrentBook\ #1}%",
            r"}",
        ]
    )
    return "\n".join(lines)


def write_entrypoint(target, preamble, books, build_root):
    entrypoint = build_root / f"{target_output_name(target)}.tex"
    lines = [
        preamble,
        "",
        build_title_logo_override(target),
        "",
        build_navigation_overrides(target, books),
        "",
        build_toc_overrides(target, books),
        "",
        (
            r"\GenesisApocryphaTocEntrytrue"
            if "01-genesis/apocrypha" in target.passthrough_includes
            else ""
        ),
        "",
        r"\frontmatter",
        r"\hypersetup{pageanchor=false}",
        r"\pagenumbering{gobble}",
        r"\pagestyle{empty}",
        r"\wetitlepage",
    ]
    if target.full_frontmatter:
        lines.extend(
            [
                r"\pagestyle{empty}",
                r"\clearpage",
                r"\AlphabetHistoryPage",
            ]
        )
    lines.append(r"\WeContentsPage")
    if target.full_frontmatter:
        lines.extend(
            [
                r"\clearpage",
                r"\SourceLegendPage",
            ]
        )
    lines.extend(
        [
            r"\mainmatter",
            r"\hypersetup{pageanchor=true}",
            r"\pagestyle{fancy}",
            "",
        ]
    )
    for book in books:
        lines.append(rf"\Book{{{book['title']}}}")
        pending_part = None
        for item_type, value in book["items"]:
            if item_type == "part":
                pending_part = value
                continue
            include_path = value
            generated = book.get("generated", {}).get(include_path)
            if generated is None:
                continue
            if include_path in target.passthrough_includes:
                if include_path == "01-genesis/apocrypha":
                    lines.extend(
                        [
                            r"\ifConfigApocryphaOn",
                            rf"\include{{{generated}}}",
                            r"\fi",
                        ]
                    )
                else:
                    lines.append(rf"\include{{{generated}}}")
                pending_part = None
                continue
            if pending_part is not None:
                lines.append(rf"\BookPart{{{pending_part}}}")
                pending_part = None
            lines.append(rf"\include{{{generated}}}")
        lines.append("")
    lines.extend([r"\end{document}", ""])
    entrypoint.parent.mkdir(parents=True, exist_ok=True)
    entrypoint.write_text("\n".join(lines))
    return entrypoint


def copy_or_filter_chapter(include, target, target_dir):
    source = ROOT / f"{include}.tex"
    destination = target_dir / f"{include}.tex"
    destination.parent.mkdir(parents=True, exist_ok=True)

    if include in target.passthrough_includes:
        shutil.copyfile(source, destination)
        tex_path = destination.with_suffix("")
        try:
            tex_path = tex_path.relative_to(target_dir.parent)
        except ValueError:
            pass
        return tex_path.as_posix(), 0, None

    text, verse_count, chapter = transform_chapter(source, target, include)
    if text is None:
        if destination.exists():
            destination.unlink()
        return None, 0, chapter
    destination.write_text(text)
    tex_path = destination.with_suffix("")
    try:
        tex_path = tex_path.relative_to(target_dir.parent)
    except ValueError:
        pass
    return tex_path.as_posix(), verse_count, chapter


def selected_include(include, target):
    if target.exact_includes:
        return include in target.exact_includes
    if include in target.passthrough_includes:
        return True
    if include in SUBSET_EXCLUDED_INCLUDES:
        return False
    if target.include_prefixes:
        return any(include.startswith(prefix) for prefix in target.include_prefixes)
    if target.court:
        return in_court_range(include)
    if target.books is not None:
        if book_dir(include) not in target.books:
            return False
        if target.name == "M":
            return in_mushite_range(include)
        return True
    if book_dir(include) in target.full_books:
        return True
    return True


def build_target(target_name, build_root):
    target = resolve_target(target_name)

    build_root = build_root.resolve()
    preamble, body = read_master()
    preamble = subset_preamble(preamble)
    books = parse_master_books(body)
    target_dir = build_root / "chapters"
    if target_dir.exists():
        shutil.rmtree(target_dir)
    target_dir.mkdir(parents=True, exist_ok=True)
    for suffix in (".aux", ".log", ".out", ".toc", ".pdf"):
        stale = build_root / f"{target_output_name(target)}{suffix}"
        if stale.exists():
            stale.unlink()

    included_books = []
    total_verses = 0
    for book in books:
        generated = {}
        chapters = {}
        for item_type, value in book["items"]:
            if item_type != "include" or not selected_include(value, target):
                continue
            generated_path, verse_count, chapter = copy_or_filter_chapter(value, target, target_dir)
            if generated_path is not None:
                generated[value] = generated_path
                chapters[value] = chapter
                total_verses += verse_count
        if generated:
            included_book = dict(book)
            if target.book_title_override is not None:
                included_book["title"] = target.book_title_override
                included_book["items"] = [
                    item for item in included_book["items"] if item[0] != "part"
                ]
            included_book["generated"] = generated
            included_book["chapters"] = chapters
            included_books.append(included_book)

    if not included_books:
        fatal(f"{target.name} did not select any chapters")

    entrypoint = write_entrypoint(target, preamble, included_books, build_root)
    try:
        display_entrypoint = entrypoint.relative_to(ROOT)
    except ValueError:
        display_entrypoint = entrypoint
    print(f"wrote {display_entrypoint} ({len(included_books)} books, {total_verses} verses)")


def print_list():
    targets = list(TARGETS.values()) + list(dynamic_book_targets())
    width = max(len(target.name) for target in targets)
    for target in targets:
        aliases = sorted(target.aliases)
        alias_text = f" (aliases: {', '.join(aliases)})" if aliases else ""
        print(f"{target.name:<{width}}  {target.description}{alias_text}")


def print_make_targets():
    names = set(TARGETS)
    for target in dynamic_book_targets():
        names.update({target.name, *target.aliases})
    print(" ".join(sorted(names)))


def print_make_chapter_targets():
    print(" ".join(target.name for target in dynamic_chapter_targets()))


def print_make_book_targets():
    names = set()
    for target in dynamic_book_targets():
        if target.books and not target.books.intersection(book_titles_by_dir()):
            continue
        names.update({target.name, *target.aliases})
    print(" ".join(sorted(names)))


def main():
    parser = argparse.ArgumentParser(description="Generate dynamic source/range subset TeX builds.")
    parser.add_argument("target", nargs="?")
    parser.add_argument(
        "--build-dir",
        type=Path,
        default=DEFAULT_BUILD_ROOT,
        help="write generated TeX under this build directory",
    )
    parser.add_argument("--list", action="store_true", help="list buildable subset targets")
    parser.add_argument("--make-targets", action="store_true", help="print all callable make targets")
    parser.add_argument(
        "--make-book-targets",
        action="store_true",
        help="print callable whole-book make targets and aliases",
    )
    parser.add_argument(
        "--make-chapter-targets",
        action="store_true",
        help="print callable single-chapter make targets",
    )
    parser.add_argument("--output-name", action="store_true", help="print the canonical output basename for a target")
    args = parser.parse_args()

    if args.list:
        print_list()
        return
    if args.make_targets:
        print_make_targets()
        return
    if args.make_book_targets:
        print_make_book_targets()
        return
    if args.make_chapter_targets:
        print_make_chapter_targets()
        return
    if args.target is None:
        parser.error(
            "target is required unless a listing option is used"
        )
    if args.output_name:
        print(target_output_name(resolve_target(args.target)))
        return
    build_target(args.target, args.build_dir)


if __name__ == "__main__":
    main()
