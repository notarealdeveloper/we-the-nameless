@dataclass(frozen=True)
class Target:
    name: str
    title_logo: str
    description: str
    sources: frozenset[str] | None = None
    books: frozenset[str] | None = None
    include_prefixes: frozenset[str] = frozenset()
    court: bool = False
    source_exceptions: frozenset[tuple[str, str]] = frozenset()
    verse_exceptions: frozenset[str] = frozenset()
    full_books: frozenset[str] = frozenset()
    source_map_script: Path | None = None
    check_j_source: bool = False
    output_name: str | None = None
    aliases: frozenset[str] = frozenset()
    toc_chapters: bool = False
    book_title_override: str | None = None
    passthrough_includes: frozenset[str] = frozenset()
    exact_includes: frozenset[str] = frozenset()
    full_frontmatter: bool = False


