            full_frontmatter=True,
        ),
        Target(
            "2-samuel",
            "II Samuel",
            "II Samuel as one book volume.",
            include_prefixes=frozenset({"08-samuel/2-"}),
            output_name="2-samuel",
            toc_chapters=True,
            book_title_override="II Samuel",
            full_frontmatter=True,
        ),
        Target(
            "1-kings",
            "I Kings",
            "I Kings as one book volume.",
            include_prefixes=frozenset({"09-kings/1-"}),
            output_name="1-kings",
            toc_chapters=True,
            book_title_override="I Kings",
