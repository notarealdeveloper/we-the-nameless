#!/usr/bin/env bash

# Count up the commits by our patsy and slave.

git log | grep -P 'root@thedynamiclinker.com|notarealdeveloper@gmail.com' -A1 | grep -v '^\-\-' | sed -E -e '/^Author/N;s/\n/ /' -e 's/([0-9]{2}:[0-9]{2}:[0-9]{2} )(.*)/\2/g' -e 's@[-][0-9]+@@g' | sort | uniq -c | sort -n | sed -E 's@Jason[ ]+Wilkes@Jason-Wilkes@g' | column -t | awk '{
    for(i=1;i<=NF;i++) if($i=="Date:") {
        d=$(i+2)" "$(i+3)" "$(i+4)
        cmd="date -d \""d"\" +%F"
        cmd | getline iso; close(cmd)
        printf "%s  ",iso
        for(j=1;j<i;j++) printf "%s%s",$j,(j<i-1?" ":"")
        print ""
    }
}' | sort
