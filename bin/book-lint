#!/usr/bin/env python3
import argparse
import re
import sys
from pathlib import Path

INDENT = "    "

HEBREW = re.compile(r"[\u0590-\u05ff]")
MACRO_START = re.compile(r"^\s*(\\[A-Za-z@]+)\{")

FALLBACK_HEBREW_MACROS = {
    "\\hJ", "\\hE", "\\hP", "\\hR", "\\hRJE",
    "\\hBookOfRecords", "\\hOther",
    "\\hAJ", "\\hBJ", "\\hCJ",
    "\\hAP", "\\hBP", "\\hCP",
    "\\heb", "\\hs",
}

PROTECT_ENVS = {
    "verbatim", "lstlisting", "minted", "tikzpicture",
}

NEVER_TOUCH_MACROS = {
    "\\Verse", "\\Chapter", "\\Book", "\\Apocrypha", "\\Apocryphon",
    "\\Define", "\\UseDef", "\\Def", "\\DefA", "\\DefB", "\\DefC",
    "\\Table", "\\raisebox",
}

def untab(s):
    return s.replace("\t", INDENT)

def has_hebrew(s):
    return bool(HEBREW.search(s))

def leading_ws(s):
    return s[:len(s) - len(s.lstrip())]

def discover_hebrew_macros(main_tex=Path("main.tex")):
    try:
        text = main_tex.read_text(encoding="utf-8")
    except OSError:
        return set(FALLBACK_HEBREW_MACROS)

    macros = set()
    patterns = (
        r"\\(?:newcommand|renewcommand)\{(\\[A-Za-z@]+)\}(?:\[[^\]]+\])?\{(.*?)\}",
        r"\\NewDocumentCommand\{(\\[A-Za-z@]+)\}\s*\{[^}]*\}\s*\{(.*?)\}",
    )

    for pat in patterns:
        for name, body in re.findall(pat, text, re.S):
            if (
                name.startswith("\\h")
                or "Hebrew" in body
                or "hebrew" in body
                or "textdir TRT" in body
                or "RTL" in body
                or has_hebrew(body)
            ):
                macros.add(name)

    return macros or set(FALLBACK_HEBREW_MACROS)

def is_target_macro(name, hebrew_macros):
    if name in NEVER_TOUCH_MACROS:
        return False
    return (
        name in hebrew_macros
        or re.match(r"\\e[A-Z]", name)
        or re.match(r"\\a[A-Z]", name)
        or name in {"\\heb", "\\footnote"}
    )

def brace_delta(s):
    return s.count("{") - s.count("}")

def has_paragraph_break(lines):
    for line in strip_outer_blank_lines(lines[:]):
        if not line.strip():
            return True
    return False

def strip_outer_blank_lines(lines):
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    return lines

def min_indent(lines):
    vals = [len(leading_ws(x)) for x in lines if x.strip()]
    return min(vals) if vals else 0


def collect_macro(lines, start, hebrew_macros, width):
    first = untab(lines[start].rstrip())
    m = MACRO_START.match(first)

    if not m:
        return None

    name = m.group(1)

    if not is_target_macro(name, hebrew_macros):
        return None

    depth = brace_delta(first)
    chunk = [first]
    i = start + 1

    while depth > 0 and i < len(lines):
        line = untab(lines[i].rstrip())
        chunk.append(line)
        depth += brace_delta(line)
        i += 1

    if depth != 0:
        return None

    return i - start, format_macro_chunk(chunk, name, width)

def extract_inner(chunk, name):
    first = chunk[0]
    last = chunk[-1]
    prefix = name + "{"

    first_body = first.strip()[len(prefix):]

    if len(chunk) == 1:
        return [first_body[:-1]]

    inner = []

    if first_body:
        inner.append(first_body)

    inner.extend(chunk[1:-1])

    last_before_close = last.rsplit("}", 1)[0]
    if last_before_close.strip():
        inner.append(last_before_close)

    return inner

def format_macro_chunk(chunk, name, width=80):
    indent = leading_ws(chunk[0])
    inner = extract_inner(chunk, name)

    # Long LaTeX argument: paragraph break present.
    # Only normalize wrapper + shift while preserving relative indent.
    if has_paragraph_break(inner):
        inner = strip_outer_blank_lines(inner)
        base = min_indent(inner)

        out = [indent + name + "{"]
        for line in inner:
            if line.strip():
                out.append(indent + INDENT + line[base:])
            else:
                out.append("")
        out.append(indent + "}")
        return out

    # Short argument: no paragraph break.
    # Soft-wrap in \xx{first line / continuation line} style.
    body = " ".join(x.strip() for x in inner).strip()

    if not body or "{" in body or "}" in body:
        return chunk

    prefer_hebrew = has_hebrew(body) or name.startswith("\\h")
    opener = indent + name + "{"
    cont = indent + INDENT

    lines = wrap_words(
        body,
        opener,
        width,
        is_hebrew_waw_word if prefer_hebrew else is_english_and_word,
        cont,
    )

    lines[-1] += "}"
    return lines

def lint_text(text, hebrew_macros=None):
    if hebrew_macros is None:
        hebrew_macros = discover_hebrew_macros()

    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    out = []
    i = 0
    protected = False

    while i < len(lines):
        raw = untab(lines[i].rstrip())

        m_begin = re.match(r"\s*\\begin\{([^}]+)\}", raw)
        m_end = re.match(r"\s*\\end\{([^}]+)\}", raw)

        if m_begin and m_begin.group(1) in PROTECT_ENVS:
            protected = True

        if protected:
            out.append(raw)
            if m_end and m_end.group(1) in PROTECT_ENVS:
                protected = False
            i += 1
            continue

        block = collect_macro(lines, i, hebrew_macros, width)
        if block:
            used, formatted = block
            out.extend(formatted)
            i += used
            continue

        out.append(raw)
        i += 1

    return "\n".join(out).rstrip() + "\n"

def iter_tex_files(root):
    for path in root.rglob("*.tex"):
        if path.is_file():
            yield path

def read_path(path):
    return path.read_text(encoding="utf-8")

def write_path(path, text):
    path.write_text(text, encoding="utf-8")

def main():
    ap = argparse.ArgumentParser(description="Lightweight LaTeX linter.")
    ap.add_argument("files", nargs="*", help="Input .tex files. Reads stdin if omitted.")
    ap.add_argument("-i", "--in-place", action="store_true")
    ap.add_argument("-r", "--recursive", action="store_true")
    args = ap.parse_args()

    hebrew_macros = discover_hebrew_macros()

    if args.recursive:
        for path in iter_tex_files(Path.cwd()):
            write_path(path, lint_text(read_path(path), hebrew_macros))
        return 0

    if args.in_place:
        if not args.files:
            ap.error("-i requires files unless using -r")
        for name in args.files:
            path = Path(name)
            if path.suffix != ".tex":
                print(f"texlint: refusing non-.tex file: {path}", file=sys.stderr)
                continue
            write_path(path, lint_text(read_path(path), hebrew_macros))
        return 0

    if args.files:
        for n, name in enumerate(args.files):
            path = Path(name)
            if path.suffix != ".tex":
                print(f"texlint: refusing non-.tex file: {path}", file=sys.stderr)
                continue
            if n:
                sys.stdout.write("\n")
            sys.stdout.write(lint_text(read_path(path), hebrew_macros))
    else:
        sys.stdout.write(lint_text(sys.stdin.read(), hebrew_macros))

    return 0

if __name__ == "__main__":
    raise SystemExit(main())
