#!/usr/bin/env python3
"""Canonical input map for WTN ancient alphabet fonts.

The fonts in fonts-master represent one value space: the Hebrew alphabet,
rendered in different historical glyph styles.  The key space is deliberately
larger.  Latin, Hebrew, and selected Greek/Cyrillic descendants can all point
at the same smaller set of Hebrew letters.
"""

from __future__ import annotations

import argparse
import unicodedata


HEBREW_LETTERS = [
    ("aleph", "א"),
    ("bet", "ב"),
    ("gimel", "ג"),
    ("dalet", "ד"),
    ("he", "ה"),
    ("waw", "ו"),
    ("zayin", "ז"),
    ("heth", "ח"),
    ("teth", "ט"),
    ("yod", "י"),
    ("final-kaf", "ך"),
    ("kaf", "כ"),
    ("lamed", "ל"),
    ("final-mem", "ם"),
    ("mem", "מ"),
    ("final-nun", "ן"),
    ("nun", "נ"),
    ("samekh", "ס"),
    ("ayin", "ע"),
    ("final-pe", "ף"),
    ("pe", "פ"),
    ("final-tsade", "ץ"),
    ("tsade", "צ"),
    ("qoph", "ק"),
    ("resh", "ר"),
    ("shin", "ש"),
    ("taw", "ת"),
]

HEBREW_BY_NAME = dict(HEBREW_LETTERS)

# One stable ASCII key for each Hebrew letter.  These keys are the master
# transliteration for the generated fonts.  Extra aliases below may be broad;
# this table should stay small and memorable.
MASTER_ASCII = {
    "a": "aleph",
    "b": "bet",
    "g": "gimel",
    "d": "dalet",
    "e": "he",
    "w": "waw",
    "z": "zayin",
    "h": "heth",
    "T": "teth",
    "y": "yod",
    "K": "final-kaf",
    "k": "kaf",
    "l": "lamed",
    "M": "final-mem",
    "m": "mem",
    "N": "final-nun",
    "n": "nun",
    "S": "samekh",
    "o": "ayin",
    "P": "final-pe",
    "p": "pe",
    "C": "final-tsade",
    "c": "tsade",
    "q": "qoph",
    "r": "resh",
    "s": "shin",
    "t": "taw",
}

ALIASES = {
    # Latin aliases and descendant letters.
    "A": "aleph",
    "B": "bet",
    "v": "bet",
    "D": "dalet",
    "E": "he",
    "G": "gimel",
    "u": "waw",
    "U": "waw",
    "V": "waw",
    "W": "waw",
    "Z": "zayin",
    "x": "heth",
    "H": "heth",
    "X": "heth",
    "0": "teth",
    "i": "yod",
    "I": "yod",
    "j": "yod",
    "J": "yod",
    "Y": "yod",
    "L": "lamed",
    "f": "final-pe",
    "F": "final-pe",
    "O": "ayin",
    "Q": "qoph",
    "R": "resh",
    "š": "shin",
    "Š": "shin",
    "ʃ": "shin",

    # Greek descendants and close transliteration keys.
    "Α": "aleph",
    "α": "aleph",
    "Β": "bet",
    "β": "bet",
    "Γ": "gimel",
    "γ": "gimel",
    "Δ": "dalet",
    "δ": "dalet",
    "Ε": "he",
    "ε": "he",
    "Ϝ": "waw",
    "ϝ": "waw",
    "Ζ": "zayin",
    "ζ": "zayin",
    "Η": "heth",
    "η": "heth",
    "Θ": "teth",
    "θ": "teth",
    "Ι": "yod",
    "ι": "yod",
    "Κ": "kaf",
    "κ": "kaf",
    "Λ": "lamed",
    "λ": "lamed",
    "Μ": "mem",
    "μ": "mem",
    "Ν": "nun",
    "ν": "nun",
    "Σ": "samekh",
    "σ": "samekh",
    "ς": "samekh",
    "Ο": "ayin",
    "ο": "ayin",
    "Π": "pe",
    "π": "pe",
    "Ϙ": "qoph",
    "ϙ": "qoph",
    "Ρ": "resh",
    "ρ": "resh",
    "Τ": "taw",
    "τ": "taw",

    # Cyrillic descendants and visually useful scholarly keys.
    "А": "aleph",
    "а": "aleph",
    "Б": "bet",
    "б": "bet",
    "В": "bet",
    "в": "bet",
    "Г": "gimel",
    "г": "gimel",
    "Д": "dalet",
    "д": "dalet",
    "Е": "he",
    "е": "he",
    "З": "zayin",
    "з": "zayin",
    "И": "heth",
    "и": "heth",
    "К": "kaf",
    "к": "kaf",
    "Л": "lamed",
    "л": "lamed",
    "М": "mem",
    "м": "mem",
    "Н": "nun",
    "н": "nun",
    "С": "samekh",
    "с": "samekh",
    "О": "ayin",
    "о": "ayin",
    "П": "pe",
    "п": "pe",
    "Р": "resh",
    "р": "resh",
    "Т": "taw",
    "т": "taw",
    "Ш": "shin",
    "ш": "shin",
}


def key_to_hebrew() -> dict[str, str]:
    mapping = {}
    for key, name in {**MASTER_ASCII, **ALIASES}.items():
        mapping[key] = HEBREW_BY_NAME[name]
    for _name, hebrew in HEBREW_LETTERS:
        mapping[hebrew] = hebrew
    return mapping


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--tsv", action="store_true", help="print key-to-Hebrew map")
    args = parser.parse_args()
    if args.tsv:
        for key, hebrew in sorted(key_to_hebrew().items(), key=lambda item: ord(item[0])):
            name = unicodedata.name(key, "UNKNOWN")
            print(f"{key}\tU+{ord(key):04X}\t{hebrew}\tU+{ord(hebrew):04X}\t{name}")
    else:
        print("".join(key_to_hebrew().keys()))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
