#!/usr/bin/env python3
"""Report verses with commentary in the project's numbered book directories."""

import argparse
import os
from pathlib import Path
import re
import sys
import tempfile

sys.path.insert(0, str(Path(__file__).resolve().parent))
from book_parse_lib import book_name_for, compact_text, read_braced, strip_tex_comments


COMMAND = re.compile(r"\\(?:[A-Za-z]+|[^\n])")


def commentary_verses(path, chapter=None):
    """Read commentary identities and carry chapter context across file boundaries."""
    text = strip_tex_comments(path.read_text(encoding="utf-8"))
    verses = set()
    pos = 0
    while match := COMMAND.search(text, pos):
        pos = match.end()
        if match.group() == r"\Chapter":
            chapter, pos = read_braced(text, pos)
            chapter = chapter.strip()
        elif match.group() == r"\Verse":
            if chapter is None:
                raise ValueError("\\Verse before \\Chapter")
            number, pos = read_braced(text, pos)
            # Consume all three arguments, skipping any commands inside them.
            for _ in range(3):
                commentary, pos = read_braced(text, pos)
            commentary = " ".join(compact_text(commentary, strip=True).split())
            if commentary and commentary != "Qere Ketiv.":
                verses.add((chapter, number.strip()))
    return verses, chapter


def report(root):
    files = sorted(p for p in root.glob("[01][0-9]-*/*.tex")
                   if p.is_file() and p.parent.name != "10-dudetheyreontome")
    if not files:
        raise ValueError(f"no matching TeX files in {root}")
    books = {}
    chapters = {}
    for path in files:
        # Samuel and Kings use filenames such as 1-01.tex and 2-01.tex.
        part = re.fullmatch(r"(\d+)-\d+", path.stem)
        part_number = int(part[1]) if part else 0
        key = path.parent.name, part_number
        verses = books.setdefault(key, set())
        try:
            found, chapters[key] = commentary_verses(path, chapters.get(key))
            verses.update(found)
        except (OSError, ValueError) as exc:
            raise ValueError(f"{path}: {exc}") from exc
    lines = ["| Book | Verses with commentary |", "| --- | ---: |"]
    for (book, part), verses in sorted(books.items()):
        name = book_name_for(book)
        if part:
            name = f"{part} {name}"
        lines.append(f"| **{name}** | **{len(verses):,}** |")
    total = sum(map(len, books.values()))
    lines.append(f"| **TOTAL** | **{total:,} verses** |")
    return "\n".join(lines) + "\n"


def update(path, content):
    """Replace only after the complete report has been parsed and written."""
    temporary = None
    try:
        mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                         dir=path.parent, prefix=".verses-",
                                         delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(content)
        temporary.chmod(mode)
        temporary.replace(path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(
        description="Count unique verses with nonempty commentary, excluding Qere Ketiv.-only notes.",
        epilog="Reads [01][0-9]-*/*.tex except 10-dudetheyreontome. Uses WE_THE_NAMELESS, "
               "or the repository containing this script if unset. Requires only Python 3.")
    parser.add_argument("-u", "--update", action="store_true",
                        help="rewrite $WE_THE_NAMELESS/PROGRESS.md instead of printing")
    args = parser.parse_args()
    root = Path(os.environ.get("WE_THE_NAMELESS") or Path(__file__).resolve().parent.parent)
    try:
        content = report(root)
        if args.update:
            update(root / "PROGRESS.md", content)
        else:
            sys.stdout.write(content)
    except (OSError, ValueError) as exc:
        parser.exit(1, f"verses: {exc}\n")


if __name__ == "__main__":
    main()
