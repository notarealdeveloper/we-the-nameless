#!/usr/bin/env python3
"""Record geometry, resources, images and MuPDF text operations as JSON."""
import json
from pathlib import Path
import sys
from kdp_pdf_lib import inspect

if len(sys.argv) != 3: raise SystemExit('usage: kdp-inspect PDF REPORT.json')
data = inspect(sys.argv[1])
output = Path(sys.argv[2]); output.parent.mkdir(parents=True, exist_ok=True)
output.write_text(json.dumps(data, indent=2) + '\n')
print(f"{data['file']}: {data['pages']} pages, {data['bytes']} bytes, {data['font_count']} fonts, {len(data['images'])} raster placements", flush=True)
