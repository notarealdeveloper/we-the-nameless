#!/usr/bin/env bash
set -euo pipefail

interior=${1:-01-genesis.pdf}
paper=${2:-standard-color}
output=${3:-genesis-cover.pdf}
build_dir=${4:-build/cover}
style=${5:-simple}
volume=${6:-Genesis}
spine=${7:-nameless}
project_dir="pub/cover/$style"

if [[ ! -f "$interior" ]]; then
    printf 'Interior PDF not found: %s\nBuild it separately, or set COVER_INTERIOR to an existing PDF.\n' "$interior" >&2
    exit 1
fi
if [[ ! -f "$project_dir/cover.tex" ]]; then
    printf 'Unknown cover style: %s\nExpected %s/cover.tex.\n' "$style" "$project_dir" >&2
    exit 2
fi
if [[ "$spine" != nameless && "$spine" != ld ]]; then
    printf 'Unsupported spine style: %s\nUse nameless or ld.\n' "$spine" >&2
    exit 2
fi

case "$paper" in
    white|standard-color) sheet_thickness=0.002252 ;;
    cream)                sheet_thickness=0.0025 ;;
    premium-color)        sheet_thickness=0.002347 ;;
    *)
        printf 'Unsupported COVER_PAPER: %s\nUse white, cream, standard-color, or premium-color.\n' "$paper" >&2
        exit 1
        ;;
esac

info=$(pdfinfo "$interior")
pages=$(awk '/^Pages:/ {print $2}' <<<"$info")
read -r width_points height_points < <(awk '/^Page size:/ {print $3, $5; exit}' <<<"$info")

if [[ -z "$pages" || -z "$width_points" || -z "$height_points" ]]; then
    printf 'Could not read page count and trim size from %s.\n' "$interior" >&2
    exit 1
fi
# Short interiors get an unlettered spine; the wrap itself remains valid.
show_spine=true
if (( pages < 79 )); then show_spine=false; fi

trim_width=$(awk -v points="$width_points" 'BEGIN {printf "%.6f", points / 72}')
trim_height=$(awk -v points="$height_points" 'BEGIN {printf "%.6f", points / 72}')
spine_width=$(awk -v pages="$pages" -v thickness="$sheet_thickness" 'BEGIN {printf "%.6f", pages * thickness}')

if [[ "$trim_width" != 7.000000 || "$trim_height" != 10.000000 ]]; then
    printf 'The cover templates require a 7x10 in interior; got %sx%s in.\n' "$trim_width" "$trim_height" >&2
    exit 1
fi

mkdir -p "$build_dir" "$build_dir/texmf-var"
# The templates use TikZ's remembered page anchors.  The first pass records
# those positions; the second pass is what places the panels and labels there.
for pass in 1 2; do
    printf 'Cover LuaLaTeX pass %s/2 START\n' "$pass"
    TEXMFVAR="$build_dir/texmf-var" lualatex \
        -recorder -interaction=nonstopmode -halt-on-error -file-line-error \
        -output-directory="$build_dir" \
        -jobname=cover \
        "\\def\\CoverShowSpine{$show_spine}\\def\\CoverSpineWidth{$spine_width in}\\def\\CoverVolume{$volume}\\def\\CoverSpine{$spine}\\def\\CoverProjectDir{$project_dir}\\input{$project_dir/cover.tex}"
    printf 'Cover LuaLaTeX pass %s/2 PASS\n' "$pass"
done
cp "$build_dir/cover.pdf" "$output"
printf 'Built %s: %s pages, %sx%s in trim, %s in spine (%s).\n' \
    "$output" "$pages" "$trim_width" "$trim_height" "$spine_width" "$paper/$style"
