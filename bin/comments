#!/usr/bin/env python

import argparse
import re
import sys
from pathlib import Path


INCLUDE = re.compile(r"^(\s*)%?\s*(\\include\{([^}]+)\})\s*$")

BOOKS = {
    "01-genesis",
    "02-exodus",
    "03-leviticus",
    "04-numbers",
    "05-deuteronomy",
    "06-joshua",
    "07-judges",
    "08-samuel",
    "09-kings",
    "10-esther",
    "11-ezra",
}

KEEP = {
    "01-genesis/01",
    "01-genesis/02",
    "01-genesis/03",
    "02-exodus/15",
    "03-leviticus/19",
    "04-numbers/21",
    "04-numbers/22",
    "04-numbers/23",
    "05-deuteronomy/32",
    "05-deuteronomy/33",
    "07-judges/05",
    "06-joshua/01",
    "08-samuel/1-01",
    "08-samuel/2-01",
    "09-kings/1-01",
    "09-kings/2-01",
    "10-esther/01",
    "11-ezra/01",
    "11-ezra/nehemiah-01",
}


def is_target(path):
    return path.split("/", 1)[0] in BOOKS


def edit_line(line, uncomment):
    m = INCLUDE.match(line.rstrip("\n"))
    if not m:
        return line

    indent, include, path = m.groups()
    if not is_target(path):
        return line

    if uncomment or path in KEEP:
        return indent + include + "\n"

    return indent + "%" + include + "\n"


def main():
    p = argparse.ArgumentParser()
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("-c", "--comment", action="store_true")
    g.add_argument("-u", "--uncomment", action="store_true")
    p.add_argument("files", nargs="+")
    args = p.parse_args()

    for name in args.files:
        path = Path(name)
        old = path.read_text()
        new = "".join(edit_line(line, args.uncomment) for line in old.splitlines(True))
        if new != old:
            path.write_text(new)


if __name__ == "__main__":
    sys.exit(main())
