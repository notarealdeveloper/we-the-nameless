#!/usr/bin/env python3
import argparse
import subprocess
import sys
from collections import Counter


def die(msg):
    print(f"git-recent: {msg}", file=sys.stderr)
    raise SystemExit(1)


def git(*args):
    try:
        return subprocess.run(
            ("git",) + args,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        ).stdout
    except FileNotFoundError:
        die("git not found")
    except subprocess.CalledProcessError as e:
        msg = e.stderr.strip() or e.stdout.strip() or "git command failed"
        die(msg)


def git_bytes(*args):
    try:
        return subprocess.run(
            ("git",) + args,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        ).stdout
    except FileNotFoundError:
        die("git not found")
    except subprocess.CalledProcessError as e:
        msg = e.stderr.decode("utf-8", "replace").strip() or "git command failed"
        die(msg)


def commit_files(commit):
    out = git_bytes("diff-tree", "--no-commit-id", "--name-only", "-r", "-m", "-z", commit)
    return set(x.decode("utf-8", "surrogateescape") for x in out.split(b"\0") if x)


def shell_escape(s):
    safe = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_@%+=:,./-"
    return "".join(c if c in safe else "\\" + c for c in s)


def winners(counts, n):
    return sorted(counts.items(), key=lambda x: (-x[1], x[0]))[:n]


def tied_at_cutoff(counts, n):
    items = sorted(counts.items(), key=lambda x: (-x[1], x[0]))
    if len(items) <= n:
        return False
    return items[n - 1][1] == items[n][1]


def recent_files(commits, n, files=()):
    targets = set(files)
    rev_args = ("HEAD", "--") + tuple(files) if files else ("HEAD",)
    revs = git("rev-list", *rev_args).splitlines()
    counts = Counter()

    for i, commit in enumerate(revs, 1):
        for path in commit_files(commit):
            if targets and path not in targets:
                continue
            counts[path] += 1

        if i >= commits and not tied_at_cutoff(counts, n):
            break

    return [path for path, count in winners(counts, n)]


def main(argv):
    p = argparse.ArgumentParser(prog="git recent")
    p.add_argument("-c", "--commits", type=int, default=10)
    p.add_argument("-n", "--numfiles", type=int, default=5)
    p.add_argument("-u", "--unlines", action="store_true")
    p.add_argument("files", nargs="*")
    args = p.parse_args(argv)

    if args.commits < 1:
        die("--commits must be positive")
    if args.numfiles < 1:
        die("--numfiles must be positive")

    paths = recent_files(args.commits, args.numfiles, args.files)

    if args.unlines:
        print(" ".join(shell_escape(x) for x in paths))
    else:
        for path in paths:
            print(path)


if __name__ == "__main__":
    main(sys.argv[1:])
