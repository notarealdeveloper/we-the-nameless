2. Resize the E Hebrew and P Hebrew fonts without changing which fonts they are, in order
   to exactly match the size of the J Hebrew font on the page, visually. You'll need
   different scale factors to achieve this. Keep J the same.

The answer turned out to be this.

diff --git a/master.tex b/master.tex
index 87be71f..73b0e60 100644
--- a/master.tex
+++ b/master.tex
@@ -1207,7 +1207,7 @@
 
 \DeclareSourceProfile{E}
     {\EnglishFont} {\addfontfeatures{Scale=0.96}\SourceBackground{Ebgcolor}\MushiteStyle\PriestStyle}
-    {\PaleoASCIIStandard} {\addfontfeatures{Scale=1.10}\SourceBackground{Ebgcolor}\MushiteStyle\PriestStyle}
+    {\PaleoASCIIStandard} {\addfontfeatures{Scale=1.35}\SourceBackground{Ebgcolor}\MushiteStyle\PriestStyle}
 
 \DeclareSourceProfile{DtrA}
     {\EnglishFont} {\SourceBackground{Dtr1bgcolor}\DeuteronomistAStyle\Redactor\mdseries}
@@ -1225,7 +1225,7 @@
 
 \DeclareSourceProfile{P}
     {\EnglishFont}   {\SourceBackground{Pbgcolor}\AaronidStyle\PriestStyle}
-    {\HebrewEzraRaw} {\SourceBackground{Pbgcolor}\AaronidStyle\addfontfeatures{Scale=1.20}\mdseries}
+    {\HebrewEzraRaw} {\SourceBackground{Pbgcolor}\AaronidStyle\addfontfeatures{Scale=1.40}\mdseries}
 
 \DeclareSourceProfile{PP}
     {\EnglishFont}       {\SourceBackground{Pbgcolor}\AaronidStyle\PriestStyle}
@@ -1233,7 +1233,7 @@
 
 \DeclareSourceProfile{R}
     {\EnglishFont}   {\SourceBackground{Rbgcolor}\AaronidStyle\Redactor\mdseries}
-    {\HebrewEzraRaw} {\SourceBackground{Rbgcolor}\AaronidStyle\Redactor\addfontfeatures{Scale=1.10}\mdseries}
+    {\HebrewEzraRaw} {\SourceBackground{Rbgcolor}\AaronidStyle\Redactor\addfontfeatures{Scale=1.40}\mdseries}
 
