            scale = 1.35,
        },

        foreground = "Ecolor",
        background = "Ebgcolor",
        weight = "bold",
    },

    P = {
        category = "priest",
        group = "aaronid",

        english = {
            font = "english",
        },

        hebrew = {
            renderer = "hebrew_ezra_raw",
            scale = 1.40,
        },

        foreground = "Pcolor",
        background = "Pbgcolor",
    },

    ...
}
```

Do not take those exact field names as mandatory.

The essential requirement is that a source becomes **one record**.

