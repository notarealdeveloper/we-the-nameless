#!/usr/bin/env bash
set -euo pipefail

URLS="${1:-primary_history_tanach_urls.txt}"

declare -A BOOK_NUM=(
    [Gen]=01
    [Exod]=02
    [Lev]=03
    [Num]=04
    [Deut]=05
    [Josh]=06
    [Judg]=07
    [1Sam]=08
    [2Sam]=08
    [1Kgs]=09
    [2Kgs]=09
)

declare -A BOOK_NAME=(
    [Gen]=genesis
    [Exod]=exodus
    [Lev]=leviticus
    [Num]=numbers
    [Deut]=deuteronomy
    [Josh]=joshua
    [Judg]=judges
    [1Sam]=samuel
    [2Sam]=samuel
    [1Kgs]=kings
    [2Kgs]=kings
)

while IFS= read -r url; do
    [[ -z "$url" ]] && continue

    # Strip CR if the URL file has Windows line endings.
    url="${url%$'\r'}"

    ref="${url#*\?}"
    start="${ref%%:*}"

    if [[ "$start" =~ ^([12]?[A-Za-z]+)([0-9]+)$ ]]; then
        book="${BASH_REMATCH[1]}"
        chapter="${BASH_REMATCH[2]}"
    else
        echo "Couldn't parse reference: $start" >&2
        exit 1
    fi

    if [[ -z "${BOOK_NUM[$book]+x}" ]]; then
        echo "Unknown book abbreviation: $book" >&2
        exit 1
    fi

    dir="src/${BOOK_NUM[$book]}-${BOOK_NAME[$book]}"

    case "$book" in
        1Sam|1Kgs)
            file=$(printf '1-%02d.xml' "$chapter")
            ;;
        2Sam|2Kgs)
            file=$(printf '2-%02d.xml' "$chapter")
            ;;
        *)
            file=$(printf '%02d.xml' "$chapter")
            ;;
    esac

    mkdir -p "$dir"

    target="$dir/$file"

    if [[ -f "$target" ]]; then
        echo "skip: $target"
        continue
    fi

    echo "$url -> $target"

    tmp="${target}.tmp"

    rm -f "$tmp"

    if wget -q --show-progress -O "$tmp" "$url"; then
        mv "$tmp" "$target"
    else
        rm -f "$tmp"
        echo "Download failed: $url" >&2
        exit 1
    fi
done < "$URLS"
